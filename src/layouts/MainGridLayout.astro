---
import FloatingControls from "@components/control/FloatingControls.astro";
import { SidebarTOC } from "@components/features/toc";
import Banner from "@components/layout/Banner.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import FullscreenWallpaper from "@components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "@components/misc/IconifyLoader.astro";
import Footer from "@components/organisms/footer/Footer.astro";
import Navbar from "@components/organisms/navigation/Navbar.astro";
import SideBar from "@components/widgets/sidebar/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";

import { fullscreenWallpaperConfig, siteConfig } from "../config";
import { BANNER_HEIGHT } from "../constants/constants";
import {
	calculateGridLayout,
	getBannerImages,
	getMainPanelTop,
	getTransparencyClass,
	shouldEnableTransparency,
} from "../utils/grid-layout-utils";
import { widgetManager } from "../utils/widget-manager";
import Layout from "./Layout.astro";
import GridScripts from "./partials/GridScripts.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
}

// 获取 banner 图片
const bannerImages = await getBannerImages(siteConfig);

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
} = Astro.props;
const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

// 检查是否为首页
const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 计算主内容区域位置
const finalMainPanelTop = getMainPanelTop(
	siteConfig.wallpaperMode.defaultMode,
	BANNER_HEIGHT,
);

// 计算网格布局
const {
	gridCols,
	sidebarClass,
	rightSidebarClass,
	mainContentClass,
	sidebarPresence,
	mobileShowSidebar,
	tabletShowSidebar,
	desktopShowSidebar,
} = calculateGridLayout({
	siteConfig,
	widgetManager,
});

const { hasRightSidebarComponents, hasMobileDrawerComponents } =
	sidebarPresence;

// 半透明效果
const shouldEnable = shouldEnableTransparency(
	siteConfig.wallpaperMode.defaultMode,
);
const transparentClass = getTransparencyClass(shouldEnable);

// 布局模式
const defaultPostListLayout = siteConfig.postListLayout?.defaultMode || "list";
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
>
	<GridScripts
		navbarTransparentMode={siteConfig.banner?.navbar?.transparentMode ||
			"semi"}
		defaultWallpaperMode={siteConfig.wallpaperMode.defaultMode}
		defaultPostListLayout={siteConfig.postListLayout?.defaultMode || "list"}
		BANNER_HEIGHT={BANNER_HEIGHT}
		pageScaling={siteConfig.pageScaling}
	/>

	<!-- 全屏壁纸 - 始终渲染，通过 JS 控制显示隐藏 -->
	<FullscreenWallpaper config={fullscreenWallpaperConfig} />

	<!-- 全局图标加载器 -->
	<IconifyLoader />

	<!-- Navbar -->
	<slot slot="head" name="head" />
	<div
		id="top-row"
		class="z-50 pointer-events-none relative transition-all duration-700 max-w-(--page-width) px-0 md:px-4 mx-auto"
		class:list={[""]}
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky top-0 transition-all"
		>
			<Navbar />
		</div>
	</div>

	<!-- Banner 组件 -->
	<Banner
		bannerImages={bannerImages}
		mobileNonHomeBannerClass={mobileNonHomeBannerClass}
		showTextOverlay={isHomePage &&
			(siteConfig.banner.homeText?.enable ?? false)}
	/>

	<!-- Main content -->
	<div
		class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? "mobile-main-no-banner" : ""} ${siteConfig.wallpaperMode.defaultMode === "none" ? "no-banner-layout" : ""} ${transparentClass}`}
		style={`top: ${finalMainPanelTop}`}
	>
		<!-- The pointer-events-none here prevent blocking the click event of the TOC -->
		<div class="relative max-w-(--page-width) mx-auto pointer-events-auto">
			<div
				id="main-grid"
				class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-none md:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!mobileShowSidebar || !hasMobileDrawerComponents ? "mobile-no-sidebar" : ""} ${hasRightSidebarComponents ? "mobile-both-sidebar" : ""}`}
				data-layout-mode={defaultPostListLayout}
			>
				<!-- Banner image credit -->
				{
					hasBannerCredit && (
						<a
							href={siteConfig.banner.credit.url}
							id="banner-credit"
							target="_blank"
							rel="noopener"
							aria-label="Visit image source"
							class:list={[
								"group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
									"px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
								{
									"hover:pr-9 active:bg-black/80":
										hasBannerLink,
								},
							]}
						>
							<Icon
								class="text-white/75 text-[1.25rem] mr-1"
								name="material-symbols:copyright-outline-rounded"
							/>
							<div class="text-white/75 text-xs">
								{siteConfig.banner.credit.text}
							</div>
							<Icon
								class:list={[
									"transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
									{
										"group-hover:opacity-100":
											hasBannerLink,
									},
								]}
								name="fa7-solid:arrow-up-right-from-square"
							/>
						</a>
					)
				}

				{/* 侧边栏和主内容区域容器 */}
				<div class="contents">
					{
						(mobileShowSidebar ||
							tabletShowSidebar ||
							desktopShowSidebar) && (
							<SideBar
								class={`${sidebarClass} ${transparentClass}`}
								headings={headings}
							/>
						)
					}

					{
						hasRightSidebarComponents && (
							<div
								class={`right-sidebar-container ${rightSidebarClass} ${transparentClass}`}
							>
								<RightSideBar headings={headings} />
							</div>
						)
					}
				</div>

				<main
					id="swup-container"
					class={`${mainContentClass} transition-main`}
				>
					<div
						id="content-wrapper"
						class="onload-animation transition-leaving"
					>
						<!-- the overflow-hidden here prevent long text break the layout-->
						<!-- make id different from windows.swup global property -->
						<slot />
						<div
							class="footer col-span-full onload-animation hidden lg:block"
						>
							<Footer />
						</div>
					</div>
				</main>

				<div
					class="footer col-span-full onload-animation block lg:hidden"
				>
					<Footer />
				</div>
			</div>

			<FloatingControls headings={headings} />
		</div>
	</div>

	<style>
		.right-sidebar-container {
			align-self: start;
			display: contents;
		}

		.right-sidebar-container #right-sidebar {
			height: fit-content;
		}
	</style>

	<!-- 侧边栏TOC模式 -->
	{
		siteConfig.toc.enable && siteConfig.toc.desktopSidebar && (
			<div class="absolute w-full z-0 hidden 2xl:block">
				<div class="relative max-w-(--page-width) mx-auto">
					<div
						id="toc-wrapper"
						class:list={[
							"hidden lg:block transition absolute top-0 w-(--toc-width) items-center",
							"-right-(--toc-width)",
							{
								"toc-hide":
									siteConfig.wallpaperMode.defaultMode ===
									"banner",
							},
						]}
					>
						<div
							id="toc-inner-wrapper"
							class="fixed top-14 w-(--toc-width) h-[calc(100vh-6rem)] max-h-[calc(100vh-6rem)] overflow-x-hidden overflow-y-auto"
						>
							<div
								id="toc-container"
								class="w-full h-full transition-swup-fade"
							>
								<SidebarTOC headings={headings} />
							</div>
						</div>
					</div>
				</div>
			</div>
		)
	}

	<!-- 保留此元素以确保Swup正常工作 -->
	{
		(!siteConfig.toc.enable || !siteConfig.toc.desktopSidebar) && (
			<div id="toc-container" class="hidden" />
		)
	}
</Layout>

<!--
  Banner 和网格布局样式已提取到 src/styles/banner.css
  该文件通过 src/styles/main.css 导入
-->

<script is:inline>
  // 直接在页面上注入 AI 助手
  const fabHTML = `
    <div id="ai-helper" style="position:fixed;bottom:90px;right:24px;z-index:9999;display:flex;flex-direction:column;align-items:center;gap:8px;">
      <button id="ai-helper-btn" style="width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,0.1);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.15);color:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.3s;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 1 10 10 10 10 0 0 1-10 10 10 10 0 0 1-5-1.3L3 22l1.3-5A10 10 0 0 1 2 12 10 10 0 0 1 12 2z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/></svg>
      </button>
      <div id="ai-helper-chat" style="display:none;position:fixed;bottom:150px;right:24px;width:360px;max-height:450px;background:#1a1a2e;border-radius:16px;border:1px solid rgba(255,255,255,0.08);box-shadow:0 10px 40px rgba(0,0,0,0.5);overflow:hidden;flex-direction:column;">
        <div style="padding:14px 18px;background:rgba(255,255,255,0.05);border-bottom:1px solid rgba(255,255,255,0.06);color:#fff;font-weight:600;display:flex;justify-content:space-between;align-items:center;">
          <span>AI 助手</span>
          <button id="ai-helper-close" style="background:none;border:none;color:#888;font-size:18px;cursor:pointer;">✕</button>
        </div>
        <div id="ai-helper-messages" style="flex:1;padding:16px;overflow-y:auto;max-height:300px;min-height:180px;display:flex;flex-direction:column;gap:8px;">
          <div style="background:rgba(255,255,255,0.06);color:#fff;padding:10px 14px;border-radius:12px;align-self:flex-start;font-size:14px;max-width:85%;">你好！我是 yRlwAaa 的 AI 助手，有什么可以帮你的？</div>
        </div>
        <div style="display:flex;padding:12px;gap:8px;border-top:1px solid rgba(255,255,255,0.06);">
          <input id="ai-helper-input" type="text" placeholder="输入消息..." style="flex:1;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);color:#fff;outline:none;font-size:14px;" />
          <button id="ai-helper-send" style="padding:10px 20px;border-radius:8px;border:none;background:#667eea;color:#fff;font-weight:600;cursor:pointer;">发送</button>
        </div>
      </div>
    </div>
  `;

  document.body.insertAdjacentHTML('beforeend', fabHTML);

  const btn = document.getElementById('ai-helper-btn');
  const chat = document.getElementById('ai-helper-chat');
  const close = document.getElementById('ai-helper-close');
  const input = document.getElementById('ai-helper-input');
  const send = document.getElementById('ai-helper-send');
  const messages = document.getElementById('ai-helper-messages');

  let isOpen = false;

  btn.addEventListener('click', () => {
    isOpen = !isOpen;
    chat.style.display = isOpen ? 'flex' : 'none';
  });

  close.addEventListener('click', () => {
    isOpen = false;
    chat.style.display = 'none';
  });

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;

    const userDiv = document.createElement('div');
    userDiv.style.cssText = 'background:#667eea;color:#fff;padding:10px 14px;border-radius:12px;align-self:flex-end;font-size:14px;max-width:85%;';
    userDiv.textContent = text;
    messages.appendChild(userDiv);
    input.value = '';

    const typingDiv = document.createElement('div');
    typingDiv.style.cssText = 'color:#888;font-size:13px;padding:8px 14px;';
    typingDiv.textContent = '正在输入...';
    messages.appendChild(typingDiv);
    messages.scrollTop = messages.scrollHeight;

    try {
      const response = await fetch('/api/chat/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: [{ role: 'user', content: text }] })
      });

      typingDiv.remove();

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      const botDiv = document.createElement('div');
      botDiv.style.cssText = 'background:rgba(255,255,255,0.06);color:#fff;padding:10px 14px;border-radius:12px;align-self:flex-start;font-size:14px;max-width:85%;';
      messages.appendChild(botDiv);

      let fullText = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        const chunk = decoder.decode(value);
        fullText += chunk;
        botDiv.textContent = fullText;
        messages.scrollTop = messages.scrollHeight;
      }
    } catch (err) {
      typingDiv.remove();
      const errDiv = document.createElement('div');
      errDiv.style.cssText = 'background:rgba(255,255,255,0.06);color:#ff6b6b;padding:10px 14px;border-radius:12px;align-self:flex-start;font-size:14px;max-width:85%;';
      errDiv.textContent = '请求失败，请稍后再试';
      messages.appendChild(errDiv);
    }
  }

  send.addEventListener('click', sendMessage);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') sendMessage();
  });
</script>