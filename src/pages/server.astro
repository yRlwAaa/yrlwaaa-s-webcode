---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

export const prerender = true;

// 控制台数据后端: 预览期指向本机临时隧道; 正式部署后改成 https://e5.yrlwa.top
const E5_API = "https://e5.yrlwa.top";
---

<MainGridLayout title={i18n(I18nKey.serverTitle)}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
			<!-- 页面标题 -->
			<div class="flex flex-col items-start justify-center mb-6">
				<h1
					class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
					data-i18n={I18nKey.serverTitle}
				>
					{i18n(I18nKey.serverTitle)}
				</h1>
				<p
					class="text-lg text-black/60 dark:text-white/60"
					data-i18n={I18nKey.serverSubtitle}
				>
					{i18n(I18nKey.serverSubtitle)}
				</p>
			</div>

			<!-- ===== 嵌入的服务器控制台(内容区, 不含导航) ===== -->
			<style>
				.e5p {
					--e5-primary: var(--primary, #7186f5);
					--e5-dim: color-mix(in srgb, currentColor 62%, transparent);
					--e5-faint: color-mix(in srgb, currentColor 40%, transparent);
					--e5-card: color-mix(in srgb, currentColor 6%, transparent);
					--e5-line: color-mix(in srgb, currentColor 15%, transparent);
					--e5-soft: color-mix(in srgb, var(--e5-primary) 12%, transparent);
					--e5-good: #3fbf7f;
					--e5-bad: #e5534b;
					--e5-r: var(--radius-large, 14px);
					color: #232936 !important;
					font-family: inherit;
				}
				.dark .e5p,
				html[data-theme="dark"] .e5p,
				html[data-theme="night"] .e5p {
					color: #e9edf6 !important;
				}
				.e5p * {
					box-sizing: border-box;
				}
				.e5p button {
					font-family: inherit;
				}
				.e5p .hd {
					display: flex;
					align-items: center;
					gap: 12px;
					flex-wrap: wrap;
					margin: 2px 0 14px;
				}
				.e5p .hd .sp {
					flex: 1;
				}
				.e5p .stat-chip {
					display: inline-flex;
					align-items: center;
					gap: 7px;
					font-size: 0.78rem;
					color: var(--e5-dim);
					border: 1px solid var(--e5-line);
					border-radius: 999px;
					padding: 3px 11px;
				}
				.e5p .dot {
					width: 8px;
					height: 8px;
					border-radius: 50%;
					background: var(--e5-faint);
				}
				.e5p .dot.on {
					background: var(--e5-good);
					box-shadow: 0 0 6px color-mix(in srgb, var(--e5-good) 70%, transparent);
				}
				.e5p .res {
					display: grid;
					grid-template-columns: repeat(4, 1fr);
					border: 1px solid var(--e5-line);
					border-radius: var(--e5-r);
					overflow: hidden;
					margin-bottom: 14px;
					background: var(--e5-card);
				}
				.e5p .res .cell {
					padding: 10px 14px;
					min-width: 0;
				}
				.e5p .res .cell + .cell {
					border-left: 1px solid var(--e5-line);
				}
				.e5p .res .k {
					font-size: 0.74rem;
					color: var(--e5-faint);
					margin-bottom: 5px;
					white-space: nowrap;
					overflow: hidden;
					text-overflow: ellipsis;
				}
				.e5p .res .v {
					font-size: 0.9rem;
					font-weight: 600;
					font-variant-numeric: tabular-nums;
					white-space: nowrap;
				}
				.e5p .res .v small {
					font-weight: 400;
					color: var(--e5-faint);
					font-size: 0.72rem;
				}
				.e5p .res .bk {
					height: 3px;
					border-radius: 99px;
					margin-top: 7px;
					background: color-mix(in srgb, currentColor 12%, transparent);
					overflow: hidden;
				}
				.e5p .res .bk i {
					display: block;
					height: 100%;
					width: 0;
					background: var(--e5-primary);
					border-radius: 99px;
					transition: width 0.6s ease;
				}
				.e5p .res .disks {
					grid-column: 1 / -1;
					border-top: 1px solid var(--e5-line);
					padding: 6px 14px;
					font-size: 0.74rem;
					color: var(--e5-faint);
				}
				.e5p .rows {
					border: 1px solid var(--e5-line);
					border-radius: var(--e5-r);
					overflow: hidden;
					background: var(--e5-card);
				}
				.e5p .row {
					display: flex;
					align-items: center;
					gap: 14px;
					padding: 13px 16px;
				}
				.e5p .row + .row {
					border-top: 1px solid var(--e5-line);
				}
				.e5p .ico {
					flex: 0 0 38px;
					height: 38px;
					border-radius: 11px;
					display: flex;
					align-items: center;
					justify-content: center;
					background: var(--e5-soft);
					color: var(--e5-primary);
				}
				.e5p .row .tt {
					font-size: 0.95rem;
					font-weight: 550;
				}
				.e5p .row .ds {
					font-size: 0.78rem;
					color: var(--e5-faint);
					margin-top: 2px;
					line-height: 1.5;
				}
				.e5p .row .mid {
					flex: 1;
					min-width: 0;
				}
				.e5p .pill {
					font-size: 0.72rem;
					border: 1px solid var(--e5-line);
					color: var(--e5-dim);
					border-radius: 999px;
					padding: 2px 9px;
					white-space: nowrap;
				}
				.e5p .pill.run {
					color: var(--e5-good);
					border-color: color-mix(in srgb, var(--e5-good) 45%, transparent);
				}
				.e5p .act {
					border: 1px solid var(--e5-line);
					background: transparent;
					color: var(--e5-primary);
					font-size: 0.84rem;
					font-weight: 550;
					padding: 7px 15px;
					border-radius: 10px;
					cursor: pointer;
					white-space: nowrap;
				}
				.e5p .act:hover {
					background: var(--e5-soft);
					border-color: var(--e5-primary);
				}
				.e5p .act:disabled {
					opacity: 0.45;
					cursor: not-allowed;
				}
				.e5p .row.nas .ico {
					background: color-mix(in srgb, #e0a04a 14%, transparent);
					color: #e0a04a;
				}
				.e5p .row.nas .act {
					border-color: color-mix(in srgb, #e0a04a 40%, transparent);
					color: #d99a43;
				}
				.e5p .row.nas .act:hover {
					background: color-mix(in srgb, #e0a04a 14%, transparent);
				}
				.e5p #msg {
					margin: 10px 2px 0;
					font-size: 0.8rem;
					min-height: 1em;
					color: var(--e5-dim);
				}
				.e5p #msg.err {
					color: var(--e5-bad);
				}
				.e5p .quiet {
					border: 0;
					background: transparent;
					color: var(--e5-faint);
					font-size: 0.78rem;
					padding: 5px 8px;
					border-radius: 8px;
					cursor: pointer;
				}
				.e5p .quiet:hover {
					color: var(--e5-bad);
					background: color-mix(in srgb, var(--e5-bad) 10%, transparent);
				}
				@media (max-width: 560px) {
					.e5p .res {
						grid-template-columns: 1fr 1fr;
					}
					.e5p .res .cell:nth-child(3) {
						border-left: 0;
					}
					.e5p .res .cell:nth-child(1),
					.e5p .res .cell:nth-child(2) {
						border-bottom: 1px solid var(--e5-line);
					}
					.e5p .row {
						flex-wrap: wrap;
						padding: 12px 13px;
					}
					.e5p .row .ops {
						flex: 1 1 100%;
						justify-content: flex-end;
					}
				}
			</style>

			<div class="e5p" id="e5pRoot">
				<div class="hd">
					<span class="stat-chip"
						><span class="dot" id="mDot"></span><span
							id="mTxt"
							data-i18n={I18nKey.serverLoading}>{i18n(I18nKey.serverLoading)}</span
						></span
					>
					<span class="stat-chip" id="srcChip" style="display:none"></span>
					<span class="sp"></span>
					<button class="quiet" id="wakeBtn" data-i18n={I18nKey.serverWake}
						>{i18n(I18nKey.serverWake)}</button
					>
					<button class="quiet" id="allStop" data-i18n={I18nKey.serverStopAll}
						>{i18n(I18nKey.serverStopAll)}</button
					>
				</div>

				<div class="res">
					<div class="cell"><div class="k" data-i18n={I18nKey.serverGpuVram}>{i18n(I18nKey.serverGpuVram)}</div><div class="v" id="gpuTxt">–</div><div class="bk"><i id="gpuBar"></i></div></div>
					<div class="cell"><div class="k" data-i18n={I18nKey.serverGpuUtil}>{i18n(I18nKey.serverGpuUtil)}</div><div class="v" id="utilTxt">–</div><div class="bk"><i id="utilBar"></i></div></div>
					<div class="cell"><div class="k">CPU</div><div class="v" id="cpuTxt">–</div><div class="bk"><i id="cpuBar"></i></div></div>
					<div class="cell"><div class="k" data-i18n={I18nKey.serverMem}>{i18n(I18nKey.serverMem)}</div><div class="v" id="memTxt">–</div><div class="bk"><i id="memBar"></i></div></div>
					<div class="disks" id="diskTxt">{i18n(I18nKey.serverDisk)} —</div>
				</div>

				<div class="rows">
					<div class="row">
						<div class="ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
						<div class="mid">
							<div class="tt"><span data-i18n={I18nKey.serverServiceChat}
									>{i18n(I18nKey.serverServiceChat)}</span
								> <span class="pill" id="tagChat"
									>{i18n(I18nKey.serverTagIdle)}</span
								></div>
							<div class="ds" data-i18n={I18nKey.serverChatDesc}>
								{i18n(I18nKey.serverChatDesc)}
							</div>
						</div>
						<div class="ops"><button class="act" id="btnChat"
								>{i18n(I18nKey.serverStart)}</button
							></div>
					</div>
					<div class="row">
						<div class="ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg></div>
						<div class="mid">
							<div class="tt"><span data-i18n={I18nKey.serverServiceDraw}
									>{i18n(I18nKey.serverServiceDraw)}</span
								> <span class="pill" id="tagDraw"
									>{i18n(I18nKey.serverTagIdle)}</span
								></div>
							<div class="ds" data-i18n={I18nKey.serverDrawDesc}>
								{i18n(I18nKey.serverDrawDesc)}
							</div>
						</div>
						<div class="ops"><button class="act" id="btnDraw"
								>{i18n(I18nKey.serverStart)}</button
							></div>
					</div>
					<div class="row">
						<div class="ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></div>
						<div class="mid">
							<div class="tt"><span data-i18n={I18nKey.serverServiceBuild}
									>{i18n(I18nKey.serverServiceBuild)}</span
								> <span class="pill" id="tagBuild"
									>{i18n(I18nKey.serverTagUnconfigured)}</span
								></div>
							<div class="ds" data-i18n={I18nKey.serverBuildDesc}>
								{i18n(I18nKey.serverBuildDesc)}
							</div>
						</div>
						<div class="ops"><button
								class="act"
								id="btnBuild"
								disabled
								data-i18n={I18nKey.serverOpen}>{i18n(I18nKey.serverOpen)}</button
							></div>
					</div>
					<div class="row nas">
						<div class="ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="12" x2="2" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" y1="16" x2="6.01" y2="16"/><line x1="10" y1="16" x2="10.01" y2="16"/></svg></div>
						<div class="mid">
							<div class="tt" data-i18n={I18nKey.serverNasTitle}>
								{i18n(I18nKey.serverNasTitle)}
							</div>
							<div class="ds" id="nasDs">{i18n(I18nKey.serverNasDesc)}</div>
						</div>
						<div class="ops"><button class="act" id="btnNas"
								data-i18n={I18nKey.serverOpenArrow}
								>{i18n(I18nKey.serverOpenArrow)}</button
							></div>
					</div>
				</div>

				<div id="msg"></div>
			</div>

			<script is:inline>
				window.E5_API = "https://e5.yrlwa.top";
			</script>
			<script is:inline>
				(function () {
					"use strict";

					/* ---------- 文案: 跟随站点语言(词条在 src/i18n/languages/*.ts) ---------- */
					function t(key, fallback) {
						try {
							var lang = document.documentElement.getAttribute("lang") || "";
							var d = window.I18N_DICTS || {};
							var dict =
								d[lang] || d[lang.toLowerCase()] || d[lang.split("_")[0]] || {};
							if (dict[key]) return dict[key];
						} catch (e) {}
						return fallback;
					}
					function tf(key, fallback, vars) {
						var s = t(key, fallback);
						for (var k in vars) s = s.split("{" + k + "}").join(vars[k]);
						return s;
					}

					var API = window.E5_API || "";
					var e5Root = document.getElementById("e5pRoot");
					function applyTheme() {
						if (!e5Root) return;
						var de = document.documentElement;
						var dark = de.classList.contains("dark") ||
							/dark|night/i.test(de.getAttribute("data-theme") || "");
						var c = dark ? "#e9edf6" : "#232936";
						try {
							// 采样同页面里主题自己渲染的文字颜色(页标题), 与它保持完全一致
							var card = e5Root.parentElement;
							var probe = card ? card.querySelector("h1, .card-base > div > p") : null;
							if (probe) {
								var col = getComputedStyle(probe).color;
								if (col && col.indexOf("rgb") === 0) c = col;
							}
						} catch (e) {}
						e5Root.style.setProperty("color", c, "important");
					}
					applyTheme();
					try {
						new MutationObserver(applyTheme).observe(document.documentElement, {
							attributes: true, attributeFilter: ["class", "data-theme"]
						});
					} catch (e) {}
					function $(id) { return document.getElementById(id); }
					var token = localStorage.getItem("e5tok") || "";
					function jget(u) {
						var h = {};
						if (token) h["X-Token"] = token;
						return fetch(API + u, { headers: h })
							.then(function (r) {
								if (r.status === 401) { localStorage.removeItem("e5tok"); token = ""; }
								return r.json().catch(function () { return { ok: false, msg: t("serverErrBadResponse", "响应异常") }; });
							})
							.catch(function (e) { return { ok: false, msg: tf("serverErrConnect", "无法连接({msg})", { msg: e.message }) }; });
					}
					// 控制类操作: 需要口令(访客没有口令 → 只能看数据, 不能操作)
					function askToken() {
						var v = prompt(t("serverAskToken", "请输入控制口令(仅站主可用):"));
						if (v) { token = v.trim(); localStorage.setItem("e5tok", token); }
						return token;
					}
					function control(u) {
						if (!token) { if (!askToken()) return Promise.resolve({ ok: false, msg: t("serverErrCancelled", "已取消: 需要口令") }); }
						return fetch(API + u, { headers: { "X-Token": token } })
							.then(function (r) {
								if (r.status === 401) {
									localStorage.removeItem("e5tok"); token = "";
									if (!askToken()) return { ok: false, msg: t("serverErrTokenCancelled", "口令错误, 操作已取消") };
									return fetch(API + u, { headers: { "X-Token": token } }).then(function (r2) {
										if (r2.status === 401) { localStorage.removeItem("e5tok"); token = ""; return { ok: false, msg: t("serverErrToken", "口令错误") }; }
										return r2.json();
									});
								}
								return r.json();
							})
							.catch(function (e) {
								// 隧道偶发丢包: 请求可能其实已经送达(E5 收到就会开始切换), 交给轮询确认
								return { ok: false, unconfirmed: true, msg: tf("serverErrNoConfirm", "没收到确认({msg}), 稍后会自动刷新状态", { msg: e.message }) };
							});
					}
					function toast(msg, err) { var m = $("msg"); m.textContent = msg || ""; m.className = err ? "err" : ""; }
					function bar(id, p) { var el = $(id); if (el) el.style.width = Math.max(0, Math.min(100, p)) + "%"; }
					var names = {
						chat: t("serverStateChat", "对话AI运行中"),
						draw: t("serverStateDraw", "画图中"),
						idle: t("serverStateIdle", "空闲"),
						both: t("serverStateConflict", "⚠ 冲突")
					};
					var pending = "";   // 正在等待完成的切换目标(用于完成时提示)
					function render(d) {
						var mode = d.mode || "idle";
						var sw = d.switch || {};
						var switching = !!sw.running;
						if (switching) {
							$("mTxt").textContent = (sw.phase || t("serverSwitching", "正在切换…")) +
								(sw.elapsed ? "  " + Math.round(sw.elapsed) + "s" : "");
							$("mDot").className = "dot on";
						} else {
							$("mTxt").textContent = names[mode] || mode;
							$("mDot").className = "dot " + (mode === "chat" || mode === "draw" ? "on" : "");
						}
						if (pending && !switching && sw.msg) {
							if (sw.ok) toast(tf("serverSwitchedOk", "✅ {msg} 点「进入 →」打开", { msg: sw.msg }));
							else toast("❌ " + sw.msg, true);
							pending = "";
						}
						var sc = $("srcChip");
						if (sc) {
							var src = d.host || "";
							if (d.gpu) src += (src ? " · " : "") + "GPU " + d.gpu.total_gb + "GB";
							sc.textContent = src ? tf("serverDataSource", "数据源 {src}", { src: src }) : "";
							sc.style.display = src ? "inline-flex" : "none";
						}
						var chat = d.services && d.services.chat, draw = d.services && d.services.draw, build = d.services && d.services.build;
						$("tagChat").textContent = chat && chat.alive ? t("serverTagRunning", "运行中") : t("serverTagIdle", "未运行");
						$("tagChat").className = "pill" + (chat && chat.alive ? " run" : "");
						$("tagDraw").textContent = draw && draw.alive ? t("serverTagRunning", "运行中") : t("serverTagIdle", "未运行");
						$("tagDraw").className = "pill" + (draw && draw.alive ? " run" : "");
						var bc = $("btnChat");
						bc.textContent = chat && chat.alive
							? t("serverEnter", "进入 →")
							: (switching && sw.mode === "chat" ? t("serverStarting", "启动中…") : t("serverStart", "启动"));
						bc.disabled = switching;
						bc.onclick = function () {
							if (chat && chat.alive) { window.open(chat.url, "_blank"); return; }
							bc.disabled = true; toast(t("serverChatStarting", "正在启动对话(会自动停画图), 约 1~3 分钟…"));
							control("/api/switch?mode=chat").then(function (r) {
								r = r || {};
								if (r.accepted) { pending = "chat"; toast(t("serverSwitchStarted", "已开始切换, 进度见上方状态")); }
								else if (r.unconfirmed) { pending = "chat"; toast(r.msg); }
								else if (r.busy) { toast(r.msg || t("serverBusy", "已有切换在进行中, 请稍候")); }
								else { toast(r.msg || t("serverStartFailed", "启动失败"), !r.ok); }
								bc.disabled = false; refresh();
							});
						};
						var bd = $("btnDraw");
						bd.textContent = draw && draw.alive
							? t("serverEnter", "进入 →")
							: (switching && sw.mode === "draw" ? t("serverStarting", "启动中…") : t("serverStart", "启动"));
						bd.disabled = switching;
						bd.onclick = function () {
							if (draw && draw.alive) { window.open(draw.url, "_blank"); return; }
							bd.disabled = true; toast(t("serverDrawStarting", "正在启动画图(会自动停对话), 约 1~3 分钟…"));
							control("/api/switch?mode=draw").then(function (r) {
								r = r || {};
								if (r.accepted) { pending = "draw"; toast(t("serverSwitchStarted", "已开始切换, 进度见上方状态")); }
								else if (r.unconfirmed) { pending = "draw"; toast(r.msg); }
								else if (r.busy) { toast(r.msg || t("serverBusy", "已有切换在进行中, 请稍候")); }
								else { toast(r.msg || t("serverStartFailed", "启动失败"), !r.ok); }
								bd.disabled = false; refresh();
							});
						};
						if (build) {
							$("tagBuild").textContent = build.alive ? t("serverTagReady", "就绪") : t("serverTagUnconfigured", "未配置");
							$("tagBuild").className = "pill" + (build.alive ? " run" : "");
							var bb = $("btnBuild");
							bb.disabled = !build.alive;
							bb.onclick = function () { if (build.url) window.open(build.url, "_blank"); };
						}
						if (d.links && d.links.nas) {
							$("nasDs").textContent = d.links.nas.replace(/^https?:\/\//, "");
							$("btnNas").onclick = function () { window.open(d.links.nas, "_blank"); };
						}
						var g = d.gpu;
						if (g) {
							$("gpuTxt").innerHTML = g.used_gb + " <small>/ " + g.total_gb + " GB</small>";
							bar("gpuBar", g.total_gb ? (g.used_gb / g.total_gb) * 100 : 0);
							$("utilTxt").innerHTML = g.util + "% <small>" + (g.temp_c != null ? g.temp_c + "°" : "") + "</small>";
							bar("utilBar", g.util);
						} else { $("gpuTxt").textContent = "—"; $("utilTxt").textContent = "—"; }
						var c = d.cpu;
						$("cpuTxt").textContent = c && c.load != null ? c.load + "%" : "—";
						bar("cpuBar", c ? c.load : 0);
						var m = d.mem;
						if (m) {
							$("memTxt").innerHTML = m.used_gb + " <small>/ " + m.total_gb + " GB</small>";
							bar("memBar", m.total_gb ? (m.used_gb / m.total_gb) * 100 : 0);
						} else { $("memTxt").textContent = "—"; }
						if (d.disks && d.disks.length) {
							$("diskTxt").textContent = t("serverDisk", "磁盘") + "  " + d.disks.map(function (x) {
								return x.drive + " " + x.used_gb + " / " + x.total_gb + " GB";
							}).join("   ·   ");
						}
					}
					var busy = false;
					var offlineNotified = false;
					var fails = 0;   // 隧道本身会偶发丢包, 连续失败才判定离线, 避免界面来回闪
					function applyStats(d) {
						if (d && d.ok) {
							fails = 0;
							if (offlineNotified) { offlineNotified = false; toast(t("serverSourceRecovered", "数据源已恢复 ✅")); }
							render(d);
							return true;
						}
						fails++;
						if (fails >= 3) {
							$("mTxt").textContent = t("serverSourceOffline", "数据源离线");
							$("mDot").className = "dot";
							if (!offlineNotified) {
								offlineNotified = true;
								toast(((d && d.msg) ? d.msg + " · " : "") + t("serverSourceOfflineDetail", "数据源离线(隧道未运行或域名未解析)"), true);
							}
						} else if (!$("mTxt").textContent || $("mTxt").textContent === t("serverLoading", "读取中…")) {
							$("mTxt").textContent = t("serverRetrying", "重试中…");
						}
						return false;
					}
					function refresh() {
						applyTheme();
						if (busy) return; busy = true;
						jget("/api/stats").then(function (d) {
							if (!applyStats(d)) {
								// 立刻再试一次, 多数丢包重试即通
								return new Promise(function (res) { setTimeout(res, 1200); })
									.then(function () { return jget("/api/stats"); })
									.then(function (d2) { applyStats(d2); });
							}
						}).then(function () { busy = false; });
					}
					$("allStop").onclick = function () {
						var b = this; b.disabled = true; toast(t("serverStoppingAll", "正在全部停止…"));
						control("/api/switch?mode=idle").then(function (r) {
							r = r || {};
							if (r.accepted) { pending = "idle"; toast(t("serverStopStarted", "已开始停止, 稍后显存归零")); }
							else if (r.unconfirmed) { pending = "idle"; toast(r.msg); }
							else if (r.busy) { toast(r.msg || t("serverBusy", "已有切换在进行中, 请稍候")); }
							else { toast(r.msg || t("serverOpFailed", "操作失败"), !r.ok); }
							b.disabled = false; setTimeout(refresh, 800);
						});
					};
					$("wakeBtn").onclick = function () {
						var b = this; b.disabled = true;
						toast(t("serverWakeSent", "已请 NAS 发送唤醒包, 正在等待 E5 上线…"));
						control("/api/wake").then(function (r) {
							var ok = r && r.ok;
							toast(ok
								? t("serverWakeOk", "唤醒包已发出(需 E5 的 BIOS 开启 WoL), 大约 30~90 秒")
								: t("serverWakeFail", "唤醒请求失败:检查 NAS 唤醒服务"), !ok);
							var tries = 0;
							var timer = setInterval(function () {
								tries++;
								jget("/api/stats").then(function (d) {
									if (d && d.ok && d.mode && d.mode !== "idle") {
										clearInterval(timer); b.disabled = false;
										toast(t("serverWakeOnline", "E5 已上线 ✅")); render(d);
									} else if (tries >= 12) {
										clearInterval(timer); b.disabled = false;
										toast(t("serverWakeTimeout", "E5 仍未上线:可能 BIOS 未启用 WoL 或电源被断开"));
									}
								});
							}, 10000);
						});
					};
					refresh(); setInterval(refresh, 3000);
				})();
			</script>
		</div>
	</div>
</MainGridLayout>
