---
import MainGridLayout from "../layouts/MainGridLayout.astro";

export const prerender = true;
---

<MainGridLayout
	title="英语词典"
	description="中英双语词典：英美音标发音、词性释义、双语例句、词形变化、词组搭配、同义词与真题例句。"
>
	<div id="dict-app" class="dict-app">
		<div class="d-panel card-base">
			<div class="d-head">
				<div class="d-head-text">
					<h1 class="d-title">英语词典</h1>
					<p class="d-sub">中文释义 · 英美音标 · 双语例句 · 词形变化 · 词组搭配</p>
				</div>
			</div>

			<div class="d-search">
				<div class="d-input-box">
					<span class="d-input-icon" aria-hidden="true">🔍</span>
					<input
						id="d-input"
						class="d-input"
						type="text"
						placeholder="输入英语单词或短语，回车查询…"
						autocomplete="off"
						autocapitalize="off"
						autocorrect="off"
						spellcheck="false"
						aria-label="查询单词"
					/>
					<button id="d-clear" class="d-clear" type="button" hidden aria-label="清空">✕</button>
					<div id="d-suggest" class="d-suggest" hidden role="listbox"></div>
				</div>
				<button id="d-go" class="d-go" type="button">查询</button>
			</div>

			<div class="d-tabs" id="d-tabs">
				<button class="d-tab is-active" type="button" data-view="search">查词</button>
				<button class="d-tab" type="button" data-view="history">
					历史记录<i class="d-tab-n" data-count="history">0</i>
				</button>
				<button class="d-tab" type="button" data-view="fav">
					生词本<i class="d-tab-n" data-count="fav">0</i>
				</button>
			</div>
		</div>

		<div id="d-body" class="d-body"></div>
	</div>
</MainGridLayout>

<style is:global>
	.dict-app {
		--d-fg: #1f2328;
		--d-fg-2: rgba(31, 35, 40, 0.66);
		--d-fg-3: rgba(31, 35, 40, 0.44);
		--d-bg: var(--card-bg, #ffffff);
		--d-soft: rgba(31, 35, 40, 0.04);
		--d-soft-2: rgba(31, 35, 40, 0.07);
		--d-line: var(--line-divider, rgba(31, 35, 40, 0.1));
		--d-accent: var(--primary, #4a90d9);
		--d-accent-soft: color-mix(in srgb, var(--d-accent) 12%, transparent);
		--d-radius: var(--radius-large, 14px);
		--d-shadow: 0 2px 14px rgba(0, 0, 0, 0.06);

		display: flex;
		flex-direction: column;
		gap: 18px;
		width: 100%;
		color: var(--d-fg);
	}

	html.dark .dict-app,
	.dark .dict-app,
	html[data-theme="dark"] .dict-app {
		--d-fg: #e9ecf1;
		--d-fg-2: rgba(233, 236, 241, 0.68);
		--d-fg-3: rgba(233, 236, 241, 0.45);
		--d-soft: rgba(255, 255, 255, 0.05);
		--d-soft-2: rgba(255, 255, 255, 0.09);
		--d-line: var(--line-divider, rgba(255, 255, 255, 0.12));
		--d-shadow: 0 2px 14px rgba(0, 0, 0, 0.35);
	}

	.dict-app .d-panel {
		padding: 20px 22px 16px;
		box-shadow: var(--d-shadow);
	}

	/* ---------- 头部 ---------- */
	.d-head {
		margin-bottom: 14px;
	}
	.d-title {
		margin: 0;
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.d-sub {
		margin: 4px 0 0;
		font-size: 0.85rem;
		color: var(--d-fg-3);
	}

	/* ---------- 搜索 ---------- */
	.d-search {
		display: flex;
		gap: 10px;
		align-items: stretch;
	}
	.d-input-box {
		position: relative;
		flex: 1 1 auto;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 12px;
		border: 1.5px solid var(--d-line);
		border-radius: 12px;
		background: var(--d-soft);
		transition: border-color 0.18s ease, background 0.18s ease;
	}
	.d-input-box:focus-within {
		border-color: var(--d-accent);
		background: var(--d-bg);
	}
	.d-input-icon {
		font-size: 0.95rem;
		opacity: 0.55;
		flex: 0 0 auto;
	}
	.d-input {
		flex: 1 1 auto;
		min-width: 0;
		padding: 12px 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--d-fg);
		font-size: 1rem;
	}
	.d-input::placeholder {
		color: var(--d-fg-3);
	}
	.d-clear {
		flex: 0 0 auto;
		width: 24px;
		height: 24px;
		border: 0;
		border-radius: 50%;
		background: var(--d-soft-2);
		color: var(--d-fg-2);
		font-size: 0.7rem;
		cursor: pointer;
		line-height: 1;
	}
	.d-clear:hover {
		background: var(--d-accent-soft);
		color: var(--d-accent);
	}
	.d-go {
		flex: 0 0 auto;
		padding: 0 24px;
		border: 0;
		border-radius: 12px;
		background: var(--d-accent);
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		cursor: pointer;
		transition: opacity 0.18s ease;
	}
	.d-go:hover {
		opacity: 0.86;
	}

	/* ---------- 联想下拉 ---------- */
	.d-suggest {
		position: absolute;
		z-index: 40;
		top: calc(100% + 6px);
		left: -1.5px;
		right: -1.5px;
		max-height: 330px;
		overflow-y: auto;
		padding: 6px;
		border: 1px solid var(--d-line);
		border-radius: 12px;
		background: var(--d-bg);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
	}
	html.dark .d-suggest {
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}
	.d-sg {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 8px 10px;
		border-radius: 8px;
		cursor: pointer;
	}
	.d-sg.is-active,
	.d-sg:hover {
		background: var(--d-accent-soft);
	}
	.d-sg-word {
		font-size: 0.95rem;
		font-weight: 600;
	}
	.d-sg-exp {
		font-size: 0.76rem;
		color: var(--d-fg-3);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* ---------- 标签页 ---------- */
	.d-tabs {
		display: flex;
		gap: 6px;
		margin-top: 14px;
		border-top: 1px solid var(--d-line);
		padding-top: 12px;
	}
	.d-tab {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		color: var(--d-fg-2);
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.d-tab:hover {
		background: var(--d-soft);
	}
	.d-tab.is-active {
		background: var(--d-accent-soft);
		border-color: color-mix(in srgb, var(--d-accent) 35%, transparent);
		color: var(--d-accent);
		font-weight: 600;
	}
	.d-tab-n {
		font-style: normal;
		font-size: 0.72rem;
		padding: 0 6px;
		border-radius: 999px;
		background: var(--d-soft-2);
		color: var(--d-fg-2);
	}
	.d-tab.is-active .d-tab-n {
		background: color-mix(in srgb, var(--d-accent) 22%, transparent);
		color: var(--d-accent);
	}

	/* ---------- 结果区 ---------- */
	.d-body {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.d-sec {
		padding: 18px 22px;
		box-shadow: var(--d-shadow);
	}
	.d-sec-title {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 12px;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--d-fg-2);
		letter-spacing: 0.02em;
	}
	.d-sec-title::before {
		content: "";
		width: 3px;
		height: 14px;
		border-radius: 2px;
		background: var(--d-accent);
	}
	.d-sec-badge {
		font-size: 0.72rem;
		font-weight: 500;
		padding: 1px 8px;
		border-radius: 999px;
		background: var(--d-soft-2);
		color: var(--d-fg-3);
	}

	/* ---------- 词头 ---------- */
	.d-word-top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 12px;
	}
	.d-word {
		margin: 0;
		font-size: 2.1rem;
		font-weight: 700;
		line-height: 1.15;
		word-break: break-word;
	}
	.d-star-btn {
		margin-left: auto;
		padding: 5px 14px;
		border: 1px solid var(--d-line);
		border-radius: 999px;
		background: transparent;
		color: var(--d-fg-2);
		font-size: 0.82rem;
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.d-star-btn:hover {
		border-color: var(--d-accent);
		color: var(--d-accent);
	}
	.d-star-btn.is-on {
		background: #fff7e0;
		border-color: #f0b429;
		color: #b7791f;
	}
	html.dark .d-star-btn.is-on {
		background: rgba(240, 180, 41, 0.16);
		color: #f0b429;
	}

	.d-phonetics {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
	}
	.d-voice {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 5px 13px;
		border: 1px solid var(--d-line);
		border-radius: 999px;
		background: var(--d-soft);
		color: var(--d-fg-2);
		font-size: 0.85rem;
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.d-voice:hover {
		border-color: var(--d-accent);
		background: var(--d-accent-soft);
		color: var(--d-accent);
	}
	.d-voice-flag {
		font-size: 0.95rem;
	}
	.d-voice-phone {
		font-family: "Times New Roman", Georgia, serif;
	}

	.d-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 12px;
	}
	.d-tag {
		padding: 2px 10px;
		border-radius: 6px;
		font-size: 0.72rem;
		font-weight: 600;
		background: var(--d-soft-2);
		color: var(--d-fg-2);
	}
	.d-tag[data-tone="exam"] {
		background: rgba(52, 144, 220, 0.14);
		color: #2b7fc4;
	}
	.d-tag[data-tone="level"] {
		background: rgba(226, 122, 63, 0.16);
		color: #c25e20;
	}
	html.dark .d-tag[data-tone="exam"] {
		color: #7fb8ea;
	}
	html.dark .d-tag[data-tone="level"] {
		color: #f0a878;
	}

	/* ---------- 释义 ---------- */
	.d-tr {
		display: flex;
		gap: 12px;
		padding: 9px 0;
		border-bottom: 1px dashed var(--d-line);
	}
	.d-tr:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.d-tr:first-child {
		padding-top: 0;
	}
	.d-pos {
		flex: 0 0 auto;
		min-width: 62px;
		padding-top: 2px;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--d-accent);
	}
	.d-pos-cn {
		display: block;
		font-size: 0.68rem;
		font-weight: 400;
		color: var(--d-fg-3);
	}
	.d-tr-text {
		flex: 1 1 auto;
		font-size: 0.98rem;
		line-height: 1.75;
	}

	/* ---------- 词形变化 ---------- */
	.d-forms {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.d-form {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		border-radius: 8px;
		background: var(--d-soft);
		border: 1px solid var(--d-line);
		font-size: 0.82rem;
	}
	.d-form-name {
		color: var(--d-fg-3);
		font-size: 0.74rem;
	}
	.d-form-value {
		font-weight: 600;
		color: var(--d-accent);
		cursor: pointer;
	}
	.d-form-value:hover {
		text-decoration: underline;
	}

	/* ---------- 例句 ---------- */
	.d-sent {
		padding: 10px 0;
		border-bottom: 1px dashed var(--d-line);
	}
	.d-sent:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.d-sent:first-child {
		padding-top: 0;
	}
	.d-sent-en {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 0.96rem;
		line-height: 1.7;
	}
	.d-sent-en b {
		color: var(--d-accent);
		font-weight: 700;
	}
	.d-sent-play {
		flex: 0 0 auto;
		margin-top: 2px;
		width: 24px;
		height: 24px;
		border: 1px solid var(--d-line);
		border-radius: 50%;
		background: var(--d-soft);
		color: var(--d-fg-2);
		font-size: 0.68rem;
		cursor: pointer;
		line-height: 1;
		transition: all 0.16s ease;
	}
	.d-sent-play:hover {
		border-color: var(--d-accent);
		color: var(--d-accent);
	}
	.d-sent-zh {
		margin-top: 4px;
		padding-left: 32px;
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--d-fg-2);
	}
	.d-sent-src {
		margin-top: 4px;
		padding-left: 32px;
		font-size: 0.74rem;
		color: var(--d-fg-3);
	}

	/* ---------- 柯林斯 ---------- */
	.d-starline {
		color: #f0b429;
		font-size: 0.9rem;
		letter-spacing: 2px;
	}
	.d-col {
		padding: 10px 0;
		border-bottom: 1px dashed var(--d-line);
	}
	.d-col:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.d-col:first-child {
		padding-top: 0;
	}
	.d-col-head {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 5px;
	}
	.d-col-pos {
		padding: 1px 8px;
		border-radius: 5px;
		background: var(--d-soft-2);
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--d-fg-2);
	}
	.d-col-tips {
		font-size: 0.74rem;
		color: var(--d-fg-3);
	}
	.d-col-tran {
		font-size: 0.94rem;
		line-height: 1.72;
	}
	.d-col-ex {
		margin-top: 6px;
		padding-left: 12px;
		border-left: 2px solid var(--d-line);
		font-size: 0.86rem;
		line-height: 1.65;
	}
	.d-col-ex .zh {
		color: var(--d-fg-2);
	}

	/* ---------- 通用列表 ---------- */
	.d-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.d-list-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px;
		font-size: 0.92rem;
		line-height: 1.7;
	}
	.d-list-key {
		font-weight: 600;
		color: var(--d-accent);
		cursor: pointer;
	}
	.d-list-key:hover {
		text-decoration: underline;
	}
	.d-list-plain {
		font-weight: 600;
		color: var(--d-fg);
	}
	.d-list-val {
		color: var(--d-fg-2);
	}
	.d-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.d-chip {
		padding: 3px 11px;
		border: 1px solid var(--d-line);
		border-radius: 999px;
		background: var(--d-soft);
		font-size: 0.82rem;
		color: var(--d-fg);
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.d-chip:hover {
		border-color: var(--d-accent);
		color: var(--d-accent);
		background: var(--d-accent-soft);
	}
	.d-note {
		font-size: 0.88rem;
		line-height: 1.8;
		color: var(--d-fg-2);
		white-space: pre-wrap;
	}

	/* ---------- 列表页 ---------- */
	.d-rows {
		display: flex;
		flex-direction: column;
	}
	.d-row {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 11px 2px;
		border-bottom: 1px dashed var(--d-line);
	}
	.d-row:last-child {
		border-bottom: 0;
	}
	.d-row-main {
		flex: 1 1 auto;
		min-width: 0;
		cursor: pointer;
	}
	.d-row-word {
		font-size: 1rem;
		font-weight: 600;
	}
	.d-row-brief {
		margin-top: 2px;
		font-size: 0.8rem;
		color: var(--d-fg-3);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.d-row-del {
		flex: 0 0 auto;
		width: 28px;
		height: 28px;
		border: 1px solid transparent;
		border-radius: 8px;
		background: transparent;
		color: var(--d-fg-3);
		cursor: pointer;
		line-height: 1;
	}
	.d-row-del:hover {
		border-color: var(--d-line);
		background: var(--d-soft);
		color: #e5484d;
	}

	/* ---------- 状态 ---------- */
	.d-empty {
		padding: 34px 22px;
		text-align: center;
		box-shadow: var(--d-shadow);
	}
	.d-empty-icon {
		font-size: 2rem;
	}
	.d-empty-title {
		margin: 10px 0 4px;
		font-size: 1.02rem;
		font-weight: 600;
	}
	.d-empty-desc {
		font-size: 0.86rem;
		color: var(--d-fg-3);
	}
	.d-reco {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 7px;
		margin-top: 16px;
	}
	.d-err {
		padding: 26px 22px;
		text-align: center;
		box-shadow: var(--d-shadow);
	}
	.d-err-msg {
		font-size: 0.96rem;
		margin-bottom: 12px;
	}
	.d-btn {
		padding: 7px 18px;
		border: 1px solid var(--d-line);
		border-radius: 10px;
		background: var(--d-soft);
		color: var(--d-fg);
		font-size: 0.86rem;
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.d-btn:hover {
		border-color: var(--d-accent);
		color: var(--d-accent);
	}
	.d-btn-primary {
		background: var(--d-accent);
		border-color: var(--d-accent);
		color: #fff;
	}
	.d-btn-primary:hover {
		color: #fff;
		opacity: 0.86;
	}

	/* ---------- 骨架屏 ---------- */
	.d-skel {
		padding: 22px;
		box-shadow: var(--d-shadow);
	}
	.d-skel-line {
		height: 13px;
		margin-bottom: 11px;
		border-radius: 7px;
		background: linear-gradient(
			90deg,
			var(--d-soft) 25%,
			var(--d-soft-2) 37%,
			var(--d-soft) 63%
		);
		background-size: 400% 100%;
		animation: d-shimmer 1.25s ease infinite;
	}
	@keyframes d-shimmer {
		0% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0 50%;
		}
	}

	.d-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 12px;
	}
	.d-toolbar-title {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--d-fg-2);
	}

	@media (max-width: 620px) {
		.dict-app .d-panel {
			padding: 16px 14px 12px;
		}
		.d-search {
			flex-wrap: wrap;
		}
		.d-go {
			padding: 0 18px;
			height: 44px;
			flex: 1 1 100%;
		}
		.d-sec,
		.d-skel {
			padding: 15px 14px;
