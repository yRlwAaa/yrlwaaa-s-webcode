---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { AlbumCard } from "@components/features/albums";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { scanAlbums } from "../utils/album-scanner";

if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

const albumsData = await scanAlbums();

// Collect all unique tags for filtering
const allTags = [...new Set(albumsData.flatMap((a) => a.tags || []))].sort();

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: albumsData.length,
	},
	...allTags.map((tag) => ({
		value: tag,
		label: tag,
		count: albumsData.filter((a) => a.tags && a.tags.includes(tag)).length,
	})),
];

const title = i18n(I18nKey.albums);
const subtitle = i18n(I18nKey.albumsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<script is:inline src="/js/filter-tabs-handler.js"></script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} titleKey={I18nKey.albums} subtitleKey={I18nKey.albumsSubtitle} />

			<!--
				地球足迹入口（全屏 3D 地球页）
				整块 <a> 可以随便挪位置（放页面底部也行）；不要了就删掉这段加下面的样式，
				/globe/ 页面本身仍然独立可用。
			-->
			<a class="album-globe-entry" href="/globe/" aria-label="打开地球足迹">
				<span class="album-globe-ball" aria-hidden="true">
					<span class="album-globe-ring"></span>
				</span>
				<span class="album-globe-text">
					<strong>地球足迹</strong>
					<small>全屏 3D 地球 · 标下去过的地方，带坐标、照片与感想</small>
				</span>
				<span class="album-globe-cta">
					打开地球
					<span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span>
				</span>
			</a>

			{
				albumsData.length > 0 && allTags.length > 0 && (
					<div class="mb-8">
						<FilterTabs tabs={filterTabs} dataAttr="tags" />
					</div>
				)
			}

			<div id="albums-grid" class="grid gap-6 items-start">
				{albumsData.map((album) => <AlbumCard album={album} />)}
			</div>

			<div id="no-results" class="hidden text-center py-16">
				<Icon
					name="material-symbols:search-off-rounded"
					class="text-6xl text-black/15 dark:text-white/15 mb-4"
				/>
				<p class="text-black/40 dark:text-white/40 text-lg" data-i18n="albumsNoResults">
					{i18n(I18nKey.albumsNoResults)}
				</p>
			</div>

			{
				albumsData.length === 0 && (
					<div class="text-center py-16">
						<Icon
							name="material-symbols:photo-library"
							class="text-6xl text-black/15 dark:text-white/15 mb-4"
						/>
						<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2" data-i18n="albumsEmpty">
							{i18n(I18nKey.albumsEmpty)}
						</h3>
						<p class="text-black/60 dark:text-white/60" data-i18n="albumsEmptyDesc">
							{i18n(I18nKey.albumsEmptyDesc)}
						</p>
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>

<style is:global>
	/* ---- 相册页的「地球足迹」入口 ---- */
	.album-globe-entry {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-bottom: 24px;
		padding: 14px 18px;
		border-radius: var(--radius-large, 14px);
		border: 1px solid color-mix(in srgb, var(--primary, #7186f5) 28%, transparent);
		background:
			radial-gradient(120% 160% at 0% 0%, color-mix(in srgb, var(--primary, #7186f5) 16%, transparent), transparent 60%),
			color-mix(in srgb, var(--primary, #7186f5) 6%, transparent);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.album-globe-entry:hover {
		transform: translateY(-2px);
		border-color: var(--primary, #7186f5);
	}

	/* 小球图标：用 CSS 画一个会转的地球，避免多一张图 */
	.album-globe-ball {
		position: relative;
		flex: 0 0 46px;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		background:
			radial-gradient(circle at 32% 28%, #6ea8ff 0%, #2b62d6 45%, #12336e 100%);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--primary, #7186f5) 40%, transparent) inset,
			0 6px 18px color-mix(in srgb, var(--primary, #7186f5) 35%, transparent);
		overflow: hidden;
	}

	.album-globe-ring {
		position: absolute;
		inset: -30% -55%;
		border-radius: 50%;
		border: 1.5px solid rgba(255, 255, 255, 0.5);
		transform: rotate(-22deg);
	}

	.album-globe-ring::after {
		content: "";
		position: absolute;
		inset: 22% 8%;
		border-radius: 50%;
		border: 1.5px solid rgba(255, 255, 255, 0.32);
	}

	.album-globe-entry:hover .album-globe-ball {
		animation: album-globe-spin 3.4s linear infinite;
	}

	@keyframes album-globe-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	.album-globe-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		flex: 1;
	}

	.album-globe-text strong {
		font-size: 1rem;
		font-weight: 700;
		color: color-mix(in srgb, currentColor 92%, transparent);
	}

	.album-globe-text small {
		font-size: 0.78rem;
		color: color-mix(in srgb, currentColor 58%, transparent);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.album-globe-cta {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
		padding: 7px 14px;
		border-radius: 999px;
		background: var(--primary, #7186f5);
		color: #fff;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.album-globe-cta .material-symbols-rounded {
		font-size: 17px;
	}

	@media (max-width: 639px) {
		.album-globe-entry {
			flex-wrap: wrap;
			gap: 10px;
		}

		.album-globe-text small {
			white-space: normal;
		}

		.album-globe-cta {
			width: 100%;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.album-globe-entry:hover .album-globe-ball {
			animation: none;
		}
	}

	#albums-grid {
		grid-template-columns: 1fr;
	}

	@media (min-width: 640px) {
		#albums-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	#main-grid[data-layout-mode="grid"] #albums-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	@media (max-width: 639px) {
		#main-grid[data-layout-mode="grid"] #albums-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
