---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.artists.map((artist) => ({
    params: { id: artist.id }
  }));
}

const { id } = Astro.params;
const artist = musicData.artists.find(a => a.id === id);
const albums = musicData.albums.filter(a => a.artistId === id);
---

<MainGridLayout title={artist?.name || "歌手"}>
  <div id="artist-detail">
    <div class="artist-header">
      <img src={artist?.image} alt={artist?.name} class="artist-avatar" />
      <div>
        <h1 id="artist-name">{artist?.name}</h1>
        <p id="artist-bio">{artist?.bio || ""}</p>
        <span class="album-count" id="album-count">{albums.length} 张专辑</span>
      </div>
    </div>

    <div class="album-grid">
      {albums.map((album) => (
        <a href={`/music/album/${album.id}`} class="album-card">
          <img src={album.cover} alt={album.title} />
          <div class="album-info">
            <h3 class="album-title">{album.title}</h3>
            <p class="album-meta">{album.year} · {album.tracks.length} 首</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainGridLayout>

<style>
  .artist-header {
    display: flex; align-items: center; gap: 2rem;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--music-border, #e5e7eb);
    margin-bottom: 2rem;
    background: var(--music-bg, #fff);
  }
  .artist-avatar { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; }
  .artist-header h1 { font-size: 2rem; color: var(--music-text, #000); }
  .artist-header p { color: var(--music-text-sec, #6b7280); }
  .album-count {
    display: inline-block; margin-top: 0.5rem; font-size: 0.8rem;
    padding: 0.25rem 0.75rem; border-radius: 20px;
    color: var(--music-text-sec, #6b7280);
    background: var(--music-hover, #f3f4f6);
  }
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  .album-card {
    text-decoration: none;
    border-radius: 12px; overflow: hidden;
    border: 1px solid var(--music-border, #e5e7eb);
    transition: transform 0.2s;
    background: var(--music-bg, #fff);
  }
  .album-card:hover { transform: translateY(-4px); }
  .album-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; }
  .album-info { padding: 0.75rem; }
  .album-info h3 { font-size: 0.95rem; color: var(--music-text, #000); }
  .album-info p { font-size: 0.8rem; color: var(--music-text-sec, #6b7280); }
  @media (max-width: 640px) { .artist-header { flex-direction: column; text-align: center; } }
</style>

<script>
  function applyTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const htmlBg = getComputedStyle(document.documentElement).backgroundColor;
    const text = isDark ? '#ffffff' : '#000000';
    const textSec = isDark ? '#9ca3af' : '#6b7280';
    const border = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
    const hover = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
    document.documentElement.style.setProperty('--music-bg', htmlBg);
    document.documentElement.style.setProperty('--music-text', text);
    document.documentElement.style.setProperty('--music-text-sec', textSec);
    document.documentElement.style.setProperty('--music-border', border);
    document.documentElement.style.setProperty('--music-hover', hover);
  }
  setTimeout(applyTheme, 0);
  const observer = new MutationObserver(() => applyTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] });
</script>