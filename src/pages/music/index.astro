---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../data/music.json";
---

<MainGridLayout title="音乐">
  <div id="music-app">
    <div class="page-header">
      <h1 id="index-title">音乐</h1>
      <p id="index-subtitle">{musicData.artists.length} 位歌手</p>
    </div>
    <div class="artist-grid">
      {musicData.artists.map(artist => (
        <a href={`/music/artist/${artist.id}`} class="artist-card">
          <img src={artist.image} alt={artist.name} />
          <h3 class="artist-name">{artist.name}</h3>
          <p class="artist-bio">{artist.bio || ''}</p>
        </a>
      ))}
    </div>
  </div>
</MainGridLayout>

<script is:inline>
  const isDark = document.documentElement.classList.contains('dark');
  const bg = isDark ? '#1a1a2e' : '#ffffff';
  const text = isDark ? '#ffffff' : '#000000';
  const textSec = isDark ? '#9ca3af' : '#6b7280';
  const border = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
  document.documentElement.style.setProperty('--music-bg', bg);
  document.documentElement.style.setProperty('--music-text', text);
  document.documentElement.style.setProperty('--music-text-sec', textSec);
  document.documentElement.style.setProperty('--music-border', border);
</script>

<style>
  .page-header h1 { font-size: 2rem; margin-bottom: 0.25rem; color: var(--music-text, #000); }
  .page-header p { color: var(--music-text-sec, #6b7280); }
  .artist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }
  .artist-card {
    text-decoration: none;
    text-align: center;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--music-border, #e5e7eb);
    padding: 1rem;
    transition: transform 0.2s;
    background: var(--music-bg, #fff);
  }
  .artist-card:hover { transform: translateY(-4px); }
  .artist-card img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 50%;
  }
  .artist-card h3 { margin-top: 0.75rem; font-size: 1rem; color: var(--music-text, #000); }
  .artist-card p { font-size: 0.8rem; color: var(--music-text-sec, #6b7280); }
</style>

<script>
  function applyTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const bg = isDark ? '#1a1a2e' : '#ffffff';
    const text = isDark ? '#ffffff' : '#000000';
    const textSec = isDark ? '#9ca3af' : '#6b7280';
    const border = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
    document.documentElement.style.setProperty('--music-bg', bg);
    document.documentElement.style.setProperty('--music-text', text);
    document.documentElement.style.setProperty('--music-text-sec', textSec);
    document.documentElement.style.setProperty('--music-border', border);
  }
  const observer = new MutationObserver(() => applyTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>