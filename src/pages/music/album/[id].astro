---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.albums.map((album) => ({
    params: { id: album.id }
  }));
}

const { id } = Astro.params;
const album = musicData.albums.find(a => a.id === id);
const artist = musicData.artists.find(a => a.id === album?.artistId);
---

<MainGridLayout title={album?.title || "专辑"}>
  <div id="album-detail">
    <div class="album-header">
      <img src={album?.cover} alt={album?.title} class="album-cover" />
      <div class="album-meta">
        <span class="type">专辑</span>
        <h1 id="album-title">{album?.title}</h1>
        <p class="artist-name">
          <a href={`/music/artist/${artist?.id}`} id="artist-link">{artist?.name || "未知"}</a>
        </p>
        <p class="details" id="album-details">{album?.year} · {album?.genre || "未知"}</p>
        <span class="track-count" id="track-count">{album?.tracks.length} 首歌曲</span>
      </div>
    </div>

    <div class="track-list">
      {album?.tracks.map((track, index) => {
        const downloadUrl = `/music/${track.file}`;
        const filename = track.file.split('/').pop();
        
        return (
          <div class="track-item">
            <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="track-info">
              <span class="track-title">{track.title}</span>
              <span class="track-duration">{track.duration || "--"}</span>
            </div>
            <a href={downloadUrl} download={filename} class="download-btn">下载</a>
          </div>
        );
      })}
    </div>
  </div>
</MainGridLayout>

<style>
  .album-header {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid var(--music-border, #e5e7eb);
    margin-bottom: 2rem;
    background: var(--music-bg, #fff);
  }
  .album-cover { width: 200px; height: 200px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
  .album-meta { display: flex; flex-direction: column; justify-content: center; }
  .album-meta .type { font-size: 0.75rem; color: var(--music-text-sec, #6b7280); letter-spacing: 1px; }
  .album-meta h1 { font-size: 2rem; margin: 0.25rem 0; color: var(--music-text, #000); }
  .album-meta .artist-name a { color: var(--music-primary, #3b82f6); text-decoration: none; }
  .album-meta .details { color: var(--music-text-sec, #6b7280); font-size: 0.9rem; }
  .track-count {
    margin-top: 0.5rem; font-size: 0.8rem;
    padding: 0.25rem 0.75rem; border-radius: 20px;
    display: inline-block;
    color: var(--music-text-sec, #6b7280);
    background: var(--music-hover, #f3f4f6);
  }
  .track-list { 
    border-radius: 12px; 
    border: 1px solid var(--music-border, #e5e7eb);
    overflow: hidden; 
    background: var(--music-bg, #fff);
  }
  .track-item {
    display: flex; 
    align-items: center; 
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--music-border, #e5e7eb);
    background: transparent;
  }
  .track-item:last-child { border-bottom: none; }
  .track-item:hover { 
    background: transparent !important;
  }
  .track-number { width: 40px; font-size: 0.85rem; color: var(--music-text-sec, #6b7280); }
  .track-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
  .track-title { font-size: 0.95rem; color: var(--music-text, #000); }
  .track-duration { font-size: 0.8rem; color: var(--music-text-sec, #6b7280); }
  .download-btn {
    padding: 0.25rem 0.75rem; 
    font-size: 0.8rem;
    color: #fff; 
    border-radius: 6px;
    text-decoration: none; 
    margin-left: 1rem; 
    white-space: nowrap;
    background: var(--music-primary, #3b82f6);
  }
  .download-btn:hover { opacity: 0.8; }
  
  @media (max-width: 640px) {
    .album-header { flex-direction: column; align-items: center; text-align: center; }
    .album-cover { width: 160px; height: 160px; }
    .track-item { flex-wrap: wrap; gap: 0.5rem; }
    .track-info { flex: 1 1 100%; order: 2; }
    .download-btn { margin-left: 0; order: 3; width: 100%; text-align: center; }
  }
</style>

<script>
  function applyTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const htmlBg = getComputedStyle(document.documentElement).backgroundColor;
    const text = isDark ? '#ffffff' : '#000000';
    const textSec = isDark ? '#9ca3af' : '#6b7280';
    const border = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
    const hover = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
    const primary = '#3b82f6';
    document.documentElement.style.setProperty('--music-bg', htmlBg);
    document.documentElement.style.setProperty('--music-text', text);
    document.documentElement.style.setProperty('--music-text-sec', textSec);
    document.documentElement.style.setProperty('--music-border', border);
    document.documentElement.style.setProperty('--music-hover', hover);
    document.documentElement.style.setProperty('--music-primary', primary);
  }
  setTimeout(applyTheme, 0);
  const observer = new MutationObserver(() => applyTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] });
</script>