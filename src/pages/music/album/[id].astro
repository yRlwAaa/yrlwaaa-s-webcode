---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.albums.map((album) => ({
    params: { id: album.id }
  }));
}

const { id } = Astro.params;
const album = musicData.albums.find(a => a.id === id);
const artist = musicData.artists.find(a => a.id === album?.artistId);
---

<MainGridLayout title={album?.title || "专辑"}>
  <div id="album-detail">
    <div class="album-header">
      <img src={album?.cover} alt={album?.title} class="album-cover" />
      <div class="album-meta">
        <span class="type">专辑</span>
        <h1>{album?.title}</h1>
        <p class="artist-name">
          <a href={`/music/artist/${artist?.id}`}>{artist?.name || "未知"}</a>
        </p>
        <p class="details">{album?.year} · {album?.genre || "未知"}</p>
        <span class="track-count">{album?.tracks.length} 首歌曲</span>
      </div>
    </div>

    <div class="track-list">
      {album?.tracks.map((track, index) => {
        const downloadUrl = `/music/${track.file}`;
        const filename = track.file.split('/').pop();
        
        return (
          <div class="track-item">
            <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="track-info">
              <span class="track-title">{track.title}</span>
              <span class="track-duration">{track.duration || "--"}</span>
            </div>
            <a href={downloadUrl} download={filename} class="download-btn">下载</a>
          </div>
        );
      })}
    </div>
  </div>
</MainGridLayout>

<style>
  .album-header {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 16px;
    border: 1px solid var(--line-divider);
    margin-bottom: 2rem;
  }
  .album-cover { width: 200px; height: 200px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
  .album-meta { display: flex; flex-direction: column; justify-content: center; }
  .album-meta .type { font-size: 0.75rem; color: var(--text-secondary); letter-spacing: 1px; }
  .album-meta h1 { font-size: 2rem; margin: 0.25rem 0; color: var(--text-primary); }
  .album-meta .artist-name a { color: var(--primary); text-decoration: none; }
  .album-meta .details { color: var(--text-secondary); font-size: 0.9rem; }
  .track-count {
    margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-secondary);
    background: var(--hover-bg); padding: 0.25rem 0.75rem; border-radius: 20px;
    display: inline-block;
  }
  .track-list { background: var(--card-bg); border-radius: 12px; border: 1px solid var(--line-divider); overflow: hidden; }
  .track-item {
    display: flex; align-items: center; padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line-divider);
  }
  .track-item:last-child { border-bottom: none; }
  .track-item:hover { background: var(--hover-bg); }
  .track-number { width: 40px; font-size: 0.85rem; color: var(--text-secondary); }
  .track-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
  .track-title { font-size: 0.95rem; color: var(--text-primary); }
  .track-duration { font-size: 0.8rem; color: var(--text-secondary); }
  .download-btn {
    padding: 0.25rem 0.75rem; font-size: 0.8rem;
    background: var(--primary); color: #fff; border-radius: 6px;
    text-decoration: none; margin-left: 1rem; white-space: nowrap;
  }
  .download-btn:hover { opacity: 0.8; }
  @media (max-width: 640px) {
    .album-header { flex-direction: column; align-items: center; text-align: center; }
    .album-cover { width: 160px; height: 160px; }
    .track-item { flex-wrap: wrap; gap: 0.5rem; }
    .track-info { flex: 1 1 100%; order: 2; }
    .download-btn { margin-left: 0; order: 3; width: 100%; text-align: center; }
  }
</style>