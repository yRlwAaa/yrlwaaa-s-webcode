---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.albums.map((album) => ({
    params: { id: album.id }
  }));
}

const { id } = Astro.params;
const album = musicData.albums.find(a => a.id === id);
const artist = musicData.artists.find(a => a.id === album?.artistId);
---

<MainGridLayout title={album?.title || "专辑"}>
  <div id="album-detail">
    <div class="album-header">
      <img src={album?.cover} alt={album?.title} class="album-cover" />
      <div class="album-meta">
        <span class="type">专辑</span>
        <h1 id="album-title">{album?.title}</h1>
        <p class="artist-name">
          <a href={`/music/artist/${artist?.id}`} id="artist-link">{artist?.name || "未知"}</a>
        </p>
        <p class="details" id="album-details">{album?.year} · {album?.genre || "未知"}</p>
        <span class="track-count" id="track-count">{album?.tracks.length} 首歌曲</span>
      </div>
    </div>

    <div class="track-list">
      {album?.tracks.map((track, index) => {
        const downloadUrl = `/music/${track.file}`;
        const filename = track.file.split('/').pop();
        
        return (
          <div class="track-item">
            <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="track-info">
              <span class="track-title">{track.title}</span>
              <span class="track-duration">{track.duration || "--"}</span>
            </div>
            <a href={downloadUrl} download={filename} class="download-btn">下载</a>
          </div>
        );
      })}
    </div>
  </div>
</MainGridLayout>

<style>
  .album-header {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }
  .album-cover { width: 200px; height: 200px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
  .album-meta { display: flex; flex-direction: column; justify-content: center; }
  .album-meta .type { font-size: 0.75rem; letter-spacing: 1px; transition: color 0.3s; }
  .album-meta h1 { font-size: 2rem; margin: 0.25rem 0; transition: color 0.3s; }
  .album-meta .artist-name a { text-decoration: none; transition: color 0.3s; }
  .album-meta .details { font-size: 0.9rem; transition: color 0.3s; }
  .track-count {
    margin-top: 0.5rem; font-size: 0.8rem;
    padding: 0.25rem 0.75rem; border-radius: 20px;
    display: inline-block;
    transition: all 0.3s;
  }
  .track-list { 
    border-radius: 12px; 
    border: 1px solid;
    overflow: hidden; 
    transition: all 0.3s;
  }
  .track-item {
    display: flex; 
    align-items: center; 
    padding: 0.75rem 1rem;
    border-bottom: 1px solid;
    transition: all 0.3s;
  }
  .track-item:last-child { border-bottom: none; }
  .track-item:hover { background: rgba(255,255,255,0.05); }
  .track-number { width: 40px; font-size: 0.85rem; transition: color 0.3s; }
  .track-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
  .track-title { font-size: 0.95rem; transition: color 0.3s; }
  .track-duration { font-size: 0.8rem; transition: color 0.3s; }
  .download-btn {
    padding: 0.25rem 0.75rem; 
    font-size: 0.8rem;
    color: #fff; 
    border-radius: 6px;
    text-decoration: none; 
    margin-left: 1rem; 
    white-space: nowrap;
    transition: background 0.3s;
  }
  .download-btn:hover { opacity: 0.8; }
  
  @media (max-width: 640px) {
    .album-header { flex-direction: column; align-items: center; text-align: center; }
    .album-cover { width: 160px; height: 160px; }
    .track-item { flex-wrap: wrap; gap: 0.5rem; }
    .track-info { flex: 1 1 100%; order: 2; }
    .download-btn { margin-left: 0; order: 3; width: 100%; text-align: center; }
  }
</style>

<script>
  function applyTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    
    // 读取 html 的实际背景色
    const htmlBg = getComputedStyle(document.documentElement).backgroundColor;
    
    const text = isDark ? '#ffffff' : '#000000';
    const textSec = isDark ? '#9ca3af' : '#6b7280';
    const border = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
    const primary = '#3b82f6';
    const hover = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
    
    // 背景和边框
    const header = document.querySelector('.album-header');
    if (header) {
      header.style.backgroundColor = htmlBg;
      header.style.borderColor = border;
    }
    
    const trackList = document.querySelector('.track-list');
    if (trackList) {
      trackList.style.backgroundColor = htmlBg;
      trackList.style.borderColor = border;
    }
    
    // 文字颜色
    const title = document.getElementById('album-title');
    if (title) title.style.color = text;
    
    const type = document.querySelector('.album-meta .type');
    if (type) type.style.color = textSec;
    
    const details = document.getElementById('album-details');
    if (details) details.style.color = textSec;
    
    const trackCount = document.getElementById('track-count');
    if (trackCount) {
      trackCount.style.color = textSec;
      trackCount.style.backgroundColor = hover;
    }
    
    const artistLink = document.getElementById('artist-link');
    if (artistLink) artistLink.style.color = primary;
    
    document.querySelectorAll('.track-item').forEach(item => {
      const number = item.querySelector('.track-number');
      const title = item.querySelector('.track-title');
      const duration = item.querySelector('.track-duration');
      const btn = item.querySelector('.download-btn');
      
      if (number) number.style.color = textSec;
      if (title) title.style.color = text;
      if (duration) duration.style.color = textSec;
      if (btn) btn.style.backgroundColor = primary;
      
      item.style.borderColor = border;
      item.style.backgroundColor = 'transparent';
    });
  }
  
  setTimeout(applyTheme, 50);
  const observer = new MutationObserver(() => applyTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>