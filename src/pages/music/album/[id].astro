---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.albums.map((album) => ({
    params: { id: album.id }
  }));
}

const { id } = Astro.params;
const album = musicData.albums.find(a => a.id === id);
const artist = musicData.artists.find(a => a.id === album?.artistId);
---

<MainGridLayout title={album?.title || "专辑"}>
  <div id="album-detail">
    <div class="album-header">
      <img src={album?.cover} alt={album?.title} class="album-cover" />
      <div class="album-meta">
        <span class="type">专辑</span>
        <h1>{album?.title}</h1>
        <p class="artist-name">
          <a href={`/music/artist/${artist?.id}`}>{artist?.name || "未知"}</a>
        </p>
        <p class="details">{album?.year} · {album?.genre || "未知"}</p>
        <span class="track-count">{album?.tracks.length} 首歌曲</span>
      </div>
    </div>

    <div class="track-list">
      {album?.tracks.map((track, index) => {
        const downloadUrl = `/music/${track.file}`;
        const filename = track.file.split('/').pop();
        
        return (
          <div class="track-item">
            <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="track-info">
              <span class="track-title">{track.title}</span>
              <span class="track-duration">{track.duration || "--"}</span>
            </div>
            <a href={downloadUrl} download={filename} class="download-btn">下载</a>
          </div>
        );
      })}
    </div>
  </div>
</MainGridLayout>

<style>
  .album-header {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border-radius: 16px;
    border: 1px solid var(--border-color, #e5e7eb);
    margin-bottom: 2rem;
  }
  .album-cover { width: 200px; height: 200px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
  .album-meta { display: flex; flex-direction: column; justify-content: center; }
  .album-meta .type { font-size: 0.75rem; color: var(--text-secondary, #6b7280); letter-spacing: 1px; }
  .album-meta h1 { font-size: 2rem; margin: 0.25rem 0; color: var(--text-color, #000); }
  .album-meta .artist-name a { color: var(--primary-color, #3b82f6); text-decoration: none; }
  .album-meta .details { color: var(--text-secondary, #6b7280); font-size: 0.9rem; }
  .track-count {
    margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-secondary, #6b7280);
    background: var(--bg-hover, #f3f4f6); padding: 0.25rem 0.75rem; border-radius: 20px;
    display: inline-block;
  }
  .track-list { 
    background: var(--card-bg); 
    border-radius: 12px; 
    border: 1px solid var(--border-color, #e5e7eb); 
    overflow: hidden; 
  }
  .track-item {
    display: flex; align-items: center; padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
  }
  .track-item:last-child { border-bottom: none; }
  .track-item:hover { background: var(--bg-hover, #f3f4f6); }
  .track-number { width: 40px; font-size: 0.85rem; color: var(--text-secondary, #6b7280); }
  .track-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
  .track-title { font-size: 0.95rem; color: var(--text-color, #000); }
  .track-duration { font-size: 0.8rem; color: var(--text-secondary, #6b7280); }
  .download-btn {
    padding: 0.25rem 0.75rem; font-size: 0.8rem;
    background: var(--primary-color, #3b82f6); color: #fff; border-radius: 6px;
    text-decoration: none; margin-left: 1rem; white-space: nowrap;
  }
  .download-btn:hover { opacity: 0.8; }
  
  @media (max-width: 640px) {
    .album-header { flex-direction: column; align-items: center; text-align: center; }
    .album-cover { width: 160px; height: 160px; }
    .track-item { flex-wrap: wrap; gap: 0.5rem; }
    .track-info { flex: 1 1 100%; order: 2; }
    .download-btn { margin-left: 0; order: 3; width: 100%; text-align: center; }
  }
</style>

<script>
  function applyTheme() {
    const root = document.documentElement;
    const styles = getComputedStyle(root);
    
    // 读取主题实际颜色
    const bg = styles.getPropertyValue('--card-bg').trim() || '#ffffff';
    const text = styles.getPropertyValue('--text-color').trim() || '#000000';
    const textSec = styles.getPropertyValue('--text-secondary').trim() || '#6b7280';
    const border = styles.getPropertyValue('--border-color').trim() || '#e5e7eb';
    const hover = styles.getPropertyValue('--bg-hover').trim() || '#f3f4f6';
    const primary = styles.getPropertyValue('--primary-color').trim() || styles.getPropertyValue('--primary').trim() || '#3b82f6';
    
    // 应用到根元素
    const detail = document.getElementById('album-detail');
    if (detail) {
      detail.style.setProperty('--card-bg', bg);
      detail.style.setProperty('--text-color', text);
      detail.style.setProperty('--text-secondary', textSec);
      detail.style.setProperty('--border-color', border);
      detail.style.setProperty('--bg-hover', hover);
      detail.style.setProperty('--primary-color', primary);
    }
  }
  
  // 初始执行
  setTimeout(applyTheme, 100);
  
  // 监听主题变化
  const observer = new MutationObserver(() => {
    setTimeout(applyTheme, 100);
  });
  observer.observe(document.documentElement, { 
    attributes: true, 
    attributeFilter: ['class', 'style', 'data-theme'] 
  });
</script>