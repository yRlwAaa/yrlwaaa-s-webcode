---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import musicData from "../../../data/music.json";

export async function getStaticPaths() {
  return musicData.albums.map((album) => ({
    params: { id: album.id }
  }));
}

const { id } = Astro.params;
const album = musicData.albums.find(a => a.id === id);
const artist = musicData.artists.find(a => a.id === album?.artistId);
---

<MainGridLayout title={album?.title || "专辑"}>
  <div id="album-detail">
    <div class="album-header" id="album-header">
      <img src={album?.cover} alt={album?.title} class="album-cover" />
      <div class="album-meta">
        <span class="type" id="type-text">专辑</span>
        <h1 id="title-text">{album?.title}</h1>
        <p class="artist-name">
          <a href={`/music/artist/${artist?.id}`} id="artist-link">{artist?.name || "未知"}</a>
        </p>
        <p class="details" id="details-text">{album?.year} · {album?.genre || "未知"}</p>
        <span class="track-count" id="track-count">{album?.tracks.length} 首歌曲</span>
      </div>
    </div>

    <div class="track-list" id="track-list">
      {album?.tracks.map((track, index) => {
        const downloadUrl = `/music/${track.file}`;
        const filename = track.file.split('/').pop();
        
        return (
          <div class="track-item" id="track-item">
            <span class="track-number" id="track-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="track-info">
              <span class="track-title" id="track-title">{track.title}</span>
              <span class="track-duration" id="track-duration">{track.duration || "--"}</span>
            </div>
            <a href={downloadUrl} download={filename} class="download-btn" id="download-btn">下载</a>
          </div>
        );
      })}
    </div>
  </div>
</MainGridLayout>

<style>
  .album-header {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    border-radius: 16px;
    border: 1px solid;
    margin-bottom: 2rem;
    transition: all 0.3s;
  }
  .album-cover { width: 200px; height: 200px; object-fit: cover; border-radius: 12px; flex-shrink: 0; }
  .album-meta { display: flex; flex-direction: column; justify-content: center; }
  .album-meta .type { font-size: 0.75rem; letter-spacing: 1px; }
  .album-meta h1 { font-size: 2rem; margin: 0.25rem 0; }
  .album-meta .artist-name a { text-decoration: none; }
  .album-meta .details { font-size: 0.9rem; }
  .track-count {
    margin-top: 0.5rem; font-size: 0.8rem;
    padding: 0.25rem 0.75rem; border-radius: 20px;
    display: inline-block;
  }
  .track-list { 
    border-radius: 12px; 
    border: 1px solid;
    overflow: hidden; 
    transition: all 0.3s;
  }
  .track-item {
    display: flex; 
    align-items: center; 
    padding: 0.75rem 1rem;
    border-bottom: 1px solid;
    transition: all 0.3s;
  }
  .track-item:last-child { border-bottom: none; }
  .track-item:hover { background: var(--color-bg-hover, #f3f4f6); }
  .track-number { width: 40px; font-size: 0.85rem; }
  .track-info { flex: 1; display: flex; justify-content: space-between; align-items: center; }
  .track-title { font-size: 0.95rem; }
  .track-duration { font-size: 0.8rem; }
  .download-btn {
    padding: 0.25rem 0.75rem; 
    font-size: 0.8rem;
    color: #fff; 
    border-radius: 6px;
    text-decoration: none; 
    margin-left: 1rem; 
    white-space: nowrap;
    transition: all 0.3s;
  }
  .download-btn:hover { opacity: 0.8; }
  
  @media (max-width: 640px) {
    .album-header { flex-direction: column; align-items: center; text-align: center; }
    .album-cover { width: 160px; height: 160px; }
    .track-item { flex-wrap: wrap; gap: 0.5rem; }
    .track-info { flex: 1 1 100%; order: 2; }
    .download-btn { margin-left: 0; order: 3; width: 100%; text-align: center; }
  }
</style>

<script>
  function applyThemeColors() {
    // 获取根元素的实际计算样式
    const root = document.documentElement;
    const styles = getComputedStyle(root);
    
    // 读取主题实际颜色 - 用你主题的真实变量名
    const bgColor = styles.getPropertyValue('--bg-primary').trim() || 
                   styles.getPropertyValue('--color-bg').trim() || 
                   styles.getPropertyValue('--background').trim() || 
                   '#ffffff';
    
    const textColor = styles.getPropertyValue('--text-primary').trim() || 
                     styles.getPropertyValue('--color-text').trim() || 
                     styles.getPropertyValue('--foreground').trim() || 
                     '#000000';
    
    const textSecondary = styles.getPropertyValue('--text-secondary').trim() || 
                         styles.getPropertyValue('--color-text-secondary').trim() || 
                         '#6b7280';
    
    const borderColor = styles.getPropertyValue('--border-color').trim() || 
                       styles.getPropertyValue('--color-border').trim() || 
                       '#e5e7eb';
    
    const primaryColor = styles.getPropertyValue('--primary').trim() || 
                        styles.getPropertyValue('--color-primary').trim() || 
                        '#3b82f6';
    
    const bgHover = styles.getPropertyValue('--bg-hover').trim() || 
                   styles.getPropertyValue('--color-bg-hover').trim() || 
                   '#f3f4f6';
    
    // 直接设置所有元素
    const detail = document.getElementById('album-detail');
    if (!detail) return;
    
    // 设置背景
    const header = document.getElementById('album-header');
    if (header) {
      header.style.backgroundColor = bgColor;
      header.style.borderColor = borderColor;
    }
    
    const trackList = document.getElementById('track-list');
    if (trackList) {
      trackList.style.backgroundColor = bgColor;
      trackList.style.borderColor = borderColor;
    }
    
    // 设置文字颜色
    const titleText = document.getElementById('title-text');
    if (titleText) titleText.style.color = textColor;
    
    const typeText = document.getElementById('type-text');
    if (typeText) typeText.style.color = textSecondary;
    
    const detailsText = document.getElementById('details-text');
    if (detailsText) detailsText.style.color = textSecondary;
    
    const trackCount = document.getElementById('track-count');
    if (trackCount) {
      trackCount.style.color = textSecondary;
      trackCount.style.backgroundColor = bgHover;
    }
    
    const artistLink = document.getElementById('artist-link');
    if (artistLink) artistLink.style.color = primaryColor;
    
    // 设置每个 track 的颜色
    document.querySelectorAll('.track-item').forEach((item, index) => {
      const number = item.querySelector('.track-number');
      const title = item.querySelector('.track-title');
      const duration = item.querySelector('.track-duration');
      const btn = item.querySelector('.download-btn');
      
      if (number) number.style.color = textSecondary;
      if (title) title.style.color = textColor;
      if (duration) duration.style.color = textSecondary;
      if (btn) btn.style.backgroundColor = primaryColor;
      
      item.style.borderColor = borderColor;
      item.style.backgroundColor = bgColor;
    });
  }
  
  // 初始执行
  setTimeout(applyThemeColors, 200);
  
  // 监听主题变化
  const observer = new MutationObserver(() => {
    setTimeout(applyThemeColors, 100);
  });
  observer.observe(document.documentElement, { 
    attributes: true, 
    attributeFilter: ['class', 'style', 'data-theme'] 
  });
  
  // 监听主题色滑块变化
  document.addEventListener('themeChanged', () => {
    setTimeout(applyThemeColors, 100);
  });
  document.addEventListener('colorSchemeChange', () => {
    setTimeout(applyThemeColors, 100);
  });
  
  // 监听 localStorage 变化
  window.addEventListener('storage', (e) => {
    if (e.key === 'theme' || e.key === 'themeColor') {
      setTimeout(applyThemeColors, 100);
    }
  });
</script>