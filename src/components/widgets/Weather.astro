---
// 天气组件 - Open-Meteo API
// 去掉地理编码API，直接用ip-api获取城市名，硬编码坐标
---

<div id="weather-widget" class="weather-card">
  <div id="weather-loading" style="text-align:center;padding:20px 0;color:var(--text-secondary);font-size:13px;">
    <div style="font-size:28px;margin-bottom:8px;">⏳</div>
    获取天气中...
  </div>

  <div id="weather-content" style="display:none;">
    <!-- 搜索栏 -->
    <div style="display:flex;gap:6px;margin-bottom:10px;">
      <input id="w-search" type="text" placeholder="输入城市名..." 
        style="flex:1;padding:6px 10px;border:1px solid var(--line-divider);border-radius:8px;font-size:13px;background:var(--input-bg);color:var(--text);outline:none;">
      <button id="w-search-btn" 
        style="padding:6px 14px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:13px;cursor:pointer;">搜索</button>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0 10px;border-bottom:1px solid var(--line-divider);">
      <div>
        <div id="w-city" style="font-size:18px;font-weight:700;color:var(--text);">--</div>
        <div id="w-cond" style="font-size:14px;color:var(--text-secondary);margin-top:2px;">--</div>
      </div>
      <div style="text-align:right;">
        <div id="w-temp" style="font-size:28px;font-weight:700;color:var(--text);">--°C</div>
        <div style="font-size:12px;color:var(--text-secondary);">
          💧<span id="w-humidity">--</span>%　💨<span id="w-wind">--</span>km/h
        </div>
      </div>
    </div>

    <div id="w-forecast" style="display:flex;gap:6px;padding:10px 0 4px;"></div>

    <div style="text-align:center;padding-top:2px;">
      <button id="w-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 详情</button>
    </div>

    <div id="w-details" style="display:none;padding-top:8px;border-top:1px solid var(--line-divider);font-size:12px;color:var(--text-secondary);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 12px;">
        <div>🌡️ 体感: <span id="w-feels">--</span>°C</div>
        <div>☁️ 云量: <span id="w-cloud">--</span>%</div>
        <div>🌅 日出: <span id="w-sunrise">--</span></div>
        <div>🌇 日落: <span id="w-sunset">--</span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
  }
  [data-theme="dark"] .weather-card,
  [data-theme="dark"] .weather-card * { color: #ffffff !important; }
  [data-theme="dark"] #w-city,
  [data-theme="dark"] #w-temp { color: #ffffff !important; }
  [data-theme="dark"] #w-search {
    background: rgba(255,255,255,0.1);
    color: #fff !important;
    border-color: rgba(255,255,255,0.2);
  }
  [data-theme="dark"] #w-search::placeholder { color: rgba(255,255,255,0.5); }
  .forecast-item {
    flex: 1;
    text-align: center;
    padding: 4px 0;
    border-radius: 8px;
    background: var(--hover-bg, rgba(0,0,0,0.03));
  }
  [data-theme="dark"] .forecast-item { background: rgba(255,255,255,0.08); }
  .forecast-item .day { font-size: 11px; color: var(--text-secondary); }
  .forecast-item .icon { font-size: 20px; }
  .forecast-item .temp { font-size: 13px; font-weight: 600; color: var(--text); }
  #w-details.show { display: block !important; }
</style>

<script>
  (function() {
    console.log('🌤️ 天气组件启动');

    const loading = document.getElementById('weather-loading');
    const content = document.getElementById('weather-content');

    const wCity = document.getElementById('w-city');
    const wCond = document.getElementById('w-cond');
    const wTemp = document.getElementById('w-temp');
    const wHumidity = document.getElementById('w-humidity');
    const wWind = document.getElementById('w-wind');
    const wFeels = document.getElementById('w-feels');
    const wCloud = document.getElementById('w-cloud');
    const wSunrise = document.getElementById('w-sunrise');
    const wSunset = document.getElementById('w-sunset');
    const forecastEl = document.getElementById('w-forecast');
    const toggleBtn = document.getElementById('w-toggle');
    const detailsEl = document.getElementById('w-details');
    const searchInput = document.getElementById('w-search');
    const searchBtn = document.getElementById('w-search-btn');

    let detailsVisible = false;
    let currentCity = '上海';

    // ===== 天气图标 =====
    const emojiMap = {
      0: '☀️', 1: '⛅', 2: '⛅', 3: '☁️',
      45: '🌫️', 48: '🌫️',
      51: '🌧️', 53: '🌧️', 55: '🌧️',
      56: '🌧️', 57: '🌧️',
      61: '🌧️', 63: '🌧️', 65: '🌧️',
      66: '🌧️', 67: '🌧️',
      71: '❄️', 73: '❄️', 75: '❄️', 77: '❄️',
      80: '🌧️', 81: '🌧️', 82: '🌧️',
      85: '❄️', 86: '❄️',
      95: '⛈️', 96: '⛈️', 99: '⛈️'
    };
    const descMap = {
      0: '晴', 1: '晴间多云', 2: '多云', 3: '阴',
      45: '雾', 48: '雾',
      51: '小雨', 53: '小雨', 55: '中雨',
      56: '冻雨', 57: '冻雨',
      61: '中雨', 63: '大雨', 65: '暴雨',
      66: '冻雨', 67: '冻雨',
      71: '小雪', 73: '中雪', 75: '大雪', 77: '雪粒',
      80: '阵雨', 81: '阵雨', 82: '强阵雨',
      85: '阵雪', 86: '强阵雪',
      95: '雷暴', 96: '雷暴', 99: '强雷暴'
    };

    // ===== 显示天气 =====
    function displayWeather(data, city) {
      console.log('显示天气:', data);
      if (!data || !data.current_weather) {
        console.error('数据异常');
        return false;
      }

      const cur = data.current_weather;
      const code = cur.weathercode || 0;
      const temp = Math.round(cur.temperature);
      const wind = Math.round(cur.windspeed || 0);

      let humidity = '--';
      if (data.hourly && data.hourly.relativehumidity_2m && data.hourly.relativehumidity_2m.length > 0) {
        humidity = data.hourly.relativehumidity_2m[0] || '--';
      }
      let feels = '--';
      if (data.hourly && data.hourly.apparent_temperature && data.hourly.apparent_temperature.length > 0) {
        feels = Math.round(data.hourly.apparent_temperature[0]);
      }
      let cloud = '--';
      if (data.hourly && data.hourly.cloudcover && data.hourly.cloudcover.length > 0) {
        cloud = data.hourly.cloudcover[0] || '--';
      }

      wCity.textContent = city;
      wTemp.textContent = `${temp}°C`;
      wCond.textContent = `${emojiMap[code] || '🌤️'} ${descMap[code] || '--'}`;
      wHumidity.textContent = humidity;
      wWind.textContent = wind;
      wFeels.textContent = feels;
      wCloud.textContent = cloud;

      if (data.daily && data.daily.sunrise && data.daily.sunrise.length > 0) {
        const d = new Date(data.daily.sunrise[0]);
        wSunrise.textContent = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      }
      if (data.daily && data.daily.sunset && data.daily.sunset.length > 0) {
        const d = new Date(data.daily.sunset[0]);
        wSunset.textContent = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      }

      if (data.daily) {
        const days = ['周日','周一','周二','周三','周四','周五','周六'];
        const today = new Date().getDay();
        let html = '';
        for (let i = 0; i < Math.min(data.daily.time.length, 3); i++) {
          const max = Math.round(data.daily.temperature_2m_max[i] || 0);
          const min = Math.round(data.daily.temperature_2m_min[i] || 0);
          const c = data.daily.weathercode[i] || 0;
          const dayName = i === 0 ? '今天' : days[(today + i) % 7];
          html += `<div class="forecast-item">
            <div class="day">${dayName}</div>
            <div class="icon">${emojiMap[c] || '🌤️'}</div>
            <div class="temp">${max}°/${min}°</div>
          </div>`;
        }
        forecastEl.innerHTML = html;
      }

      loading.style.display = 'none';
      content.style.display = 'block';
      return true;
    }

    // ===== 获取天气 =====
    async function fetchWeather(lat, lon, city) {
      console.log('🌤️ 获取天气:', city, lat, lon);
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 获取中...';

      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=weathercode,temperature_2m_max,temperature_2m_min,sunrise,sunset&hourly=relativehumidity_2m,windspeed_10m,apparent_temperature,cloudcover&timezone=auto`;
        console.log('请求URL:', url);
        const res = await fetch(url, { signal: AbortSignal.timeout(10000) });
        const data = await res.json();
        console.log('返回数据:', data);

        const ok = displayWeather(data, city);
        if (ok) {
          currentCity = city;
          console.log('✅ 天气加载成功');
        } else {
          throw new Error('显示失败');
        }
      } catch (err) {
        console.error('❌ 天气获取失败:', err);
        loading.innerHTML = '🌧️ 加载失败<br><span style="font-size:12px;color:#999;">点击重试</span>';
        loading.style.cursor = 'pointer';
        loading.onclick = function() { fetchWeather(lat, lon, city); };
      }
    }

    // ===== 定位 =====
    async function locate() {
      loading.style.display = 'block';
      loading.innerHTML = '⏳ 定位中...';

      try {
        const res = await fetch('https://ip-api.com/json/?fields=city,lat,lon', { signal: AbortSignal.timeout(5000) });
        const data = await res.json();
        if (data.city && data.lat && data.lon) {
          const city = data.city;
          const lat = data.lat;
          const lon = data.lon;
          document.getElementById('w-search').value = city;
          await fetchWeather(lat, lon, city);
          return;
        }
      } catch (e) {
        console.log('定位失败:', e);
      }

      // 默认上海
      await fetchWeather(31.23, 121.47, '上海');
    }

    // ===== 搜索 =====
    async function searchCity(query) {
      if (!query.trim()) return;
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 搜索中...';

      try {
        const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=1&language=zh`);
        const data = await res.json();
        if (data.results && data.results.length > 0) {
          const r = data.results[0];
          const city = r.name + (r.admin1 ? `, ${r.admin1}` : '');
          await fetchWeather(r.latitude, r.longitude, city);
        } else {
          loading.innerHTML = '❌ 未找到该城市';
        }
      } catch (err) {
        loading.innerHTML = '❌ 搜索失败';
      }
    }

    // ===== 事件绑定 =====
    searchBtn.addEventListener('click', function() {
      const val = searchInput.value.trim();
      if (val) searchCity(val);
    });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const val = searchInput.value.trim();
        if (val) searchCity(val);
      }
    });

    toggleBtn.addEventListener('click', function() {
      detailsVisible = !detailsVisible;
      detailsEl.classList.toggle('show', detailsVisible);
      toggleBtn.textContent = detailsVisible ? '📊 收起' : '📊 详情';
    });

    locate();
    console.log('🌤️ 天气组件已加载');
  })();
</script>