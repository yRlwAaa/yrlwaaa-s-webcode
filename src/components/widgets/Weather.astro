---
// 天气组件 - iframe 嵌入版（保留搜索和定位功能）
// 使用中国天气网，稳定可用
---

<div class="weather-card">
  <!-- 城市搜索 -->
  <div style="display:flex;gap:6px;padding:8px 12px 4px 12px;">
    <input id="w-city-input" type="text" placeholder="输入城市名..." 
      style="flex:1;padding:4px 10px;border:1px solid var(--line-divider);border-radius:6px;font-size:12px;background:var(--input-bg);color:var(--text);outline:none;">
    <button id="w-city-btn" 
      style="padding:4px 12px;background:var(--primary);color:#fff;border:none;border-radius:6px;font-size:12px;cursor:pointer;">定位</button>
  </div>

  <!-- iframe 天气 -->
  <iframe id="w-iframe" 
    src="https://www.weather.com.cn/weather1d/101210101.shtml" 
    style="width:100%;height:280px;border:none;border-radius:0 0 12px 12px;"
    loading="lazy"
  ></iframe>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
    overflow: hidden;
  }
  [data-theme="dark"] .weather-card {
    background: var(--card-bg-dark);
    border-color: var(--line-divider-dark);
  }
  [data-theme="dark"] #w-city-input {
    background: rgba(255,255,255,0.1);
    color: #fff !important;
    border-color: rgba(255,255,255,0.2);
  }
  [data-theme="dark"] #w-city-input::placeholder {
    color: rgba(255,255,255,0.5);
  }
</style>

<script>
  (function() {
    const input = document.getElementById('w-city-input');
    const btn = document.getElementById('w-city-btn');
    const iframe = document.getElementById('w-iframe');

    // 城市代码映射（中国天气网）
    const cityCodes = {
      '北京': '101010100',
      '上海': '101210101',
      '广州': '101280101',
      '深圳': '101280601',
      '杭州': '101210101',
      '成都': '101270101',
      '武汉': '101200101',
      '南京': '101190101',
      '重庆': '101040100',
      '西安': '101110101',
      '天津': '101030100',
      '苏州': '101190401',
      '长沙': '101250101',
      '郑州': '101180101',
      '东莞': '101281601',
      '佛山': '101280800',
      '宁波': '101210401',
      '青岛': '101120201',
      '沈阳': '101070101',
      '大连': '101070201',
      '厦门': '101230201',
      '福州': '101230101',
      '昆明': '101290101',
      '贵阳': '101260101',
      '南宁': '101300101',
      '海口': '101310101',
      '兰州': '101160101',
      '西宁': '101150101',
      '银川': '101170101',
      '乌鲁木齐': '101130101',
      '拉萨': '101140101',
      '哈尔滨': '101050101',
      '长春': '101060101',
      '呼和浩特': '101080101',
      '太原': '101100101',
      '石家庄': '101090101',
      '济南': '101120101',
      '合肥': '101220101',
      '南昌': '101240101'
    };

    function getCityCode(city) {
      for (let key in cityCodes) {
        if (city.includes(key) || key.includes(city)) {
          return cityCodes[key];
        }
      }
      return null;
    }

    function updateWeather(city) {
      const code = getCityCode(city);
      if (code) {
        iframe.src = `https://www.weather.com.cn/weather1d/${code}.shtml`;
      } else {
        // 未找到城市，用搜索链接
        iframe.src = `https://www.weather.com.cn/search?q=${encodeURIComponent(city)}`;
      }
    }

    // 定位
    async function locate() {
      try {
        const res = await fetch('https://ip-api.com/json/?fields=city', { signal: AbortSignal.timeout(5000) });
        const data = await res.json();
        if (data.city) {
          input.value = data.city;
          updateWeather(data.city);
          return;
        }
      } catch (e) {}
      // 默认上海
      updateWeather('上海');
    }

    btn.addEventListener('click', function() {
      const val = input.value.trim();
      if (val) updateWeather(val);
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const val = input.value.trim();
        if (val) updateWeather(val);
      }
    });

    locate();
    console.log('🌤️ 天气组件已加载');
  })();
</script>