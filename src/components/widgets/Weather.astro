---
// 天气组件 - 使用 Open-Meteo API（无需 API Key，全球可用）
// 显示用户 IP 所在位置的天气
---

<div id="weather-widget" class="weather-card">
  <div id="weather-loading" style="text-align:center;padding:12px 0;color:var(--text-secondary);font-size:13px;">
    ⏳ 获取天气中...
  </div>
  <div id="weather-content" style="display:none;">
    <div id="weather-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span id="weather-city" style="font-weight:600;font-size:15px;color:var(--text);">--</span>
      <span id="weather-temp" style="font-size:20px;font-weight:700;color:var(--text);">--°C</span>
    </div>
    <div id="weather-desc" style="display:flex;align-items:center;gap:8px;">
      <span id="weather-icon" style="font-size:28px;">☀️</span>
      <span id="weather-condition" style="font-size:13px;color:var(--text-secondary);">--</span>
    </div>
    <div id="weather-details" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid var(--line-divider);font-size:12px;color:var(--text-secondary);">
      <div>💧 湿度: <span id="weather-humidity">--</span>%</div>
      <div>💨 风速: <span id="weather-wind">--</span> km/h</div>
      <div>🌅 日出: <span id="weather-sunrise">--</span> / 日落: <span id="weather-sunset">--</span></div>
    </div>
    <div style="text-align:center;margin-top:8px;">
      <button id="weather-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 查看更多</button>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
    transition: all 0.2s;
  }
  .weather-card:hover {
    border-color: var(--primary);
  }
  [data-theme="dark"] .weather-card {
    background: var(--card-bg-dark);
    border-color: var(--line-divider-dark);
  }
  #weather-details {
    transition: all 0.3s ease;
  }
  #weather-details.show {
    display: block !important;
  }
</style>

<script>
  (function() {
    const loading = document.getElementById('weather-loading');
    const content = document.getElementById('weather-content');
    const cityEl = document.getElementById('weather-city');
    const tempEl = document.getElementById('weather-temp');
    const iconEl = document.getElementById('weather-icon');
    const conditionEl = document.getElementById('weather-condition');
    const humidityEl = document.getElementById('weather-humidity');
    const windEl = document.getElementById('weather-wind');
    const sunriseEl = document.getElementById('weather-sunrise');
    const sunsetEl = document.getElementById('weather-sunset');
    const detailsEl = document.getElementById('weather-details');
    const toggleBtn = document.getElementById('weather-toggle');

    let detailsVisible = false;

    // 天气状况映射
    function getWeatherEmoji(code) {
      if (code === 0) return '☀️';
      if (code === 1 || code === 2 || code === 3) return '⛅';
      if (code === 45 || code === 48) return '🌫️';
      if (code === 51 || code === 53 || code === 55) return '🌧️';
      if (code === 56 || code === 57 || code === 61 || code === 63 || code === 65 || code === 66 || code === 67 || code === 80 || code === 81 || code === 82) return '🌧️';
      if (code === 71 || code === 73 || code === 75 || code === 77 || code === 85 || code === 86) return '❄️';
      if (code === 95 || code === 96 || code === 99) return '⛈️';
      return '🌤️';
    }

    function getWeatherDesc(code) {
      if (code === 0) return '晴天';
      if (code === 1 || code === 2 || code === 3) return '多云';
      if (code === 45 || code === 48) return '雾天';
      if (code === 51 || code === 53 || code === 55) return '小雨';
      if (code === 56 || code === 57) return '冻雨';
      if (code === 61 || code === 63 || code === 65) return '大雨';
      if (code === 66 || code === 67) return '冻雨';
      if (code === 71 || code === 73 || code === 75 || code === 77) return '降雪';
      if (code === 80 || code === 81 || code === 82) return '阵雨';
      if (code === 85 || code === 86) return '阵雪';
      if (code === 95 || code === 96 || code === 99) return '雷暴';
      return '--';
    }

    async function getWeather() {
      try {
        // 1. 获取用户位置（通过IP）
        const locationRes = await fetch('https://ipapi.co/json/');
        const locationData = await locationRes.json();
        const city = locationData.city || locationData.region || '未知城市';
        const lat = locationData.latitude;
        const lon = locationData.longitude;

        if (!lat || !lon) {
          throw new Error('无法获取位置信息');
        }

        cityEl.textContent = city;

        // 2. 获取天气数据（Open-Meteo）
        const weatherRes = await fetch(
          `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&hourly=temperature_2m,relativehumidity_2m,windspeed_10m&timezone=auto`
        );
        const weatherData = await weatherRes.json();

        if (weatherData && weatherData.current_weather) {
          const current = weatherData.current_weather;
          const temp = current.temperature || '--';
          const weatherCode = current.weathercode || 0;
          const windSpeed = current.windspeed || '--';

          // 获取湿度（从hourly数据中取最近时间）
          let humidity = '--';
          if (weatherData.hourly && weatherData.hourly.relativehumidity_2m && weatherData.hourly.time) {
            const now = new Date();
            const currentHour = now.getHours();
            // 找最近的时间点
            for (let i = 0; i < weatherData.hourly.time.length; i++) {
              const time = new Date(weatherData.hourly.time[i]);
              if (time.getHours() >= currentHour) {
                humidity = weatherData.hourly.relativehumidity_2m[i] || '--';
                break;
              }
            }
          }

          const emoji = getWeatherEmoji(weatherCode);
          const desc = getWeatherDesc(weatherCode);

          tempEl.textContent = `${temp}°C`;
          iconEl.textContent = emoji;
          conditionEl.textContent = desc;
          humidityEl.textContent = humidity;
          windEl.textContent = windSpeed;

          // 日出日落（简化处理，不显示具体时间）
          sunriseEl.textContent = '--';
          sunsetEl.textContent = '--';

          loading.style.display = 'none';
          content.style.display = 'block';

          toggleBtn.addEventListener('click', function() {
            detailsVisible = !detailsVisible;
            if (detailsVisible) {
              detailsEl.classList.add('show');
              toggleBtn.textContent = '📊 收起';
            } else {
              detailsEl.classList.remove('show');
              toggleBtn.textContent = '📊 查看更多';
            }
          });
        } else {
          throw new Error('无法获取天气数据');
        }
      } catch (error) {
        console.error('天气加载失败:', error);
        loading.innerHTML = '🌧️ 无法获取天气<br><span style="font-size:12px;color:#999;">点击刷新</span>';
        loading.style.cursor = 'pointer';
        loading.onclick = function() {
          loading.innerHTML = '⏳ 重试中...';
          getWeather();
        };
      }
    }

    getWeather();
  })();
</script>