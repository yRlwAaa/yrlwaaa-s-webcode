---
// 天气组件 - 完整版（带超时和深色模式适配）
// 功能：自动定位、未来7天预报、城市搜索
---

<div id="weather-widget" class="weather-card">
  <!-- 加载状态 -->
  <div id="weather-loading" style="text-align:center;padding:20px 0;color:var(--text-secondary);font-size:13px;">
    <div style="font-size:28px;margin-bottom:8px;">⏳</div>
    获取天气中...
  </div>

  <!-- 天气内容 -->
  <div id="weather-content" style="display:none;">
    <!-- 城市搜索栏 -->
    <div style="display:flex;gap:6px;margin-bottom:10px;">
      <input id="weather-search" type="text" placeholder="搜索城市..." 
        style="flex:1;padding:6px 10px;border:1px solid var(--line-divider);border-radius:8px;font-size:13px;background:var(--input-bg);color:var(--text);outline:none;">
      <button id="weather-search-btn" 
        style="padding:6px 14px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:13px;cursor:pointer;">搜索</button>
    </div>

    <!-- 当前天气 -->
    <div id="weather-current" style="display:flex;align-items:center;justify-content:space-between;padding:8px 0 12px;border-bottom:1px solid var(--line-divider);">
      <div>
        <div id="weather-city-name" style="font-size:18px;font-weight:700;color:var(--text);">--</div>
        <div id="weather-date" style="font-size:12px;color:var(--text-secondary);">--</div>
        <div id="weather-condition-text" style="font-size:14px;color:var(--text-secondary);margin-top:2px;">--</div>
      </div>
      <div style="text-align:right;">
        <div id="weather-temp-big" style="font-size:32px;font-weight:700;color:var(--text);">--°C</div>
        <div style="font-size:12px;color:var(--text-secondary);">
          <span>💧 <span id="weather-humidity-val">--</span>%</span>
          <span style="margin-left:12px;">💨 <span id="weather-wind-val">--</span>km/h</span>
        </div>
      </div>
    </div>

    <!-- 未来7天预报 -->
    <div id="weather-forecast" style="display:flex;gap:6px;padding:12px 0 8px;overflow-x:auto;scrollbar-width:thin;">
      <!-- JS 动态渲染 -->
    </div>

    <!-- 查看更多详情按钮 -->
    <div style="text-align:center;padding-top:6px;">
      <button id="weather-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 查看更多</button>
    </div>

    <!-- 扩展详情 -->
    <div id="weather-extended" style="display:none;padding-top:10px;border-top:1px solid var(--line-divider);font-size:13px;color:var(--text-secondary);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;">
        <div>🌡️ 体感温度: <span id="weather-feelslike">--</span>°C</div>
        <div>☁️ 云量: <span id="weather-cloudcover">--</span>%</div>
        <div>🌅 日出: <span id="weather-sunrise">--</span></div>
        <div>🌇 日落: <span id="weather-sunset">--</span></div>
        <div>🌬️ 阵风: <span id="weather-gust">--</span>km/h</div>
        <div>👁️ 能见度: <span id="weather-visibility">--</span>km</div>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
    transition: all 0.2s;
  }
  .weather-card:hover {
    border-color: var(--primary);
  }
  
  /* 深色模式强制白色文字 */
  [data-theme="dark"] .weather-card,
  html.dark .weather-card,
  .dark .weather-card {
    color: #ffffff !important;
  }
  [data-theme="dark"] .weather-card *,
  html.dark .weather-card *,
  .dark .weather-card * {
    color: #ffffff !important;
  }
  [data-theme="dark"] #weather-city-name,
  html.dark #weather-city-name,
  .dark #weather-city-name {
    color: #ffffff !important;
  }
  [data-theme="dark"] #weather-temp-big,
  html.dark #weather-temp-big,
  .dark #weather-temp-big {
    color: #ffffff !important;
  }
  [data-theme="dark"] .forecast-day .day-temp,
  html.dark .forecast-day .day-temp,
  .dark .forecast-day .day-temp {
    color: #ffffff !important;
  }
  [data-theme="dark"] .forecast-day,
  html.dark .forecast-day,
  .dark .forecast-day {
    background: rgba(255,255,255,0.08);
    color: #ffffff !important;
  }
  [data-theme="dark"] #weather-search,
  html.dark #weather-search,
  .dark #weather-search {
    background: rgba(255,255,255,0.1);
    color: #ffffff !important;
    border-color: rgba(255,255,255,0.2);
  }
  [data-theme="dark"] #weather-search::placeholder,
  html.dark #weather-search::placeholder,
  .dark #weather-search::placeholder {
    color: rgba(255,255,255,0.5);
  }

  #weather-forecast::-webkit-scrollbar {
    height: 3px;
  }
  #weather-forecast::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 10px;
  }
  .forecast-day {
    flex: 0 0 52px;
    text-align: center;
    font-size: 12px;
    padding: 4px 0;
    border-radius: 8px;
    background: var(--hover-bg, rgba(0,0,0,0.03));
    color: var(--text-secondary);
  }
  .forecast-day .day-temp {
    font-weight: 600;
    color: var(--text);
  }
  #weather-extended {
    transition: all 0.3s ease;
  }
  #weather-extended.show {
    display: block !important;
  }
  /* 深色模式扩展详情文字 */
  [data-theme="dark"] #weather-extended,
  html.dark #weather-extended,
  .dark #weather-extended {
    color: #cccccc !important;
  }
  [data-theme="dark"] #weather-extended span,
  html.dark #weather-extended span,
  .dark #weather-extended span {
    color: #ffffff !important;
  }
</style>

<script>
  (function() {
    const loading = document.getElementById('weather-loading');
    const content = document.getElementById('weather-content');

    const cityName = document.getElementById('weather-city-name');
    const dateEl = document.getElementById('weather-date');
    const conditionText = document.getElementById('weather-condition-text');
    const tempBig = document.getElementById('weather-temp-big');
    const humidityVal = document.getElementById('weather-humidity-val');
    const windVal = document.getElementById('weather-wind-val');
    const feelslike = document.getElementById('weather-feelslike');
    const cloudcover = document.getElementById('weather-cloudcover');
    const sunrise = document.getElementById('weather-sunrise');
    const sunset = document.getElementById('weather-sunset');
    const gust = document.getElementById('weather-gust');
    const visibility = document.getElementById('weather-visibility');
    const forecastContainer = document.getElementById('weather-forecast');
    const toggleBtn = document.getElementById('weather-toggle');
    const extended = document.getElementById('weather-extended');
    const searchInput = document.getElementById('weather-search');
    const searchBtn = document.getElementById('weather-search-btn');

    let detailsVisible = false;
    let currentCity = '';
    let currentLat = 0;
    let currentLon = 0;
    let retryCount = 0;

    // ===== 天气图标映射 =====
    function getWeatherEmoji(code) {
      const map = {
        0: '☀️', 1: '⛅', 2: '⛅', 3: '☁️',
        45: '🌫️', 48: '🌫️',
        51: '🌧️', 53: '🌧️', 55: '🌧️',
        56: '🌧️', 57: '🌧️',
        61: '🌧️', 63: '🌧️', 65: '🌧️',
        66: '🌧️', 67: '🌧️',
        71: '❄️', 73: '❄️', 75: '❄️', 77: '❄️',
        80: '🌧️', 81: '🌧️', 82: '🌧️',
        85: '❄️', 86: '❄️',
        95: '⛈️', 96: '⛈️', 99: '⛈️'
      };
      return map[code] || '🌤️';
    }

    function getWeatherDesc(code) {
      const map = {
        0: '晴天', 1: '晴间多云', 2: '多云', 3: '阴天',
        45: '雾天', 48: '雾天',
        51: '小雨', 53: '小雨', 55: '中雨',
        56: '冻雨', 57: '冻雨',
        61: '中雨', 63: '大雨', 65: '暴雨',
        66: '冻雨', 67: '冻雨',
        71: '小雪', 73: '中雪', 75: '大雪', 77: '雪粒',
        80: '阵雨', 81: '阵雨', 82: '强阵雨',
        85: '阵雪', 86: '强阵雪',
        95: '雷暴', 96: '雷暴', 99: '强雷暴'
      };
      return map[code] || '--';
    }

    // ===== 获取天气数据 =====
    async function fetchWeather(lat, lon, city) {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=weathercode,temperature_2m_max,temperature_2m_min,sunrise,sunset&hourly=temperature_2m,relativehumidity_2m,windspeed_10m,cloudcover,apparent_temperature,gusts_10m,visibility&timezone=auto&forecast_days=7`;
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);
        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(timeoutId);
        const data = await res.json();

        if (!data || !data.current_weather) {
          throw new Error('数据异常');
        }

        // 当前天气
        const current = data.current_weather;
        const weatherCode = current.weathercode || 0;
        const temp = Math.round(current.temperature);
        const wind = Math.round(current.windspeed || 0);

        let humidity = '--';
        if (data.hourly && data.hourly.relativehumidity_2m && data.hourly.relativehumidity_2m.length > 0) {
          humidity = data.hourly.relativehumidity_2m[0] || '--';
        }

        let feels = '--';
        if (data.hourly && data.hourly.apparent_temperature && data.hourly.apparent_temperature.length > 0) {
          feels = Math.round(data.hourly.apparent_temperature[0]);
        }

        let cloud = '--';
        if (data.hourly && data.hourly.cloudcover && data.hourly.cloudcover.length > 0) {
          cloud = data.hourly.cloudcover[0] || '--';
        }

        let gustVal = '--';
        if (data.hourly && data.hourly.gusts_10m && data.hourly.gusts_10m.length > 0) {
          gustVal = Math.round(data.hourly.gusts_10m[0] || 0);
        }

        let vis = '--';
        if (data.hourly && data.hourly.visibility && data.hourly.visibility.length > 0) {
          vis = Math.round((data.hourly.visibility[0] || 0) / 1000);
        }

        let sunriseStr = '--', sunsetStr = '--';
        if (data.daily && data.daily.sunrise && data.daily.sunrise.length > 0) {
          const d = new Date(data.daily.sunrise[0]);
          sunriseStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
        }
        if (data.daily && data.daily.sunset && data.daily.sunset.length > 0) {
          const d = new Date(data.daily.sunset[0]);
          sunsetStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
        }

        cityName.textContent = city;
        dateEl.textContent = new Date().toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' });
        conditionText.textContent = getWeatherDesc(weatherCode);
        tempBig.textContent = `${temp}°C`;
        humidityVal.textContent = humidity;
        windVal.textContent = wind;
        feelslike.textContent = feels;
        cloudcover.textContent = cloud;
        sunrise.textContent = sunriseStr;
        sunset.textContent = sunsetStr;
        gust.textContent = gustVal;
        visibility.textContent = vis;

        renderForecast(data.daily);

        loading.style.display = 'none';
        content.style.display = 'block';
        retryCount = 0;

      } catch (err) {
        console.error('天气获取失败:', err);
        if (retryCount < 3) {
          retryCount++;
          loading.innerHTML = `⏳ 重试中 (${retryCount}/3)...`;
          setTimeout(() => {
            if (currentCity) {
              fetchWeather(currentLat, currentLon, currentCity);
            } else {
              getLocationAndWeather();
            }
          }, 2000);
        } else {
          loading.innerHTML = `🌧️ 获取失败<br><span style="font-size:12px;color:#999;">点击重试</span>`;
          loading.style.cursor = 'pointer';
          loading.onclick = function() {
            retryCount = 0;
            loading.innerHTML = '⏳ 重试中...';
            if (currentCity) {
              fetchWeather(currentLat, currentLon, currentCity);
            } else {
              getLocationAndWeather();
            }
          };
        }
      }
    }

    // ===== 渲染预报 =====
    function renderForecast(daily) {
      if (!daily || !daily.time) return;
      const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
      const today = new Date().getDay();

      let html = '';
      for (let i = 0; i < Math.min(daily.time.length, 7); i++) {
        const d = new Date(daily.time[i]);
        const dayName = i === 0 ? '今天' : days[(today + i) % 7];
        const max = Math.round(daily.temperature_2m_max[i] || 0);
        const min = Math.round(daily.temperature_2m_min[i] || 0);
        const code = daily.weathercode[i] || 0;
        html += `
          <div class="forecast-day">
            <div>${dayName}</div>
            <div style="font-size:18px;">${getWeatherEmoji(code)}</div>
            <div class="day-temp">${max}°</div>
            <div style="font-size:10px;color:var(--text-secondary);">${min}°</div>
          </div>
        `;
      }
      forecastContainer.innerHTML = html;
    }

    // ===== 搜索城市 =====
    async function searchCity(query) {
      if (!query.trim()) return;
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 搜索中...';

      try {
        const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=3&language=zh`);
        const geoData = await geoRes.json();
        if (!geoData.results || geoData.results.length === 0) {
          loading.innerHTML = '❌ 未找到该城市<br><span style="font-size:12px;color:#999;">请重新输入</span>';
          loading.style.cursor = 'pointer';
          loading.onclick = function() { loading.innerHTML = '⏳ 重试中...'; getLocationAndWeather(); };
          return;
        }
        const result = geoData.results[0];
        currentCity = result.name + (result.admin1 ? `, ${result.admin1}` : '');
        currentLat = result.latitude;
        currentLon = result.longitude;
        retryCount = 0;
        await fetchWeather(currentLat, currentLon, currentCity);
      } catch (err) {
        loading.innerHTML = '❌ 搜索失败<br><span style="font-size:12px;color:#999;">请重试</span>';
        loading.style.cursor = 'pointer';
        loading.onclick = function() { loading.innerHTML = '⏳ 重试中...'; getLocationAndWeather(); };
      }
    }

    // ===== 定位 =====
    async function getLocationAndWeather() {
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 定位中...';
      retryCount = 0;

      try {
        const locRes = await fetch('https://ip-api.com/json/?fields=city,region,country,lat,lon', { signal: AbortSignal.timeout(5000) });
        const locData = await locRes.json();
        const city = locData.city || '未知城市';
        const lat = locData.lat || 0;
        const lon = locData.lon || 0;

        if (lat === 0 || lon === 0) {
          const fallback = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(5000) });
          const fbData = await fallback.json();
          currentCity = fbData.city || fbData.region || '未知城市';
          currentLat = fbData.latitude || 0;
          currentLon = fbData.longitude || 0;
          if (currentLat === 0 || currentLon === 0) {
            throw new Error('无法获取位置');
          }
          await fetchWeather(currentLat, currentLon, currentCity);
          return;
        }

        currentCity = city + (locData.region ? `, ${locData.region}` : '');
        currentLat = lat;
        currentLon = lon;
        await fetchWeather(currentLat, currentLon, currentCity);

      } catch (err) {
        currentCity = '上海';
        currentLat = 31.23;
        currentLon = 121.47;
        await fetchWeather(currentLat, currentLon, currentCity);
      }
    }

    // ===== 事件绑定 =====
    toggleBtn.addEventListener('click', function() {
      detailsVisible = !detailsVisible;
      if (detailsVisible) {
        extended.classList.add('show');
        toggleBtn.textContent = '📊 收起';
      } else {
        extended.classList.remove('show');
        toggleBtn.textContent = '📊 查看更多';
      }
    });

    searchBtn.addEventListener('click', function() {
      searchCity(searchInput.value);
    });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') searchCity(searchInput.value);
    });

    // ===== 启动 =====
    getLocationAndWeather();
    window.refreshWeather = getLocationAndWeather;

    console.log('🌤️ 天气组件已加载');
  })();
</script>