---
// 天气组件 - 简化版
---

<div id="weather-widget" class="weather-card">
  <div id="weather-loading" style="text-align:center;padding:12px 0;color:var(--text-secondary);font-size:13px;">
    ⏳ 获取天气中...
  </div>
  <div id="weather-content" style="display:none;">
    <div id="weather-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span id="weather-city" style="font-weight:600;font-size:15px;color:var(--text);">--</span>
      <span id="weather-temp" style="font-size:20px;font-weight:700;color:var(--text);">--°C</span>
    </div>
    <div id="weather-desc" style="display:flex;align-items:center;gap:8px;">
      <span id="weather-icon" style="font-size:28px;">☀️</span>
      <span id="weather-condition" style="font-size:13px;color:var(--text-secondary);">--</span>
    </div>
    <div id="weather-details" style="display:none;margin-top:10px;padding-top:10px;border-top:1px solid var(--line-divider);font-size:12px;color:var(--text-secondary);">
      <div>💧 湿度: <span id="weather-humidity">--</span>%</div>
      <div>💨 风速: <span id="weather-wind">--</span> km/h</div>
    </div>
    <div style="text-align:center;margin-top:8px;">
      <button id="weather-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 查看更多</button>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
    transition: all 0.2s;
  }
  .weather-card:hover {
    border-color: var(--primary);
  }
  [data-theme="dark"] .weather-card {
    background: var(--card-bg-dark);
    border-color: var(--line-divider-dark);
  }
  #weather-details {
    transition: all 0.3s ease;
  }
  #weather-details.show {
    display: block !important;
  }
</style>

<script>
  (function() {
    const loading = document.getElementById('weather-loading');
    const content = document.getElementById('weather-content');
    const cityEl = document.getElementById('weather-city');
    const tempEl = document.getElementById('weather-temp');
    const iconEl = document.getElementById('weather-icon');
    const conditionEl = document.getElementById('weather-condition');
    const humidityEl = document.getElementById('weather-humidity');
    const windEl = document.getElementById('weather-wind');
    const detailsEl = document.getElementById('weather-details');
    const toggleBtn = document.getElementById('weather-toggle');

    let detailsVisible = false;

    async function getWeather() {
      try {
        // 1. 获取位置
        const locRes = await fetch('https://ip-api.com/json/?fields=city,region,country', {
          timeout: 5000
        });
        const locData = await locRes.json();
        const city = locData.city || '未知城市';

        // 2. 获取天气
        const weatherRes = await fetch(`https://wttr.in/${encodeURIComponent(city)}?format=j1&lang=zh`, {
          timeout: 8000
        });
        const data = await weatherRes.json();

        if (data && data.current_condition) {
          const cur = data.current_condition[0];
          const temp = cur.temp_C || '--';
          const desc = cur.weatherDesc[0]?.value || '--';
          const humidity = cur.humidity || '--';
          const wind = cur.windSpeedKmph || '--';
          const code = cur.weatherCode || '113';

          const iconMap = {
            '113': '☀️', '116': '⛅', '119': '☁️', '122': '☁️',
            '143': '🌫️', '176': '🌦️', '179': '🌨️', '182': '🌧️',
            '185': '🌧️', '200': '⛈️', '227': '❄️', '230': '❄️',
            '248': '🌫️', '260': '🌫️', '263': '🌦️', '266': '🌧️',
            '281': '🌧️', '284': '🌧️', '293': '🌦️', '296': '🌧️',
            '299': '🌧️', '302': '🌧️', '305': '🌧️', '308': '🌧️',
            '311': '🌧️', '314': '🌧️', '317': '🌧️', '320': '❄️',
            '323': '❄️', '326': '❄️', '329': '❄️', '332': '❄️',
            '335': '❄️', '338': '❄️', '350': '🌧️', '353': '🌦️',
            '356': '🌧️', '359': '🌧️', '362': '🌧️', '365': '🌧️',
            '368': '🌧️', '371': '🌧️', '377': '🌧️', '386': '⛈️',
            '389': '⛈️', '392': '🌨️', '395': '🌨️'
          };

          cityEl.textContent = city;
          tempEl.textContent = `${temp}°C`;
          iconEl.textContent = iconMap[code] || '🌤️';
          conditionEl.textContent = desc;
          humidityEl.textContent = humidity;
          windEl.textContent = wind;

          loading.style.display = 'none';
          content.style.display = 'block';

          toggleBtn.addEventListener('click', function() {
            detailsVisible = !detailsVisible;
            if (detailsVisible) {
              detailsEl.classList.add('show');
              toggleBtn.textContent = '📊 收起';
            } else {
              detailsEl.classList.remove('show');
              toggleBtn.textContent = '📊 查看更多';
            }
          });
        } else {
          throw new Error('无法获取天气数据');
        }
      } catch (error) {
        console.error('天气加载失败:', error);
        loading.innerHTML = '🌧️ 加载失败<br><span style="font-size:12px;color:#999;">点击重试</span>';
        loading.style.cursor = 'pointer';
        loading.onclick = function() {
          loading.innerHTML = '⏳ 重试中...';
          getWeather();
        };
      }
    }

    getWeather();
  })();
</script>