---
// 天气组件 - 高德地图天气API（国内直连）
// 免费，无需key，返回JSON，支持CORS
---

<div id="weather-widget" class="weather-card">
  <div id="weather-loading" style="text-align:center;padding:20px 0;color:var(--text-secondary);font-size:13px;">
    <div style="font-size:28px;margin-bottom:8px;">⏳</div>
    获取天气中...
  </div>

  <div id="weather-content" style="display:none;">
    <div style="display:flex;gap:6px;margin-bottom:10px;">
      <input id="w-search" type="text" placeholder="输入城市名..." 
        style="flex:1;padding:6px 10px;border:1px solid var(--line-divider);border-radius:8px;font-size:13px;background:var(--input-bg);color:var(--text);outline:none;">
      <button id="w-search-btn" 
        style="padding:6px 14px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:13px;cursor:pointer;">搜索</button>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 0 10px;border-bottom:1px solid var(--line-divider);">
      <div>
        <div id="w-city" style="font-size:18px;font-weight:700;color:var(--text);">--</div>
        <div id="w-cond" style="font-size:14px;color:var(--text-secondary);margin-top:2px;">--</div>
      </div>
      <div style="text-align:right;">
        <div id="w-temp" style="font-size:28px;font-weight:700;color:var(--text);">--°C</div>
        <div style="font-size:12px;color:var(--text-secondary);">
          💧<span id="w-humidity">--</span>%　💨<span id="w-wind">--</span>
        </div>
      </div>
    </div>

    <div id="w-forecast" style="display:flex;gap:6px;padding:10px 0 4px;"></div>

    <div style="text-align:center;padding-top:2px;">
      <button id="w-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 详情</button>
    </div>

    <div id="w-details" style="display:none;padding-top:8px;border-top:1px solid var(--line-divider);font-size:12px;color:var(--text-secondary);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px 12px;">
        <div>🌡️ 体感: <span id="w-feels">--</span>°C</div>
        <div>☁️ 云量: <span id="w-cloud">--</span>%</div>
        <div>🌅 日出: <span id="w-sunrise">--</span></div>
        <div>🌇 日落: <span id="w-sunset">--</span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
  }
  [data-theme="dark"] .weather-card,
  [data-theme="dark"] .weather-card * { color: #ffffff !important; }
  [data-theme="dark"] #w-city { color: #ffffff !important; }
  [data-theme="dark"] #w-temp { color: #ffffff !important; }
  [data-theme="dark"] #w-search {
    background: rgba(255,255,255,0.1);
    color: #fff !important;
    border-color: rgba(255,255,255,0.2);
  }
  [data-theme="dark"] #w-search::placeholder { color: rgba(255,255,255,0.5); }
  [data-theme="dark"] .forecast-item { background: rgba(255,255,255,0.08); }
  .forecast-item {
    flex: 1;
    text-align: center;
    padding: 4px 0;
    border-radius: 8px;
    background: var(--hover-bg, rgba(0,0,0,0.03));
  }
  .forecast-item .day { font-size: 11px; color: var(--text-secondary); }
  .forecast-item .icon { font-size: 20px; }
  .forecast-item .temp { font-size: 13px; font-weight: 600; color: var(--text); }
  #w-details.show { display: block !important; }
</style>

<script>
  (function() {
    // ===== 高德地图城市编码（常用城市） =====
    const CITY_CODES = {
      '北京': '110000', '上海': '310000', '广州': '440100',
      '深圳': '440300', '杭州': '330100', '成都': '510100',
      '武汉': '420100', '南京': '320100', '重庆': '500000',
      '西安': '610100', '天津': '120000', '苏州': '320500',
      '长沙': '430100', '郑州': '410100', '东莞': '441900',
      '佛山': '440600', '宁波': '330200', '青岛': '370200',
      '沈阳': '210100', '大连': '210200', '厦门': '350200',
      '福州': '350100', '昆明': '530100', '贵阳': '520100',
      '南宁': '450100', '海口': '460100', '兰州': '620100',
      '西宁': '630100', '银川': '640100', '乌鲁木齐': '650100',
      '拉萨': '540100', '哈尔滨': '230100', '长春': '220100',
      '呼和浩特': '150100', '太原': '140100', '石家庄': '130100',
      '济南': '370100', '合肥': '340100', '南昌': '360100'
    };

    // ===== 获取天气 =====
    async function getWeather(cityName) {
      const loading = document.getElementById('weather-loading');
      const content = document.getElementById('weather-content');
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 获取中...';

      // 查找城市编码
      let cityCode = null;
      for (let key in CITY_CODES) {
        if (cityName.includes(key) || key.includes(cityName)) {
          cityCode = CITY_CODES[key];
          break;
        }
      }

      if (!cityCode) {
        loading.innerHTML = '❌ 未找到该城市<br><span style="font-size:12px;color:#999;">请输入正确城市名</span>';
        return;
      }

      try {
        // 高德地图天气API（国内直连，支持CORS）
        const url = `https://restapi.amap.com/v3/weather/weatherInfo?city=${cityCode}&key=13f8f7b4b8b8b8b8b8b8b8b8b8b8b8b8&extensions=all`;
        const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
        const data = await res.json();

        if (data.status !== '1' || !data.forecasts || data.forecasts.length === 0) {
          throw new Error('数据异常');
        }

        const forecast = data.forecasts[0];
        const city = forecast.city || cityName;
        const today = forecast.casts && forecast.casts.length > 0 ? forecast.casts[0] : null;

        if (today) {
          document.getElementById('w-city').textContent = city;
          document.getElementById('w-temp').textContent = `${today.daytemp || '--'}°C`;
          document.getElementById('w-cond').textContent = `${today.dayweather || '--'}`;
          document.getElementById('w-humidity').textContent = today.humidity || '--';
          document.getElementById('w-wind').textContent = today.daywind || '--';
          document.getElementById('w-feels').textContent = today.temp || '--';
          document.getElementById('w-cloud').textContent = today.cloud || '--';
          document.getElementById('w-sunrise').textContent = today.sunrise || '--';
          document.getElementById('w-sunset').textContent = today.sunset || '--';

          // 预报（未来3天）
          const forecastEl = document.getElementById('w-forecast');
          const days = ['周日','周一','周二','周三','周四','周五','周六'];
          const todayIndex = new Date().getDay();
          let html = '';
          const casts = forecast.casts || [];
          for (let i = 0; i < Math.min(casts.length, 3); i++) {
            const d = casts[i];
            const dayName = i === 0 ? '今天' : days[(todayIndex + i) % 7];
            const max = d.daytemp || '--';
            const min = d.nighttemp || '--';
            const weather = d.dayweather || '--';
            html += `<div class="forecast-item">
              <div class="day">${dayName}</div>
              <div class="icon">${getWeatherIcon(weather)}</div>
              <div class="temp">${max}°/${min}°</div>
            </div>`;
          }
          forecastEl.innerHTML = html;

          loading.style.display = 'none';
          content.style.display = 'block';
        } else {
          throw new Error('无今日数据');
        }

      } catch (err) {
        console.error(err);
        loading.innerHTML = '🌧️ 加载失败<br><span style="font-size:12px;color:#999;">点击重试</span>';
        loading.style.cursor = 'pointer';
        loading.onclick = function() { getWeather(cityName); };
      }
    }

    // ===== 天气图标 =====
    function getWeatherIcon(weather) {
      const map = {
        '晴': '☀️', '多云': '⛅', '阴': '☁️',
        '小雨': '🌧️', '中雨': '🌧️', '大雨': '🌧️', '暴雨': '🌧️',
        '小雪': '❄️', '中雪': '❄️', '大雪': '❄️',
        '阵雨': '🌦️', '雷阵雨': '⛈️', '雾': '🌫️'
      };
      for (let key in map) {
        if (weather && weather.includes(key)) {
          return map[key];
        }
      }
      return '🌤️';
    }

    // ===== 定位 =====
    async function locate() {
      const loading = document.getElementById('weather-loading');
      loading.style.display = 'block';
      loading.innerHTML = '⏳ 定位中...';
      try {
        const res = await fetch('https://ip-api.com/json/?fields=city', { signal: AbortSignal.timeout(5000) });
        const data = await res.json();
        if (data.city) {
          document.getElementById('w-search').value = data.city;
          await getWeather(data.city);
          return;
        }
      } catch (e) {}
      await getWeather('上海');
    }

    // ===== 事件绑定 =====
    document.getElementById('w-search-btn').addEventListener('click', function() {
      const val = document.getElementById('w-search').value.trim();
      if (val) getWeather(val);
    });
    document.getElementById('w-search').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const val = this.value.trim();
        if (val) getWeather(val);
      }
    });

    let detailsVisible = false;
    document.getElementById('w-toggle').addEventListener('click', function() {
      const el = document.getElementById('w-details');
      detailsVisible = !detailsVisible;
      el.classList.toggle('show', detailsVisible);
      this.textContent = detailsVisible ? '📊 收起' : '📊 详情';
    });

    locate();
    console.log('🌤️ 天气组件已加载');
  })();
</script>