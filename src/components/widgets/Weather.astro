---
// 天气组件 - 使用国内可用 API
// 定位: ip-api.com 备用: 淘宝IP库
// 天气: wttr.in（国内可用）
// 搜城市: 高德地图 API
---

<div id="weather-widget" class="weather-card">
  <div id="weather-loading" style="text-align:center;padding:20px 0;color:var(--text-secondary);font-size:13px;">
    <div style="font-size:28px;margin-bottom:8px;">⏳</div>
    获取天气中...
  </div>

  <div id="weather-content" style="display:none;">
    <!-- 城市搜索 -->
    <div style="display:flex;gap:6px;margin-bottom:10px;">
      <input id="weather-search" type="text" placeholder="搜索城市..." 
        style="flex:1;padding:6px 10px;border:1px solid var(--line-divider);border-radius:8px;font-size:13px;background:var(--input-bg);color:var(--text);outline:none;">
      <button id="weather-search-btn" 
        style="padding:6px 14px;background:var(--primary);color:#fff;border:none;border-radius:8px;font-size:13px;cursor:pointer;">搜索</button>
    </div>

    <!-- 当前天气 -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0 12px;border-bottom:1px solid var(--line-divider);">
      <div>
        <div id="w-city" style="font-size:18px;font-weight:700;color:var(--text);">--</div>
        <div id="w-date" style="font-size:12px;color:var(--text-secondary);">--</div>
        <div id="w-cond" style="font-size:14px;color:var(--text-secondary);margin-top:2px;">--</div>
      </div>
      <div style="text-align:right;">
        <div id="w-temp" style="font-size:32px;font-weight:700;color:var(--text);">--°C</div>
        <div style="font-size:12px;color:var(--text-secondary);">
          <span>💧 <span id="w-humidity">--</span>%</span>
          <span style="margin-left:12px;">💨 <span id="w-wind">--</span>km/h</span>
        </div>
      </div>
    </div>

    <!-- 7天预报 -->
    <div id="w-forecast" style="display:flex;gap:6px;padding:12px 0 8px;overflow-x:auto;scrollbar-width:thin;"></div>

    <div style="text-align:center;padding-top:6px;">
      <button id="w-toggle" style="background:none;border:none;color:var(--primary);font-size:12px;cursor:pointer;opacity:0.7;">📊 查看更多</button>
    </div>

    <div id="w-details" style="display:none;padding-top:10px;border-top:1px solid var(--line-divider);font-size:13px;color:var(--text-secondary);">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px 16px;">
        <div>🌡️ 体感: <span id="w-feels">--</span>°C</div>
        <div>☁️ 云量: <span id="w-cloud">--</span>%</div>
        <div>🌅 日出: <span id="w-sunrise">--</span></div>
        <div>🌇 日落: <span id="w-sunset">--</span></div>
        <div>🌬️ 阵风: <span id="w-gust">--</span>km/h</div>
        <div>👁️ 能见度: <span id="w-vis">--</span>km</div>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-card {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 8px;
    border: 1px solid var(--line-divider);
  }
  [data-theme="dark"] .weather-card,
  [data-theme="dark"] .weather-card *,
  html.dark .weather-card,
  html.dark .weather-card * {
    color: #ffffff !important;
  }
  [data-theme="dark"] #w-city,
  [data-theme="dark"] #w-temp { color: #ffffff !important; }
  [data-theme="dark"] .forecast-day { background: rgba(255,255,255,0.08); color: #fff !important; }
  [data-theme="dark"] .forecast-day .day-temp { color: #fff !important; }
  [data-theme="dark"] #weather-search {
    background: rgba(255,255,255,0.1); color: #fff !important;
    border-color: rgba(255,255,255,0.2);
  }
  [data-theme="dark"] #weather-search::placeholder { color: rgba(255,255,255,0.5); }
  #w-forecast::-webkit-scrollbar { height: 3px; }
  #w-forecast::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }
  .forecast-day {
    flex: 0 0 52px; text-align: center; font-size: 12px; padding: 4px 0;
    border-radius: 8px; background: var(--hover-bg, rgba(0,0,0,0.03));
    color: var(--text-secondary);
  }
  .forecast-day .day-temp { font-weight: 600; color: var(--text); }
  #w-details.show { display: block !important; }
  [data-theme="dark"] #w-details,
  [data-theme="dark"] #w-details * { color: #cccccc !important; }
</style>

<script>
  (function() {
    const loading = document.getElementById('weather-loading');
    const content = document.getElementById('weather-content');

    const wCity = document.getElementById('w-city');
    const wDate = document.getElementById('w-date');
    const wCond = document.getElementById('w-cond');
    const wTemp = document.getElementById('w-temp');
    const wHumidity = document.getElementById('w-humidity');
    const wWind = document.getElementById('w-wind');
    const wFeels = document.getElementById('w-feels');
    const wCloud = document.getElementById('w-cloud');
    const wSunrise = document.getElementById('w-sunrise');
    const wSunset = document.getElementById('w-sunset');
    const wGust = document.getElementById('w-gust');
    const wVis = document.getElementById('w-vis');
    const forecastEl = document.getElementById('w-forecast');
    const toggleBtn = document.getElementById('w-toggle');
    const detailsEl = document.getElementById('w-details');
    const searchInput = document.getElementById('weather-search');
    const searchBtn = document.getElementById('weather-search-btn');

    let detailsVisible = false;
    let currentCity = '';
    let currentLat = 31.23;
    let currentLon = 121.47;

    // ===== 天气图标 =====
    function getEmoji(code) {
      const m = {0:'☀️',1:'⛅',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',51:'🌧️',53:'🌧️',55:'🌧️',
        56:'🌧️',57:'🌧️',61:'🌧️',63:'🌧️',65:'🌧️',66:'🌧️',67:'🌧️',71:'❄️',73:'❄️',
        75:'❄️',77:'❄️',80:'🌧️',81:'🌧️',82:'🌧️',85:'❄️',86:'❄️',95:'⛈️',96:'⛈️',99:'⛈️'};
      return m[code] || '🌤️';
    }
    function getDesc(code) {
      const m = {0:'晴天',1:'晴间多云',2:'多云',3:'阴天',45:'雾天',48:'雾天',51:'小雨',53:'小雨',
        55:'中雨',56:'冻雨',57:'冻雨',61:'中雨',63:'大雨',65:'暴雨',66:'冻雨',67:'冻雨',
        71:'小雪',73:'中雪',75:'大雪',77:'雪粒',80:'阵雨',81:'阵雨',82:'强阵雨',
        85:'阵雪',86:'强阵雪',95:'雷暴',96:'雷暴',99:'强雷暴'};
      return m[code] || '--';
    }

    // ===== 获取天气（用 wttr.in，国内可用） =====
    async function getWeather(city, lat, lon) {
      try {
        // 用 wttr.in 直接查城市名（中文支持）
        const url = `https://wttr.in/${encodeURIComponent(city)}?format=j1&lang=zh`;
        const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
        const data = await res.json();

        if (!data || !data.current_condition) {
          throw new Error('数据异常');
        }

        const cur = data.current_condition[0];
        const temp = cur.temp_C || '--';
        const cond = cur.weatherDesc?.[0]?.value || '--';
        const humidity = cur.humidity || '--';
        const wind = cur.windSpeedKmph || '--';
        const code = cur.weatherCode || '113';
        const feels = cur.FeelsLikeC || '--';
        const vis = cur.visibility || '--';
        const cloud = cur.cloudcover || '--';
        const gust = cur.windGustKmph || '--';

        wCity.textContent = city;
        wDate.textContent = new Date().toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric', weekday:'short' });
        wCond.textContent = cond;
        wTemp.textContent = `${temp}°C`;
        wHumidity.textContent = humidity;
        wWind.textContent = wind;
        wFeels.textContent = feels;
        wCloud.textContent = cloud;
        wGust.textContent = gust;
        wVis.textContent = vis;

        // 日出日落
        if (data.weather?.[0]?.astronomy?.[0]) {
          const astro = data.weather[0].astronomy[0];
          wSunrise.textContent = astro.sunrise || '--';
          wSunset.textContent = astro.sunset || '--';
        }

        // 预报
        if (data.weather) {
          const days = ['周日','周一','周二','周三','周四','周五','周六'];
          const today = new Date().getDay();
          let html = '';
          for (let i = 0; i < Math.min(data.weather.length, 7); i++) {
            const d = data.weather[i];
            const dayName = i === 0 ? '今天' : days[(today + i) % 7];
            const max = d.maxtempC || '--';
            const min = d.mintempC || '--';
            const code2 = d.hourly?.[0]?.weatherCode || '113';
            html += `<div class="forecast-day">
              <div>${dayName}</div>
              <div style="font-size:18px;">${getEmoji(parseInt(code2))}</div>
              <div class="day-temp">${max}°</div>
              <div style="font-size:10px;color:var(--text-secondary);">${min}°</div>
            </div>`;
          }
          forecastEl.innerHTML = html;
        }

        loading.style.display = 'none';
        content.style.display = 'block';

      } catch (err) {
        console.error('天气获取失败:', err);
        // 用 Open-Meteo 备用
        try {
          await getWeatherFallback(lat, lon, city);
        } catch {
          loading.innerHTML = `🌧️ 获取失败<br><span style="font-size:12px;color:#999;">点击重试</span>`;
          loading.style.cursor = 'pointer';
          loading.onclick = function() { loading.innerHTML = '⏳ 重试中...'; getWeather(city, lat, lon); };
        }
      }
    }

    // ===== 备用：Open-Meteo =====
    async function getWeatherFallback(lat, lon, city) {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=weathercode,temperature_2m_max,temperature_2m_min&hourly=relativehumidity_2m,windspeed_10m&timezone=auto&forecast_days=7`;
      const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
      const data = await res.json();
      if (!data || !data.current_weather) throw new Error('数据异常');

      const cur = data.current_weather;
      const code = cur.weathercode || 0;
      const temp = Math.round(cur.temperature);
      const wind = Math.round(cur.windspeed || 0);
      let humidity = '--';
      if (data.hourly?.relativehumidity_2m?.[0]) humidity = data.hourly.relativehumidity_2m[0];

      wCity.textContent = city;
      wDate.textContent = new Date().toLocaleDateString('zh-CN', { year:'numeric', month:'long', day:'numeric', weekday:'short' });
      wCond.textContent = getDesc(code);
      wTemp.textContent = `${temp}°C`;
      wHumidity.textContent = humidity;
      wWind.textContent = wind;
      wFeels.textContent = '--';
      wCloud.textContent = '--';
      wGust.textContent = '--';
      wVis.textContent = '--';
      wSunrise.textContent = '--';
      wSunset.textContent = '--';

      if (data.daily) {
        const days = ['周日','周一','周二','周三','周四','周五','周六'];
        const today = new Date().getDay();
        let html = '';
        for (let i = 0; i < Math.min(data.daily.time.length, 7); i++) {
          const max = Math.round(data.daily.temperature_2m_max[i] || 0);
          const min = Math.round(data.daily.temperature_2m_min[i] || 0);
          const c = data.daily.weathercode[i] || 0;
          const dayName = i === 0 ? '今天' : days[(today + i) % 7];
          html += `<div class="forecast-day">
            <div>${dayName}</div>
            <div style="font-size:18px;">${getEmoji(c)}</div>
            <div class="day-temp">${max}°</div>
            <div style="font-size:10px;color:var(--text-secondary);">${min}°</div>
          </div>`;
        }
        forecastEl.innerHTML = html;
      }

      loading.style.display = 'none';
      content.style.display = 'block';
    }

    // ===== 定位 =====
    async function locate() {
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 定位中...';

      try {
        const res = await fetch('https://ip-api.com/json/?fields=city,region,country,lat,lon', { signal: AbortSignal.timeout(5000) });
        const data = await res.json();
        if (data.city && data.lat) {
          currentCity = data.city + (data.region ? `, ${data.region}` : '');
          currentLat = data.lat;
          currentLon = data.lon;
          await getWeather(currentCity, currentLat, currentLon);
          return;
        }
      } catch {}

      // 备用定位
      try {
        const res2 = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(5000) });
        const data2 = await res2.json();
        if (data2.city && data2.latitude) {
          currentCity = data2.city || data2.region || '未知城市';
          currentLat = data2.latitude || 31.23;
          currentLon = data2.longitude || 121.47;
          await getWeather(currentCity, currentLat, currentLon);
          return;
        }
      } catch {}

      // 默认上海
      currentCity = '上海';
      currentLat = 31.23;
      currentLon = 121.47;
      await getWeather(currentCity, currentLat, currentLon);
    }

    // ===== 搜索 =====
    async function searchCity(query) {
      if (!query.trim()) return;
      loading.style.display = 'block';
      content.style.display = 'none';
      loading.innerHTML = '⏳ 搜索中...';

      try {
        const res = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=3&language=zh`);
        const data = await res.json();
        if (!data.results || data.results.length === 0) {
          loading.innerHTML = '❌ 未找到该城市';
          return;
        }
        const r = data.results[0];
        currentCity = r.name + (r.admin1 ? `, ${r.admin1}` : '');
        currentLat = r.latitude;
        currentLon = r.longitude;
        await getWeather(currentCity, currentLat, currentLon);
      } catch {
        loading.innerHTML = '❌ 搜索失败';
      }
    }

    // ===== 事件 =====
    toggleBtn.addEventListener('click', function() {
      detailsVisible = !detailsVisible;
      detailsEl.classList.toggle('show', detailsVisible);
      toggleBtn.textContent = detailsVisible ? '📊 收起' : '📊 查看更多';
    });
    searchBtn.addEventListener('click', function() { searchCity(searchInput.value); });
    searchInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') searchCity(searchInput.value); });

    // ===== 启动 =====
    locate();
    console.log('🌤️ 天气组件已加载');
  })();
</script>