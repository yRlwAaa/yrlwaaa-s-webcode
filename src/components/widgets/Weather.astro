---
// 天气组件 - Open-Meteo API（苹果天气风格）
// IP 定位 → 默认显示用户位置天气；支持搜索城市替换地点；颜色跟随主题色滑块
---

<div id="weather-widget" class="weather-card">
	<!-- 加载态 -->
	<div id="weather-loading" class="w-loading">
		<div class="w-loading-icon">🌤️</div>
		<div class="w-loading-text">定位中...</div>
	</div>

	<!-- 主体 -->
	<div id="weather-content" class="w-content" style="display:none;">
		<!-- 头部：城市 + 搜索入口 -->
		<div class="w-header">
			<span id="w-city" class="w-city">--</span>
			<button
				id="w-search-toggle"
				class="w-search-toggle"
				aria-label="搜索城市"
				title="搜索城市"
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</button>
		</div>

		<!-- 搜索面板 -->
		<div id="w-search-panel" class="w-search-panel">
			<div class="w-search-row">
				<input
					id="w-search"
					type="text"
					placeholder="搜索城市..."
					autocomplete="off"
					class="w-search-input"
				/>
				<button id="w-search-btn" class="w-search-btn">搜索</button>
			</div>
			<div id="w-search-results" class="w-search-results"></div>
		</div>

		<!-- 当前天气 -->
		<div class="w-current">
			<div class="w-current-top">
				<span id="w-icon" class="w-icon">🌤️</span>
				<div class="w-current-main">
					<div class="w-temp-line">
						<span id="w-temp" class="w-temp">--°</span>
					</div>
					<div id="w-cond" class="w-cond">--</div>
				</div>
			</div>
			<div class="w-hilo">
				<span class="w-hi">最高 <b id="w-max">--°</b></span>
				<span class="w-lo">最低 <b id="w-min">--°</b></span>
			</div>
			<div class="w-meta">
				<span class="w-meta-item">
					<svg
						width="13"
						height="13"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M12 2.69 17.66 8a8 8 0 1 1-11.31 0z"></path>
					</svg>
					<span id="w-humidity">--</span>%
				</span>
				<span class="w-meta-item">
					<svg
						width="13"
						height="13"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M9.59 4.59A2 2 0 1 1 11 8H2"></path>
						<path d="M17.73 7.73A2.5 2.5 0 1 1 19.5 12H2"></path>
						<path d="M12.59 19.41A2 2 0 1 0 14 16H2"></path>
					</svg>
					<span id="w-wind">--</span> km/h
				</span>
			</div>
		</div>

		<!-- 一周预报 -->
		<div class="w-forecast">
			<div class="w-forecast-title">一周预报</div>
			<div id="w-forecast" class="w-days"></div>
		</div>
	</div>
</div>

<style>
	.weather-card {
		background: var(--card-bg);
		border-radius: var(--radius-large);
		padding: 14px 16px;
		border: 1px solid var(--line-divider);
		overflow: hidden;
	}

	/* 加载态 */
	.w-loading {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 24px 0;
		color: var(--content-meta);
	}
	.w-loading-icon {
		font-size: 30px;
		animation: w-pulse 1.6s ease-in-out infinite;
	}
	.w-loading-text {
		font-size: 13px;
	}
	@keyframes w-pulse {
		0%,
		100% {
			opacity: 0.4;
			transform: scale(0.96);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
		}
	}

	/* 头部 */
	.w-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 6px;
	}
	.w-city {
		font-size: 17px;
		font-weight: 700;
		color: var(--title-active);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.w-search-toggle {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: var(--content-meta);
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.w-search-toggle:hover {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
	}
	.w-search-toggle.active {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
	}

	/* 搜索面板 */
	.w-search-panel {
		display: none;
		margin-bottom: 10px;
		animation: w-slide-down 0.2s ease;
	}
	.w-search-panel.open {
		display: block;
	}
	@keyframes w-slide-down {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.w-search-row {
		display: flex;
		gap: 6px;
	}
	.w-search-input {
		flex: 1;
		min-width: 0;
		padding: 7px 10px;
		border: 1px solid var(--line-divider);
		border-radius: 10px;
		font-size: 13px;
		background: var(--btn-regular-bg);
		color: var(--deep-text);
		outline: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	.w-search-input::placeholder {
		color: var(--content-meta);
	}
	.w-search-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px
			color-mix(in oklab, var(--primary) 22%, transparent);
	}
	.w-search-btn {
		flex-shrink: 0;
		padding: 7px 14px;
		background: var(--primary);
		color: #fff;
		border: none;
		border-radius: 10px;
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.1s ease;
	}
	.w-search-btn:hover {
		opacity: 0.9;
	}
	.w-search-btn:active {
		transform: scale(0.96);
	}
	.w-search-results {
		margin-top: 6px;
		max-height: 180px;
		overflow-y: auto;
		border: 1px solid var(--line-divider);
		border-radius: 10px;
		background: var(--card-bg);
	}
	.w-search-results:empty {
		display: none;
	}
	.w-result {
		width: 100%;
		text-align: left;
		padding: 8px 10px;
		border: none;
		background: transparent;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 1px;
		transition: background 0.15s ease;
	}
	.w-result + .w-result {
		border-top: 1px solid var(--line-divider);
	}
	.w-result:hover {
		background: var(--btn-plain-bg-hover);
	}
	.w-result-name {
		font-size: 13px;
		font-weight: 600;
		color: var(--deep-text);
	}
	.w-result-sub {
		font-size: 11px;
		color: var(--content-meta);
	}
	.w-search-empty {
		padding: 12px;
		text-align: center;
		font-size: 12px;
		color: var(--content-meta);
	}

	/* 当前天气 */
	.w-current {
		padding: 10px 0 12px;
		border-bottom: 1px solid var(--line-divider);
	}
	.w-current-top {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.w-icon {
		font-size: 40px;
		line-height: 1;
	}
	.w-current-main {
		display: flex;
		flex-direction: column;
	}
	.w-temp {
		font-size: 40px;
		font-weight: 700;
		line-height: 1;
		color: var(--primary);
		letter-spacing: -1px;
	}
	.w-cond {
		font-size: 13px;
		color: var(--content-meta);
		margin-top: 4px;
	}
	.w-hilo {
		display: flex;
		gap: 16px;
		margin-top: 10px;
		font-size: 12px;
		color: var(--content-meta);
	}
	.w-hilo b {
		color: var(--deep-text);
		font-weight: 600;
	}
	.w-meta {
		display: flex;
		gap: 16px;
		margin-top: 8px;
		font-size: 12px;
		color: var(--content-meta);
	}
	.w-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	/* 一周预报 */
	.w-forecast {
		padding-top: 12px;
	}
	.w-forecast-title {
		font-size: 12px;
		font-weight: 600;
		color: var(--content-meta);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 8px;
	}
	.w-days {
		display: flex;
		flex-direction: column;
	}
	.w-day {
		display: grid;
		grid-template-columns: 30px 24px 30px 1fr 30px;
		align-items: center;
		gap: 8px;
		padding: 6px 0;
	}
	.w-day + .w-day {
		border-top: 1px solid
			color-mix(in oklab, var(--line-divider) 60%, transparent);
	}
	.w-day-name {
		font-size: 13px;
		font-weight: 500;
		color: var(--deep-text);
	}
	.w-day-icon {
		font-size: 17px;
		text-align: center;
	}
	.w-day-low,
	.w-day-high {
		font-size: 12px;
		color: var(--content-meta);
		text-align: center;
	}
	.w-day-high {
		color: var(--deep-text);
		font-weight: 600;
	}
	.w-day-track {
		position: relative;
		height: 4px;
		border-radius: 999px;
		background: var(--btn-plain-bg-hover);
		overflow: hidden;
	}
	.w-day-fill {
		position: absolute;
		top: 0;
		bottom: 0;
		border-radius: 999px;
		background: linear-gradient(
			to right,
			color-mix(in oklab, var(--primary) 55%, transparent),
			var(--primary)
		);
	}
</style>

<script>
	(function () {
		console.log("🌤️ 天气组件启动");

		const loading = document.getElementById("weather-loading")!;
		const content = document.getElementById("weather-content")!;
		const wCity = document.getElementById("w-city")!;
		const wIcon = document.getElementById("w-icon")!;
		const wTemp = document.getElementById("w-temp")!;
		const wCond = document.getElementById("w-cond")!;
		const wMax = document.getElementById("w-max")!;
		const wMin = document.getElementById("w-min")!;
		const wHumidity = document.getElementById("w-humidity")!;
		const wWind = document.getElementById("w-wind")!;
		const wForecast = document.getElementById("w-forecast")!;
		const searchToggle = document.getElementById("w-search-toggle")!;
		const searchPanel = document.getElementById("w-search-panel")!;
		const searchInput = document.getElementById("w-search") as HTMLInputElement;
		const searchBtn = document.getElementById("w-search-btn")!;
		const searchResults = document.getElementById("w-search-results")!;

		if (
			!loading ||
			!content ||
			!wCity ||
			!wIcon ||
			!wTemp ||
			!wCond ||
			!wMax ||
			!wMin ||
			!wHumidity ||
			!wWind ||
			!wForecast ||
			!searchToggle ||
			!searchPanel ||
			!searchInput ||
			!searchBtn ||
			!searchResults
		) {
			console.error("🌤️ 天气组件：缺少必需 DOM 元素，跳过初始化");
			return;
		}

		// ===== 天气代码映射 =====
		const emojiMap: Record<number, string> = {
			0: "☀️", 1: "⛅", 2: "⛅", 3: "☁️",
			45: "🌫️", 48: "🌫️",
			51: "🌧️", 53: "🌧️", 55: "🌧️",
			56: "🌧️", 57: "🌧️",
			61: "🌧️", 63: "🌧️", 65: "🌧️",
			66: "🌧️", 67: "🌧️",
			71: "🌨️", 73: "🌨️", 75: "❄️", 77: "❄️",
			80: "🌦️", 81: "🌦️", 82: "🌧️",
			85: "🌨️", 86: "🌨️",
			95: "⛈️", 96: "⛈️", 99: "⛈️",
		};
		const descMap: Record<number, string> = {
			0: "晴", 1: "晴间多云", 2: "多云", 3: "阴",
			45: "雾", 48: "雾",
			51: "小雨", 53: "小雨", 55: "中雨",
			56: "冻雨", 57: "冻雨",
			61: "中雨", 63: "大雨", 65: "暴雨",
			66: "冻雨", 67: "冻雨",
			71: "小雪", 73: "中雪", 75: "大雪", 77: "雪粒",
			80: "阵雨", 81: "阵雨", 82: "强阵雨",
			85: "阵雪", 86: "强阵雪",
			95: "雷暴", 96: "雷暴", 99: "强雷暴",
		};

		const weekDays = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
		const emoji = (code: number) => emojiMap[code] || "🌤️";
		const desc = (code: number) => descMap[code] || "--";

		// ===== 位置持久化 =====
		const STORAGE_KEY = "weather-location";
		function saveLocation(lat: number, lon: number, city: string) {
			try {
				localStorage.setItem(
					STORAGE_KEY,
					JSON.stringify({ lat, lon, city }),
				);
			} catch {
				/* ignore */
			}
		}
		function loadLocation(): { lat: number; lon: number; city: string } | null {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;
				const data = JSON.parse(raw);
				if (
					typeof data.lat === "number" &&
					typeof data.lon === "number" &&
					typeof data.city === "string"
				) {
					return data;
				}
			} catch {
				/* ignore */
			}
			return null;
		}

		// ===== 渲染 =====
		function setLoading(text: string) {
			loading.style.display = "flex";
			content.style.display = "none";
			const t = loading.querySelector(".w-loading-text");
			if (t) t.textContent = text;
		}

		function renderForecast(daily: any) {
			const days: {
				date: string;
				code: number;
				max: number;
				min: number;
			}[] = [];
			const len = Math.min((daily?.time || []).length, 7);
			for (let i = 0; i < len; i++) {
				days.push({
					date: daily.time[i],
					code: daily.weathercode?.[i] ?? 0,
					max: Math.round(daily.temperature_2m_max?.[i] ?? 0),
					min: Math.round(daily.temperature_2m_min?.[i] ?? 0),
				});
			}
			if (days.length === 0) return;

			const allMax = Math.max(...days.map((d) => d.max));
			const allMin = Math.min(...days.map((d) => d.min));
			const span = allMax - allMin || 1;
			const today = new Date().getDay();

			wForecast.innerHTML = days
				.map((d, i) => {
					const dayName =
						i === 0 ? "今天" : weekDays[(today + i) % 7];
					const left = ((d.min - allMin) / span) * 100;
					const width = Math.max(
						((d.max - d.min) / span) * 100,
						8,
					);
					return `<div class="w-day">
						<span class="w-day-name">${dayName}</span>
						<span class="w-day-icon">${emoji(d.code)}</span>
						<span class="w-day-low">${d.min}°</span>
						<div class="w-day-track"><div class="w-day-fill" style="left:${left.toFixed(1)}%;width:${width.toFixed(1)}%"></div></div>
						<span class="w-day-high">${d.max}°</span>
					</div>`;
				})
				.join("");
		}

		function displayWeather(data: any, city: string) {
			if (!data || !data.current_weather) {
				console.error("数据异常");
				return false;
			}

			const cur = data.current_weather;
			const code = cur.weathercode || 0;
			const temp = Math.round(cur.temperature);
			const wind = Math.round(cur.windspeed || 0);

			let humidity = "--";
			if (
				data.hourly?.relativehumidity_2m &&
				data.hourly.relativehumidity_2m.length > 0
			) {
				humidity = String(data.hourly.relativehumidity_2m[0] ?? "--");
			}

			const dailyMax = Math.round(
				data.daily?.temperature_2m_max?.[0] ?? temp,
			);
			const dailyMin = Math.round(
				data.daily?.temperature_2m_min?.[0] ?? temp,
			);

			wCity.textContent = city;
			wIcon.textContent = emoji(code);
			wTemp.textContent = `${temp}°`;
			wCond.textContent = desc(code);
			wMax.textContent = `${dailyMax}°`;
			wMin.textContent = `${dailyMin}°`;
			wHumidity.textContent = humidity;
			wWind.textContent = String(wind);

			renderForecast(data.daily);

			loading.style.display = "none";
			content.style.display = "block";
			return true;
		}

		// 带超时的 fetch（用 AbortController，兼容性更好）
		function fetchWithTimeout(url: string, ms: number): Promise<Response> {
			const controller = new AbortController();
			const timer = setTimeout(() => controller.abort(), ms);
			return fetch(url, { signal: controller.signal }).finally(() =>
				clearTimeout(timer),
			);
		}

		// ===== 获取天气 =====
		async function fetchWeather(lat: number, lon: number, city: string) {
			setLoading("获取中...");
			try {
				const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=weathercode,temperature_2m_max,temperature_2m_min&hourly=relativehumidity_2m&timezone=auto&forecast_days=7`;
				const res = await fetchWithTimeout(url, 8000);
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const data = await res.json();
				const ok = displayWeather(data, city);
				if (ok) {
					saveLocation(lat, lon, city);
					searchInput.value = city;
				} else {
					throw new Error("显示失败");
				}
			} catch (err) {
				console.error("❌ 天气获取失败:", err);
				setLoading("加载失败");
				loading.style.cursor = "pointer";
				loading.onclick = function () {
					loading.style.cursor = "";
					fetchWeather(lat, lon, city);
				};
			}
		}

		// ===== 反查城市名（坐标 → 城市，免费无 key） =====
		async function reverseGeocode(
			lat: number,
			lon: number,
		): Promise<string | null> {
			try {
				const res = await fetchWithTimeout(
					`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=zh`,
					5000,
				);
				if (!res.ok) return null;
				const d = await res.json();
				return d.city || d.locality || d.principalSubdivision || null;
			} catch {
				return null;
			}
		}

		// ===== 定位 =====
		async function locate() {
			setLoading("定位中...");

			// 优先使用用户上次搜索的地点
			const saved = loadLocation();
			if (saved) {
				await fetchWeather(saved.lat, saved.lon, saved.city);
				return;
			}

			// 3 秒兜底：无论定位结果如何，保证显示天气（默认上海），绝不卡在“定位中”
			let settled = false;
			const settleDefault = () => {
				if (settled) return;
				settled = true;
				fetchWeather(31.23, 121.47, "上海");
			};
			const fallbackTimer = setTimeout(settleDefault, 3000);

			const useCoords = (lat: number, lon: number) => {
				if (settled) return;
				settled = true;
				clearTimeout(fallbackTimer);
				fetchWeather(lat, lon, "当前位置").then(() => {
					// 异步反查城市名并更新
					reverseGeocode(lat, lon).then((city) => {
						if (city) {
							wCity.textContent = city;
							searchInput.value = city;
							saveLocation(lat, lon, city);
						}
					});
				});
			};

			// 浏览器原生定位（GPS/WiFi，大陆可用，无需第三方 IP API）
			if ("geolocation" in navigator) {
				navigator.geolocation.getCurrentPosition(
					(pos) => useCoords(pos.coords.latitude, pos.coords.longitude),
					() => {
						// 用户拒绝或定位失败 → 立即默认城市
						clearTimeout(fallbackTimer);
						settleDefault();
					},
					{ timeout: 3000, maximumAge: 300000 },
				);
			} else {
				settleDefault();
			}
		}

		// ===== 搜索 =====
		function escapeHtml(s: string): string {
			return s
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;");
		}

		async function searchCity(query: string) {
			const q = query.trim();
			if (!q) return;
			searchResults.innerHTML =
				'<div class="w-search-empty">搜索中...</div>';
			try {
				const res = await fetchWithTimeout(
					`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(q)}&count=5&language=zh&format=json`,
					6000,
				);
				const data = await res.json();
				const results = data.results || [];
				if (results.length === 0) {
					searchResults.innerHTML =
						'<div class="w-search-empty">未找到该城市</div>';
					return;
				}
				searchResults.innerHTML = results
					.map(
						(r: any) => `
						<button class="w-result" data-lat="${r.latitude}" data-lon="${r.longitude}" data-name="${escapeHtml(r.name)}" data-admin="${escapeHtml(r.admin1 || "")}" data-country="${escapeHtml(r.country || "")}">
							<span class="w-result-name">${escapeHtml(r.name)}</span>
							<span class="w-result-sub">${escapeHtml([r.admin1, r.country].filter(Boolean).join(" · "))}</span>
						</button>`,
					)
					.join("");
				// 绑定结果点击
				searchResults
					.querySelectorAll<HTMLElement>(".w-result")
					.forEach((btn) => {
						btn.addEventListener("click", () => {
							const lat = parseFloat(btn.dataset.lat!);
							const lon = parseFloat(btn.dataset.lon!);
							const name = btn.dataset.name!;
							const admin = btn.dataset.admin;
							const city = admin ? `${name}, ${admin}` : name;
							closeSearch();
							fetchWeather(lat, lon, city);
						});
					});
			} catch (err) {
				console.error("❌ 搜索失败:", err);
				searchResults.innerHTML =
					'<div class="w-search-empty">搜索失败，请重试</div>';
			}
		}

		function toggleSearch() {
			const isOpen = searchPanel.classList.toggle("open");
			searchToggle.classList.toggle("active", isOpen);
			if (isOpen) {
				setTimeout(() => searchInput.focus(), 50);
			} else {
				searchResults.innerHTML = "";
			}
		}
		function closeSearch() {
			searchPanel.classList.remove("open");
			searchToggle.classList.remove("active");
			searchResults.innerHTML = "";
		}

		// ===== 事件绑定 =====
		searchToggle.addEventListener("click", toggleSearch);
		searchBtn.addEventListener("click", () => searchCity(searchInput.value));
		searchInput.addEventListener("keydown", (e) => {
			if (e.key === "Enter") {
				e.preventDefault();
				searchCity(searchInput.value);
			}
		});

		locate();
		console.log("🌤️ 天气组件已加载");
	})();
</script>
