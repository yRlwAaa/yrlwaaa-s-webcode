---
// 天气组件 - Open-Meteo API（苹果天气风格）
// IP 定位 → 默认显示用户位置天气；支持搜索城市替换地点；颜色跟随主题色滑块
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";

const weatherI18n = JSON.stringify({
	locating: i18n(I18nKey.weatherLocating),
	fetching: i18n(I18nKey.weatherFetching),
	loadFailed: i18n(I18nKey.weatherLoadFailed),
	searchCity: i18n(I18nKey.weatherSearchCity),
	search: i18n(I18nKey.weatherSearch),
	high: i18n(I18nKey.weatherHigh),
	low: i18n(I18nKey.weatherLow),
	forecast: i18n(I18nKey.weatherForecast),
	today: i18n(I18nKey.weatherToday),
	notFound: i18n(I18nKey.weatherNotFound),
	descMap: {
		0: i18n(I18nKey.weatherSunny), 1: i18n(I18nKey.weatherPartlyCloudy),
		2: i18n(I18nKey.weatherCloudy), 3: i18n(I18nKey.weatherOvercast),
		45: i18n(I18nKey.weatherFog), 48: i18n(I18nKey.weatherFog),
		51: i18n(I18nKey.weatherLightRain), 53: i18n(I18nKey.weatherLightRain), 55: i18n(I18nKey.weatherModerateRain),
		56: i18n(I18nKey.weatherFreezingRain), 57: i18n(I18nKey.weatherFreezingRain),
		61: i18n(I18nKey.weatherModerateRain), 63: i18n(I18nKey.weatherHeavyRain), 65: i18n(I18nKey.weatherHeavyRain),
		66: i18n(I18nKey.weatherFreezingRain), 67: i18n(I18nKey.weatherFreezingRain),
		71: i18n(I18nKey.weatherLightSnow), 73: i18n(I18nKey.weatherModerateSnow),
		75: i18n(I18nKey.weatherHeavySnow), 77: i18n(I18nKey.weatherSnowGrains),
		80: i18n(I18nKey.weatherShowers), 81: i18n(I18nKey.weatherShowers), 82: i18n(I18nKey.weatherHeavyShowers),
		85: i18n(I18nKey.weatherSnowShowers), 86: i18n(I18nKey.weatherHeavySnowShowers),
		95: i18n(I18nKey.weatherThunderstorm), 96: i18n(I18nKey.weatherThunderstorm), 99: i18n(I18nKey.weatherSevereThunderstorm),
	},
	weekDays: [
		i18n(I18nKey.calendarSunday), i18n(I18nKey.calendarMonday),
		i18n(I18nKey.calendarTuesday), i18n(I18nKey.calendarWednesday),
		i18n(I18nKey.calendarThursday), i18n(I18nKey.calendarFriday),
		i18n(I18nKey.calendarSaturday),
	],
});
---

<div id="weather-widget" class="weather-card">
	<!-- 加载态(默认隐藏: 页面先显示天气卡占位, 不会出现"一直转圈") -->
	<div id="weather-loading" class="w-loading" style="display:none;">
		<div class="w-loading-icon">🌤️</div>
		<div class="w-loading-text">{i18n(I18nKey.weatherFetching)}</div>
	</div>

	<!-- 主体(默认可见) -->
	<div id="weather-content" class="w-content" style="display:block;">
		<!-- 头部：城市 + 搜索入口 -->
		<div class="w-header">
			<span id="w-city" class="w-city">--</span>
			<button
				id="w-search-toggle"
				class="w-search-toggle"
				aria-label={i18n(I18nKey.weatherSearchCity)}
				title={i18n(I18nKey.weatherSearchCity)}
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</button>
		</div>

		<!-- 搜索面板 -->
		<div id="w-search-panel" class="w-search-panel">
			<div class="w-search-row">
				<input
					id="w-search"
					type="text"
					placeholder={i18n(I18nKey.weatherSearchCity)}
					autocomplete="off"
					class="w-search-input"
				/>
				<button id="w-search-btn" class="w-search-btn">{i18n(I18nKey.weatherSearch)}</button>
			</div>
			<div id="w-search-results" class="w-search-results"></div>
		</div>

		<!-- 当前天气 -->
		<div class="w-current">
			<div class="w-current-top">
				<span id="w-icon" class="w-icon">🌤️</span>
				<div class="w-current-main">
					<div class="w-temp-line">
						<span id="w-temp" class="w-temp">--°</span>
					</div>
					<div id="w-cond" class="w-cond">--</div>
				</div>
			</div>
			<div class="w-hilo">
				<span class="w-hi">{i18n(I18nKey.weatherHigh)} <b id="w-max">--°</b></span>
				<span class="w-lo">{i18n(I18nKey.weatherLow)} <b id="w-min">--°</b></span>
			</div>
			<div class="w-meta">
				<span class="w-meta-item">
					<svg
						width="13"
						height="13"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M12 2.69 17.66 8a8 8 0 1 1-11.31 0z"></path>
					</svg>
					<span id="w-humidity">--</span>%
				</span>
				<span class="w-meta-item">
					<svg
						width="13"
						height="13"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M9.59 4.59A2 2 0 1 1 11 8H2"></path>
						<path d="M17.73 7.73A2.5 2.5 0 1 1 19.5 12H2"></path>
						<path d="M12.59 19.41A2 2 0 1 0 14 16H2"></path>
					</svg>
					<span id="w-wind">--</span> km/h
				</span>
			</div>
		</div>

		<!-- 一周预报 -->
		<div class="w-forecast">
			<div class="w-forecast-title">{i18n(I18nKey.weatherForecast)}</div>
			<div id="w-forecast" class="w-days"></div>
		</div>
	</div>
</div>

<style is:global>
	.weather-card {
		background: var(--card-bg);
		border-radius: var(--radius-large);
		padding: 14px 16px;
		border: 1px solid var(--line-divider);
		overflow: hidden;
		/* 文字色随明暗主题切换：白天深色、黑夜浅色 */
		--w-text: oklch(0.3 0.02 var(--hue));
		--w-title: oklch(0.45 0.06 var(--hue));
		--w-meta: oklch(0.55 0.02 var(--hue));
	}

	:root.dark .weather-card {
		--w-text: oklch(0.92 0.015 var(--hue));
		--w-title: oklch(0.88 0.04 var(--hue));
		--w-meta: oklch(0.72 0.02 var(--hue));
	}

	/* 加载态 */
	.w-loading {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 24px 0;
		color: var(--w-meta);
	}
	.w-loading-icon {
		font-size: 30px;
		animation: w-pulse 1.6s ease-in-out infinite;
	}
	.w-loading-text {
		font-size: 13px;
	}
	@keyframes w-pulse {
		0%,
		100% {
			opacity: 0.4;
			transform: scale(0.96);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
		}
	}

	/* 头部 */
	.w-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 6px;
	}
	.w-city {
		font-size: 17px;
		font-weight: 700;
		color: var(--w-title);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.w-search-toggle {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: var(--w-meta);
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.w-search-toggle:hover {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
	}
	.w-search-toggle.active {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
	}

	/* 搜索面板 */
	.w-search-panel {
		display: none;
		margin-bottom: 10px;
		animation: w-slide-down 0.2s ease;
	}
	.w-search-panel.open {
		display: block;
	}
	@keyframes w-slide-down {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.w-search-row {
		display: flex;
		gap: 6px;
	}
	.w-search-input {
		flex: 1;
		min-width: 0;
		padding: 7px 10px;
		border: 1px solid var(--line-divider);
		border-radius: 10px;
		font-size: 13px;
		background: var(--btn-regular-bg);
		color: var(--w-text);
		outline: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	.w-search-input::placeholder {
		color: var(--w-meta);
	}
	.w-search-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px
			color-mix(in oklab, var(--primary) 22%, transparent);
	}
	.w-search-btn {
		flex-shrink: 0;
		padding: 7px 14px;
		background: var(--primary);
		color: #fff;
		border: none;
		border-radius: 10px;
		font-size: 13px;
		font-weight: 500;
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.1s ease;
	}
	.w-search-btn:hover {
		opacity: 0.9;
	}
	.w-search-btn:active {
		transform: scale(0.96);
	}
	.w-search-results {
		margin-top: 6px;
		max-height: 180px;
		overflow-y: auto;
		border: 1px solid var(--line-divider);
		border-radius: 10px;
		background: var(--card-bg);
	}
	.w-search-results:empty {
		display: none;
	}
	.w-result {
		width: 100%;
		text-align: left;
		padding: 8px 10px;
		border: none;
		background: transparent;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 1px;
		transition: background 0.15s ease;
	}
	.w-result + .w-result {
		border-top: 1px solid var(--line-divider);
	}
	.w-result:hover {
		background: var(--btn-plain-bg-hover);
	}
	.w-result-name {
		font-size: 13px;
		font-weight: 600;
		color: var(--w-text);
	}
	.w-result-sub {
		font-size: 11px;
		color: var(--w-meta);
	}
	.w-search-empty {
		padding: 12px;
		text-align: center;
		font-size: 12px;
		color: var(--w-meta);
	}

	/* 当前天气 */
	.w-current {
		padding: 10px 0 12px;
		border-bottom: 1px solid var(--line-divider);
	}
	.w-current-top {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.w-icon {
		font-size: 40px;
		line-height: 1;
	}
	.w-current-main {
		display: flex;
		flex-direction: column;
	}
	.w-temp {
		font-size: 40px;
		font-weight: 700;
		line-height: 1;
		color: var(--w-text);
		letter-spacing: -1px;
	}
	.w-cond {
		font-size: 13px;
		color: var(--w-meta);
		margin-top: 4px;
	}
	.w-hilo {
		display: flex;
		gap: 16px;
		margin-top: 10px;
		font-size: 12px;
		color: var(--w-meta);
	}
	.w-hilo b {
		color: var(--w-text);
		font-weight: 600;
	}
	.w-meta {
		display: flex;
		gap: 16px;
		margin-top: 8px;
		font-size: 12px;
		color: var(--w-meta);
	}
	.w-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	/* 一周预报 */
	.w-forecast {
		padding-top: 12px;
	}
	.w-forecast-title {
		font-size: 12px;
		font-weight: 600;
		color: var(--w-meta);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 8px;
	}
	.w-days {
		display: flex;
		flex-direction: column;
	}
	.w-day {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 0;
	}
	.w-day + .w-day {
		border-top: 1px solid
			color-mix(in oklab, var(--line-divider) 60%, transparent);
	}
	.w-day-name {
		width: 34px;
		flex-shrink: 0;
		font-size: 13px;
		font-weight: 500;
		color: var(--w-text);
		white-space: nowrap;
	}
	.w-day-icon {
		width: 22px;
		flex-shrink: 0;
		font-size: 15px;
		text-align: center;
		white-space: nowrap;
	}
	.w-day-low,
	.w-day-high {
		width: 32px;
		flex-shrink: 0;
		font-size: 12px;
		color: var(--w-meta);
		white-space: nowrap;
	}
	.w-day-low {
		text-align: right;
	}
	.w-day-high {
		color: var(--w-text);
		font-weight: 600;
		text-align: left;
	}
	.w-day-track {
		flex: 1;
		min-width: 20px;
		position: relative;
		height: 4px;
		border-radius: 999px;
		background: var(--btn-plain-bg-hover);
		overflow: hidden;
	}
	.w-day-fill {
		position: absolute;
		top: 0;
		bottom: 0;
		border-radius: 999px;
		background: linear-gradient(
			to right,
			color-mix(in oklab, var(--primary) 55%, transparent),
			var(--primary)
		);
	}
</style>

<!-- i18n 通过 JSON 注入(不再用 define:vars, 否则脚本会被强制内联, TS 语法将无法编译而在浏览器报错) -->
<script is:inline id="weather-i18n-data" type="application/json" set:html={weatherI18n}></script>
<script>
	const weatherI18n = JSON.parse(
		(document.getElementById("weather-i18n-data")?.textContent || "{}"),
	);
	// 天气组件会按移动端/平板/桌面渲染多份（id 重复），
	// 必须遍历所有实例分别初始化，否则只有第一份（移动端）生效
	document.querySelectorAll(".weather-card").forEach(function (card) {
		console.log("🌤️ 天气组件启动");

		const loading = card.querySelector("#weather-loading") as HTMLElement;
		const content = card.querySelector("#weather-content") as HTMLElement;
		const wCity = card.querySelector("#w-city") as HTMLElement;
		const wIcon = card.querySelector("#w-icon") as HTMLElement;
		const wTemp = card.querySelector("#w-temp") as HTMLElement;
		const wCond = card.querySelector("#w-cond") as HTMLElement;
		const wMax = card.querySelector("#w-max") as HTMLElement;
		const wMin = card.querySelector("#w-min") as HTMLElement;
		const wHumidity = card.querySelector("#w-humidity") as HTMLElement;
		const wWind = card.querySelector("#w-wind") as HTMLElement;
		const wForecast = card.querySelector("#w-forecast") as HTMLElement;
		const searchToggle = card.querySelector("#w-search-toggle") as HTMLElement;
		const searchPanel = card.querySelector("#w-search-panel") as HTMLElement;
		const searchInput = card.querySelector("#w-search") as HTMLInputElement;
		const searchBtn = card.querySelector("#w-search-btn") as HTMLElement;
		const searchResults = card.querySelector("#w-search-results") as HTMLElement;

		if (
			!loading ||
			!content ||
			!wCity ||
			!wIcon ||
			!wTemp ||
			!wCond ||
			!wMax ||
			!wMin ||
			!wHumidity ||
			!wWind ||
			!wForecast ||
			!searchToggle ||
			!searchPanel ||
			!searchInput ||
			!searchBtn ||
			!searchResults
		) {
			console.error("🌤️ 天气组件：缺少必需 DOM 元素，跳过初始化");
			return;
		}

		// ===== 天气代码映射 =====
		const emojiMap: Record<number, string> = {
			0: "☀️", 1: "⛅", 2: "⛅", 3: "☁️",
			45: "🌫️", 48: "🌫️",
			51: "🌧️", 53: "🌧️", 55: "🌧️",
			56: "🌧️", 57: "🌧️",
			61: "🌧️", 63: "🌧️", 65: "🌧️",
			66: "🌧️", 67: "🌧️",
			71: "🌨️", 73: "🌨️", 75: "❄️", 77: "❄️",
			80: "🌦️", 81: "🌦️", 82: "🌧️",
			85: "🌨️", 86: "🌨️",
			95: "⛈️", 96: "⛈️", 99: "⛈️",
		};
		const descMap: Record<number, string> = weatherI18n.descMap;

		const weekDays = weatherI18n.weekDays;
		const emoji = (code: number) => emojiMap[code] || "🌤️";
		const desc = (code: number) => descMap[code] || "--";

		// ===== 位置持久化 =====
		const STORAGE_KEY = "weather-location";
		function saveLocation(lat: number, lon: number, city: string) {
			try {
				localStorage.setItem(
					STORAGE_KEY,
					JSON.stringify({ lat, lon, city }),
				);
			} catch {
				/* ignore */
			}
		}
		function loadLocation(): { lat: number; lon: number; city: string } | null {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;
				const data = JSON.parse(raw);
				if (
					typeof data.lat === "number" &&
					typeof data.lon === "number" &&
					typeof data.city === "string" &&
					data.city.trim() !== "" &&
					data.city !== "当前位置" &&   // 旧版浏览器定位留下的错误城市, 直接忽略
					Number.isFinite(data.lat) &&
					Number.isFinite(data.lon)
				) {
					return data;
				}
				localStorage.removeItem(STORAGE_KEY);
			} catch {
				/* ignore */
			}
			return null;
		}

		// ===== 渲染 =====
		function setLoading(text: string) {
			loading.style.display = "flex";
			content.style.display = "none";
			const t = loading.querySelector(".w-loading-text");
			if (t) t.textContent = text;
		}

		function renderForecast(daily: any) {
			const days: {
				date: string;
				code: number;
				max: number;
				min: number;
			}[] = [];
			const len = Math.min((daily?.time || []).length, 7);
			for (let i = 0; i < len; i++) {
				days.push({
					date: daily.time[i],
					code: daily.weathercode?.[i] ?? 0,
					max: Math.round(daily.temperature_2m_max?.[i] ?? 0),
					min: Math.round(daily.temperature_2m_min?.[i] ?? 0),
				});
			}
			if (days.length === 0) return;

			const allMax = Math.max(...days.map((d) => d.max));
			const allMin = Math.min(...days.map((d) => d.min));
			const span = allMax - allMin || 1;
			const today = new Date().getDay();

			wForecast.innerHTML = days
				.map((d, i) => {
					const dayName =
						i === 0 ? weatherI18n.today : weekDays[(today + i) % 7];
					const left = ((d.min - allMin) / span) * 100;
					const width = Math.max(
						((d.max - d.min) / span) * 100,
						8,
					);
					return `<div class="w-day">
						<span class="w-day-name">${dayName}</span>
						<span class="w-day-icon">${emoji(d.code)}</span>
						<span class="w-day-low">${d.min}°</span>
						<div class="w-day-track"><div class="w-day-fill" style="left:${left.toFixed(1)}%;width:${width.toFixed(1)}%"></div></div>
						<span class="w-day-high">${d.max}°</span>
					</div>`;
				})
				.join("");
		}

		function displayWeather(data: any, city: string) {
			if (!data || !data.current_weather) {
				console.error("数据异常");
				return false;
			}

			const cur = data.current_weather;
			const code = cur.weathercode || 0;
			const temp = Math.round(cur.temperature);
			const wind = Math.round(cur.windspeed || 0);

			let humidity = "--";
			if (
				data.hourly?.relativehumidity_2m &&
				data.hourly.relativehumidity_2m.length > 0
			) {
				humidity = String(data.hourly.relativehumidity_2m[0] ?? "--");
			}

			const dailyMax = Math.round(
				data.daily?.temperature_2m_max?.[0] ?? temp,
			);
			const dailyMin = Math.round(
				data.daily?.temperature_2m_min?.[0] ?? temp,
			);

			wCity.textContent = city;
			wIcon.textContent = emoji(code);
			wTemp.textContent = `${temp}°`;
			wCond.textContent = desc(code);
			wMax.textContent = `${dailyMax}°`;
			wMin.textContent = `${dailyMin}°`;
			wHumidity.textContent = humidity;
			wWind.textContent = String(wind);

			renderForecast(data.daily);

			loading.style.display = "none";
			content.style.display = "block";
			return true;
		}

		// 带超时的 fetch（用 AbortController，兼容性更好）
		function fetchWithTimeout(
			url: string,
			ms: number,
			options: RequestInit = {},
		): Promise<Response> {
			const controller = new AbortController();
			const timer = setTimeout(() => controller.abort(), ms);
			return fetch(url, { ...options, signal: controller.signal }).finally(
				() => clearTimeout(timer),
			);
		}

		// ===== 获取天气 =====
		async function fetchWeather(lat: number, lon: number, city: string) {
			setLoading(weatherI18n.fetching);
			try {
				const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&daily=weathercode,temperature_2m_max,temperature_2m_min&hourly=relativehumidity_2m&timezone=auto&forecast_days=7`;
				const res = await fetchWithTimeout(url, 8000);
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const data = await res.json();
				const ok = displayWeather(data, city);
				if (ok) {
					saveLocation(lat, lon, city);
					searchInput.value = city;
				} else {
					throw new Error("显示失败");
				}
			} catch (err) {
				console.error("❌ 天气获取失败:", err);
				setLoading(weatherI18n.loadFailed);
				loading.style.cursor = "pointer";
				loading.onclick = function () {
					loading.style.cursor = "";
					fetchWeather(lat, lon, city);
				};
			}
		}

		// ===== 反查城市名（坐标 → 城市，免费无 key） =====
		async function reverseGeocode(
			lat: number,
			lon: number,
		): Promise<string | null> {
			try {
				const res = await fetchWithTimeout(
					`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=zh`,
					5000,
				);
				if (!res.ok) return null;
				const d = await res.json();
				return d.city || d.locality || d.principalSubdivision || null;
			} catch {
				return null;
			}
		}

		// ===== 城市确定(不再依赖浏览器定位: 之前常卡在"定位中"且不准) =====
		// 1) 上次搜索并记住的城市  2) 否则默认城市立即加载, 用户可在右上角搜索改成自己的城市(永久记住)
		const DEFAULT_CITY = { lat: 39.9075, lon: 116.3972, city: "北京" };
		// 离线城市表(搜索不能联网时也能用)
		const LOCAL_CITIES = [
			{ city: "北京", lat: 39.9075, lon: 116.3972 },
			{ city: "上海", lat: 31.2304, lon: 121.4737 },
			{ city: "广州", lat: 23.1291, lon: 113.2644 },
			{ city: "深圳", lat: 22.5431, lon: 114.0579 },
			{ city: "西安", lat: 34.3416, lon: 108.9398 },
			{ city: "成都", lat: 30.5728, lon: 104.0668 },
			{ city: "杭州", lat: 30.2741, lon: 120.1551 },
			{ city: "南京", lat: 32.0603, lon: 118.7969 },
			{ city: "武汉", lat: 30.5928, lon: 114.3055 },
			{ city: "重庆", lat: 29.5630, lon: 106.5516 },
			{ city: "天津", lat: 39.3434, lon: 117.3616 },
			{ city: "郑州", lat: 34.7466, lon: 113.6254 },
			{ city: "长沙", lat: 28.2282, lon: 112.9388 },
			{ city: "青岛", lat: 36.0671, lon: 120.3826 },
			{ city: "沈阳", lat: 41.8057, lon: 123.4315 },
			{ city: "哈尔滨", lat: 45.8038, lon: 126.5340 },
			{ city: "昆明", lat: 24.8801, lon: 102.8329 },
			{ city: "厦门", lat: 24.4798, lon: 118.0894 },
			{ city: "苏州", lat: 31.2989, lon: 120.5853 },
			{ city: "合肥", lat: 31.8206, lon: 117.2272 },
			{ city: "济南", lat: 36.6512, lon: 117.1201 },
			{ city: "福州", lat: 26.0745, lon: 119.2965 },
		];
		// 构建期生成的同源静态天气(不依赖访客网络, 秒出)
		let staticWeather: any = null;
		async function loadStaticWeather() {
			if (staticWeather) return staticWeather;
			try {
				const res = await fetchWithTimeout(`/weather-data.json?t=${Date.now()}`, 8000);
				if (!res.ok) return null;
				staticWeather = await res.json();
				return staticWeather;
			} catch {
				return null;
			}
		}
		async function showCity(city: string, lat?: number, lon?: number) {
			setLoading(weatherI18n.fetching);
			// 1) 静态数据里有的城市 → 直接用(最快最稳)
			const st = await loadStaticWeather();
			const entry = st && st.cities ? st.cities[city] : null;
			if (entry && entry.data) {
				if (displayWeather(entry.data, city)) {
					saveLocation(entry.lat, entry.lon, city);
					searchInput.value = city;
					return;
				}
			}
			// 2) 静态里没有 → 走实时接口(带超时, 失败会给出明确提示)
			const c = lat != null && lon != null ? { lat, lon } : (LOCAL_CITIES.find((x) => x.city === city) || DEFAULT_CITY);
			await fetchWeather(c.lat, c.lon, city);
		}
		async function locate() {
			const saved = loadLocation();
			if (saved && saved.lat && saved.lon && saved.city) {
				await showCity(saved.city, saved.lat, saved.lon);
				return;
			}
			// 首次访问: 用构建期静态数据里的默认城市, 立即出结果
			await showCity(DEFAULT_CITY.city, DEFAULT_CITY.lat, DEFAULT_CITY.lon);
		}

		// ===== 搜索 =====
		function escapeHtml(s: string): string {
			return s
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;");
		}

		async function searchCity(query: string) {
			const q = query.trim();
			if (!q) return;
			searchResults.innerHTML =
				'<div class="w-search-empty">' + weatherI18n.fetching + '</div>';

			type Result = { lat: number; lon: number; name: string; admin: string };
			let results: Result[] = [];

			// 1. Open-Meteo geocoding（快，但中文城市名覆盖不全）
			try {
				const res = await fetchWithTimeout(
					`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(q)}&count=5&language=zh&format=json`,
					5000,
				);
				if (res.ok) {
					const data = await res.json();
					results = (data.results || []).map((r: any) => ({
						lat: r.latitude,
						lon: r.longitude,
						name: r.name,
						admin: [r.admin1, r.country].filter(Boolean).join(" · "),
					}));
				}
			} catch {
				/* fallthrough to Nominatim */
			}

			// 2. Nominatim 兜底（OpenStreetMap，中文地名更全，如“温州”）
			if (results.length === 0) {
				try {
					const res = await fetchWithTimeout(
						`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=5&accept-language=zh`,
						6000,
						{ headers: { "User-Agent": "Mizuki-Blog/1.0" } },
					);
					if (res.ok) {
						const data = await res.json();
						results = (data || []).map((r: any) => {
							const parts = (r.display_name || "")
								.split(",")
								.map((s: string) => s.trim());
							return {
								lat: parseFloat(r.lat),
								lon: parseFloat(r.lon),
								name: r.name || parts[0] || "",
								admin: parts.slice(1, 3).join(" · "),
							};
						}).filter((r: Result) => r.name && !isNaN(r.lat) && !isNaN(r.lon));
					}
				} catch {
					/* ignore */
				}
			}

			// 3. 离线城市表兜底(联网搜索全部失败时仍可换城市)
			if (results.length === 0) {
				results = LOCAL_CITIES.filter((c) => c.city.includes(q)).map((c) => ({
					lat: c.lat,
					lon: c.lon,
					name: c.city,
					admin: "内置城市表",
				}));
			}

			if (results.length === 0) {
				searchResults.innerHTML =
					'<div class="w-search-empty">' + weatherI18n.notFound + '</div>';
				return;
			}

			searchResults.innerHTML = results
				.map(
					(r) => `
					<button class="w-result" data-lat="${r.lat}" data-lon="${r.lon}" data-name="${escapeHtml(r.name)}" data-admin="${escapeHtml(r.admin)}">
						<span class="w-result-name">${escapeHtml(r.name)}</span>
						<span class="w-result-sub">${escapeHtml(r.admin)}</span>
					</button>`,
				)
				.join("");
			// 绑定结果点击
			searchResults
				.querySelectorAll<HTMLElement>(".w-result")
				.forEach((btn) => {
					btn.addEventListener("click", () => {
						const lat = parseFloat(btn.dataset.lat!);
						const lon = parseFloat(btn.dataset.lon!);
						const name = btn.dataset.name!;
						const admin = btn.dataset.admin;
						const city = admin ? `${name}, ${admin}` : name;
						closeSearch();
						showCity(city, lat, lon);
					});
				});
		}

		function toggleSearch() {
			const isOpen = searchPanel.classList.toggle("open");
			searchToggle.classList.toggle("active", isOpen);
			if (isOpen) {
				setTimeout(() => searchInput.focus(), 50);
			} else {
				searchResults.innerHTML = "";
			}
		}
		function closeSearch() {
			searchPanel.classList.remove("open");
			searchToggle.classList.remove("active");
			searchResults.innerHTML = "";
		}

		// ===== 事件绑定 =====
		searchToggle.addEventListener("click", toggleSearch);
		searchBtn.addEventListener("click", () => searchCity(searchInput.value));
		searchInput.addEventListener("keydown", (e) => {
			if (e.key === "Enter") {
				e.preventDefault();
				searchCity(searchInput.value);
			}
		});

		locate();
		// 兜底防卡: 9 秒后若仍停留在加载态, 显示可点击重试(绝不无限转圈)
		setTimeout(() => {
			try {
				if (loading && loading.style.display !== "none") {
					setLoading(weatherI18n.loadFailed);
					loading.style.cursor = "pointer";
					loading.onclick = () => {
						loading.style.cursor = "";
						locate();
					};
				}
			} catch (e) {}
		}, 9000);
		console.log("🌤️ 天气组件已加载");
	});
</script>
