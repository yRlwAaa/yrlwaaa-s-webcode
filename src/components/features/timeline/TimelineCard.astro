---
import { Icon } from "astro-icon/components";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import { getProjectCategory } from "./project-categories";
import type { TimelineCardProps } from "./types";

const { item } = Astro.props as TimelineCardProps;

const isCurrent = !item.endDate;
const buildLog = item.buildLog ?? [];
const latestBuildDate = buildLog.reduce(
	(acc, step) => (step.date > acc ? step.date : acc),
	"",
);

const getTypeIcon = (type: string) => {
	switch (type) {
		case "education":
			return "material-symbols:school";
		case "work":
			return "material-symbols:work";
		case "project":
			return "material-symbols:code";
		case "achievement":
			return "material-symbols:emoji-events";
		default:
			return "material-symbols:event";
	}
};

const getTypeText = (type: string) => {
	switch (type) {
		case "education":
			return i18n(I18nKey.timelineEducation);
		case "work":
			return i18n(I18nKey.timelineWork);
		case "project":
			return i18n(I18nKey.timelineProject);
		case "achievement":
			return i18n(I18nKey.timelineAchievement);
		default:
			return type;
	}
};

const getLinkIcon = (type: string) => {
	switch (type) {
		case "certificate":
			return "material-symbols:verified";
		case "project":
			return "material-symbols:open-in-new";
		case "website":
			return "material-symbols:language";
		default:
			return "material-symbols:description";
	}
};

const formatDate = (dateString: string) => {
	const date = new Date(dateString);
	return date.toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "short",
	});
};

const getDuration = (startDate: string, endDate?: string) => {
	const start = new Date(startDate);
	const end = endDate ? new Date(endDate) : new Date();
	const diffTime = Math.abs(end.getTime() - start.getTime());
	const diffMonths = Math.ceil(diffTime / (1000 * 60 * 60 * 24 * 30));

	if (diffMonths < 12) {
		return `${diffMonths} ${i18n(I18nKey.timelineMonths)}`;
	}
	const years = Math.floor(diffMonths / 12);
	const months = diffMonths % 12;
	if (months === 0) {
		return `${years} ${i18n(I18nKey.timelineYears)}`;
	}
	return `${years} ${i18n(I18nKey.timelineYears)} ${months} ${i18n(I18nKey.timelineMonths)}`;
};

const icon = item.icon || getTypeIcon(item.type);
const typeText = getTypeText(item.type);
const dateRange = `${formatDate(item.startDate)} - ${item.endDate ? formatDate(item.endDate) : i18n(I18nKey.timelinePresent)}`;
const duration = getDuration(item.startDate, item.endDate);
const nodeColor = isCurrent ? "#22c55e" : item.color || "var(--primary)";
const hasLinks = item.links && item.links.length > 0;
---

<div
	class:list={["timeline-entry", { "is-current": isCurrent }]}
	data-type={item.type}
>
	<div class="timeline-node" style={`background-color: ${nodeColor};`}>
		<Icon name={icon} class="w-2.5 h-2.5" style="color: white;" />
	</div>

	<div
		class="timeline-card group relative rounded-xl border border-black/10 dark:border-white/10 overflow-hidden transition-all duration-300 hover:shadow-lg"
	>
		<div class="p-5 sm:p-6">
			<div class="flex items-start gap-3 mb-3">
				<div
					class="w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center bg-[var(--btn-regular-bg)]"
				>
					<Icon
						name={icon}
						class="text-lg"
						style={`color: ${item.color || "var(--primary)"};`}
					/>
				</div>

				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 mb-0.5">
						<h3
							class="text-lg font-bold text-black/90 dark:text-white/90 group-hover:text-[var(--primary)] transition-colors duration-200"
						>
							{item.title}
						</h3>
						{
							item.featured && (
								<Icon
									name="material-symbols:star-rounded"
									class="text-base w-4 h-4 text-[var(--primary)] flex-shrink-0"
								/>
							)
						}
					</div>
					{
						item.organization && (
							<p class="text-sm text-black/60 dark:text-white/60">
								{item.organization}
								{item.position ? ` · ${item.position}` : ""}
							</p>
						)
					}
				</div>

				<div class="flex items-center gap-1.5 flex-shrink-0 ml-2">
					{
						isCurrent && (
							<span class="px-2 py-0.5 text-xs rounded-md bg-green-500/10 text-green-600 dark:text-green-400 font-medium">
								{i18n(I18nKey.timelineCurrent)}
							</span>
						)
					}
					<span
						class="px-2 py-0.5 text-xs rounded-md bg-[var(--primary)]/10 text-[var(--primary)] font-medium"
					>
						{typeText}
					</span>
				</div>
			</div>

			<p
				class="text-sm text-black/70 dark:text-white/70 mb-4 leading-relaxed"
			>
				{item.description}
			</p>

			{
				buildLog.length > 0 && (
					<div class="build-log mb-4">
						<div class="build-log-head">
							<h4 class="text-xs font-semibold text-black/50 dark:text-white/50 uppercase tracking-wider">
								{i18n(I18nKey.timelineBuildSteps)}
							</h4>
							<span class="build-log-count">
								{buildLog.length} · {i18n(I18nKey.timelineProjectsLast)}{" "}
								{latestBuildDate}
							</span>
						</div>

						<ol class="build-log-list">
							{buildLog.map((step) => {
								const stepCategory = getProjectCategory(step.category);
								return (
									<li class:list={["build-log-item", { "is-key": step.highlight }]}>
										<span class="build-log-date">{step.date}</span>
										<span class="build-log-axis">
											<span
												class="build-log-dot"
												style={`background-color: ${step.color || stepCategory.color};`}
											/>
										</span>
										<span class="build-log-body">
											<span class="build-log-name">
												{step.title}
												{step.highlight && (
													<Icon
														name="material-symbols:star-rounded"
														class="build-log-star"
													/>
												)}
											</span>
											<span class="build-log-note">{step.summary}</span>
										</span>
										<span
											class="build-log-tag"
											style={`color: ${stepCategory.color}; background-color: ${stepCategory.color}1a;`}
										>
											{i18n(stepCategory.labelKey)}
										</span>
									</li>
								);
							})}
						</ol>
					</div>
				)
			}

			{
				item.skills && item.skills.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-4">
						{item.skills.map((skill) => (
							<span class="px-2 py-1 text-xs rounded-md bg-[var(--primary)]/10 text-[var(--primary)] font-medium">
								{skill}
							</span>
						))}
					</div>
				)
			}

			{
				item.achievements && item.achievements.length > 0 && (
					<div class="mb-4">
						<h4 class="text-xs font-semibold text-black/50 dark:text-white/50 uppercase tracking-wider mb-2">
							{i18n(I18nKey.timelineAchievements)}
						</h4>
						<ul class="space-y-1.5">
							{item.achievements.map((achievement) => (
								<li class="text-sm text-black/70 dark:text-white/70 flex items-start gap-2">
									<Icon
										name="material-symbols:check-circle"
										class="text-base w-4 h-4 text-green-500 flex-shrink-0 mt-0.5"
									/>
									<span>{achievement}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<div
				class="flex items-center gap-4 text-xs text-black/50 dark:text-white/50 mb-1 pt-3 border-t border-black/5 dark:border-white/5"
			>
				<span class="flex items-center gap-1">
					<Icon
						name="material-symbols:calendar-month-outline"
						class="text-xs w-3.5 h-3.5"
					/>
					{dateRange}
				</span>
				<span class="flex items-center gap-1">
					<Icon
						name="material-symbols:schedule-outline"
						class="text-xs w-3.5 h-3.5"
					/>
					{duration}
				</span>
				{
					item.location && (
						<span class="flex items-center gap-1">
							<Icon
								name="material-symbols:location-on-outline"
								class="text-xs w-3.5 h-3.5"
							/>
							{item.location}
						</span>
					)
				}
			</div>

			{
				hasLinks && (
					<div class="flex flex-wrap gap-2 mt-3">
						{item.links!.map((link) => (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="btn-regular flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium"
							>
								<Icon
									name={getLinkIcon(link.type)}
									class="text-xs w-3.5 h-3.5"
								/>
								{link.name}
							</a>
						))}
					</div>
				)
			}
		</div>

		<div
			class="absolute inset-0 bg-gradient-to-br from-[var(--primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-xl"
		>
		</div>
	</div>
</div>

<style>
	.timeline-entry {
		position: relative;
		padding-left: 2.5rem;
		padding-bottom: 2rem;
		animation: fadeInUp 0.5s ease-out forwards;
		opacity: 0;
	}

	.timeline-entry:last-child {
		padding-bottom: 0;
	}

	.timeline-entry.filtered-out {
		display: none;
	}

	/* 「网页构建」内页：功能 / 插件添加历程 */
	.build-log {
		padding: 0.9rem 1rem 0.4rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
	}

	.build-log-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		margin-bottom: 0.5rem;
	}

	.build-log-count {
		font-size: 0.7rem;
		opacity: 0.62;
		font-variant-numeric: tabular-nums;
	}

	.build-log-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.build-log-item {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 0.45rem 0;
	}

	.build-log-date {
		flex: 0 0 3.8rem;
		font-size: 0.72rem;
		line-height: 1.5;
		opacity: 0.62;
		font-variant-numeric: tabular-nums;
		padding-top: 0.05rem;
	}

	.build-log-axis {
		position: relative;
		flex: 0 0 1.1rem;
		align-self: stretch;
		display: flex;
		justify-content: center;
	}

	.build-log-axis::before {
		content: "";
		position: absolute;
		top: -0.45rem;
		bottom: -0.45rem;
		width: 1px;
		background: var(--line-divider);
	}

	.build-log-item:first-child .build-log-axis::before {
		top: 0.4rem;
	}

	.build-log-item:last-child .build-log-axis::before {
		bottom: 0.4rem;
	}

	.build-log-dot {
		position: relative;
		z-index: 1;
		width: 0.55rem;
		height: 0.55rem;
		margin-top: 0.35rem;
		border-radius: 50%;
		box-shadow: 0 0 0 2px var(--card-bg);
	}

	.build-log-body {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.build-log-name {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--btn-content);
		line-height: 1.4;
	}

	.build-log-item.is-key .build-log-name {
		color: var(--primary);
	}

	.build-log-star {
		width: 0.85rem;
		height: 0.85rem;
		flex-shrink: 0;
		color: var(--primary);
	}

	.build-log-note {
		font-size: 0.78rem;
		line-height: 1.5;
		opacity: 0.62;
	}

	.build-log-tag {
		flex: 0 0 auto;
		align-self: center;
		font-size: 0.68rem;
		padding: 0.1rem 0.4rem;
		border-radius: 0.375rem;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.build-log {
			padding: 0.8rem 0.7rem 0.3rem;
		}

		.build-log-date {
			flex: 0 0 2.7rem;
			font-size: 0.68rem;
		}

		.build-log-tag {
			display: none;
		}
	}

	.timeline-node {
		position: absolute;
		left: 0;
		top: 1.5rem;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		border: 2.5px solid white;
		box-shadow: 0 0 0 2px var(--line-divider);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 2;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.timeline-entry:hover .timeline-node {
		transform: scale(1.15);
		box-shadow:
			0 0 0 2px var(--primary),
			0 0 12px rgba(0, 0, 0, 0.1);
	}

	.timeline-entry.is-current .timeline-node {
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 2px var(--line-divider);
		}
		50% {
			box-shadow:
				0 0 0 2px #22c55e,
				0 0 8px rgba(34, 197, 94, 0.3);
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.timeline-entry:nth-child(1) {
		animation-delay: 0.05s;
	}
	.timeline-entry:nth-child(2) {
		animation-delay: 0.1s;
	}
	.timeline-entry:nth-child(3) {
		animation-delay: 0.15s;
	}
	.timeline-entry:nth-child(4) {
		animation-delay: 0.2s;
	}
	.timeline-entry:nth-child(5) {
		animation-delay: 0.25s;
	}
	.timeline-entry:nth-child(6) {
		animation-delay: 0.3s;
	}
	.timeline-entry:nth-child(7) {
		animation-delay: 0.35s;
	}
	.timeline-entry:nth-child(8) {
		animation-delay: 0.4s;
	}
	.timeline-entry:nth-child(9) {
		animation-delay: 0.45s;
	}
</style>
