---
import FloatingButton from "@components/common/FloatingButton.astro";
---

<FloatingButton
	id="back-to-top-btn"
	icon="material-symbols:keyboard-arrow-up-rounded"
	ariaLabel="Back to Top"
	onclick="backToTop()"
	class="hide"
/>

<script is:raw is:inline>
	function backToTop() {
		window.scroll({ top: 0, behavior: "smooth" });
	}

	if (typeof window.BackToTopManager === "undefined") {
		window.BackToTopManager = class BackToTopManager {
			constructor() {
				this.button = document.getElementById("back-to-top-btn");
				this.rafPending = false;
				this.init();
			}

			init() {
				if (!this.button) {
					return;
				}
				this.setupScrollListener();
			}

			setupScrollListener() {
				const updateVisibility = () => {
					const scrollTop =
						window.pageYOffset ||
						document.documentElement.scrollTop;

					if (scrollTop > 200) {
						this.button.classList.remove("hide");
					} else {
						this.button.classList.add("hide");
					}
				};

				// rAF 节流：同一帧内多次滚动只执行一次可见性判断
				const onScroll = () => {
					if (this.rafPending) {
						return;
					}
					this.rafPending = true;
					requestAnimationFrame(() => {
						this.rafPending = false;
						updateVisibility();
					});
				};

				window.addEventListener("scroll", onScroll, {
					passive: true,
				});
			}
		};
	}

	// 只创建一个管理器实例，避免重复绑定滚动监听
	const initManager = () => {
		if (!window.backToTopManager) {
			window.backToTopManager = new window.BackToTopManager();
		}
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initManager);
	} else {
		initManager();
	}
</script>
